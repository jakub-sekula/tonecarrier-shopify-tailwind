          "type": "heading",
          "settings": {
            "heading": "Dual roller drive",
            "heading_size": "h1"
          }
        },
        "text_MywpNU": {
          "type": "text",
          "settings": {
            "text": "<p>There are two sets of soft rubber rollers on both sides of each carrier. They grab the film gently, but securely on both sides in a push-pull configuration allowing you to scan any length of film - from full, uncut rolls, to short strips of 4 or more frames.</p><p>Your images always stay safe, because the soft rubber rollers only ever contact the edges of the film.</p>",
            "text_style": "body"
          }
        }
      },
      "block_order": [
