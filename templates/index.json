        "text_LN8tDm": {
          "type": "text",
          "settings": {
            "text": "<p>Both sets of rollers are synchronized using a precision pulley and timing belt system. Your film will never get stuck in the carrier and you can easily adjust its position with extreme precision to get a perfect result scan after scan.</p>",
            "text_style": "body"
          }
        }
