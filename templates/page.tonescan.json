    "workflow": {
      "type": "tonescan-workflow",
      "blocks": {
        "step1": {
          "type": "step",
          "settings": {
            "title": "A roll in minutes",
            "body": "<p>Point toneScan Studio at your capture folder and the whole roll appears, triplets already merged and frames already inverted.</p><p>You're looking at finished pictures before you've touched a single slider.</p>",
            "image_url": "https://cdn.shopify.com/s/files/1/0634/3199/9736/files/organise.png",
            "video_url": ""
          }
        },
        "step2": {
          "type": "step",
          "settings": {
            "title": "Right colour, first try",
            "body": "<p>The inversion is built on how film and paper actually behave, so the first thing you see is already close.</p><p>No profile hunting, no per-frame guesswork, and no fighting an orange cast for twenty minutes.</p>",
            "image_url": "https://cdn.shopify.com/s/files/1/0634/3199/9736/files/develop.png",
            "video_url": ""
          }
        },
        "step3": {
          "type": "step",
          "settings": {
            "title": "Instant feedback",
            "body": "<p>Move a slider and the frame moves with it. No lag, no stand-in preview, no waiting to find out what an adjustment really did.</p><p>And what you settle on is what you get: the exported file matches the one you approved on screen.</p>",
            "image_url": "https://cdn.shopify.com/s/files/1/0634/3199/9736/files/pixel-preview.png",
            "video_url": ""
          }
        },
        "step4": {
          "type": "step",
          "settings": {
            "title": "One frame, whole roll",
            "body": "<p>Push your settings across every frame, then send the lot out in one go.</p><p>TIFF or JPG, your sizing, your filenames, with film stock and camera details already attached.</p>",
            "image_url": "https://cdn.shopify.com/s/files/1/0634/3199/9736/files/batch-export.png",
            "video_url": ""
          }
        }
      },
      "block_order": [
