    "feature-list": {
      "type": "tonescan-feature-list",
      "blocks": {
        "group_1": {
          "type": "group",
          "settings": {
            "title": "Capture & calibration",
            "icon": "icon0",
            "items": "<b>Hardware control</b>: Controls your light source and motorised film carrier for automatic scanning.\n<b>Trichromatic scanning</b>: Photograph each frame under red, green and blue light, the way lab scanners read colour. toneScan Studio finds the three and merges them.\n<b>White-light scanning</b>: One shot per frame works too, with any ordinary light source.\n<b>Works with your existing camera scanning rig</b>\n<b>Automatic exposure tuning</b>: Tunes your light settings to use the full range of your sensor.\n<b>Flat-field correction</b>: Automatically corrects unevenness in your light source.\n<b>Crosstalk correction</b>",
            "image_url": "https://cdn.shopify.com/s/files/1/0634/3199/9736/files/calibration-crosstalk.png"
          }
        },
        "group_5b": {
          "type": "group",
          "settings": {
            "title": "Colour and processing",
            "icon": "icon5",
            "items": "<b>Simulated paper response</b>: The rendering engine models how photographic paper responds to light.\n<b>Three process modes</b>: Colour negative, B&W negative and slide.\n<b>White balance</b>: Automatic, or pick your own neutral.\n<b>Automatic brightness and contrast</b>\n<b>Intuitive exposure and tone controls</b>: Contrast, density, highlight rolloff and shadow lift.\n<b>Sharpening and noise reduction</b>\n<b>Per-channel inspection</b>: View R, G or B on its own.",
            "image_url": "https://cdn.shopify.com/s/files/1/0634/3199/9736/files/rgb-merge.png"
          }
        },
        "group_3": {
          "type": "group",
          "settings": {
            "title": "Editing and interface",
            "icon": "icon2",
            "items": "<b>Instant previews</b>: See your edits straight away, at full resolution.\n<b>Keyboard shortcuts</b>: Work through a roll without reaching for the mouse.\n<b>Background processing</b>: Whole rolls convert and export while you carry on working.\n<b>Live RGB histogram</b>\n<b>Pixel loupe</b>\n<b>Smart auto-crop</b>: Never crop out the film border by hand again.\n<b>Crop, rotate and flip</b>\n<b>Batch editing</b>: Copy and paste edits across as many frames as you like.\n<b>Undo, redo and edit history</b>",
            "image_url": "https://cdn.shopify.com/s/files/1/0634/3199/9736/files/develop.png"
          }
        },
        "group_2": {
          "type": "group",
          "settings": {
            "title": "Project management",
            "icon": "icon1",
            "items": "<b>Roll-based library</b>: Organised by roll, the way you shoot.\n<b>Hot folder support</b>: Point it at a folder and new scans are picked up as they land.\n<b>Rich metadata</b>: Record the camera, lens and film stock against a roll, and find them again by any of it.",
            "image_url": "https://cdn.shopify.com/s/files/1/0634/3199/9736/files/organise.png"
          }
        },
        "group_4": {
          "type": "group",
          "settings": {
            "title": "Professional exports",
            "icon": "icon3",
            "items": "<b>Colour-managed viewport and export</b>: sRGB, Adobe RGB or Display-P3, with the matching ICC profile embedded.\n<b>TIFF, JPG or DNG</b>: Set the quality and the long edge.\n<b>Linear raw export</b>: Unrendered scans in DNG or TIFF, to archive or take elsewhere.\n<b>EXIF written on the way out</b>: Exports carry the film camera, lens and stock you shot on.\n<b>Filename patterns</b>: Built from name, date, project or sequence.\n<b>Batch export</b>: Export a selection or the whole roll.",
            "image_url": "https://cdn.shopify.com/s/files/1/0634/3199/9736/files/batch-export.png"
          }
        },
        "group_5": {
          "type": "group",
          "settings": {
            "title": "Platform",
            "icon": "icon4",
            "items": "<b>macOS and Windows</b>: Native builds for both.\n<b>Fully standalone</b>: No host app and no plugin bridge.\n<b>Flexible licensing</b>: Own it outright, or subscribe.",
            "image_url": "https://cdn.shopify.com/s/files/1/0634/3199/9736/files/pixel-preview.png"
          }
        }
      },
      "block_order": [
        "group_1",
        "group_5b",
        "group_3",
        "group_2",
        "group_4",
        "group_5"
      ],
