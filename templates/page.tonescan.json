    "faq": {
      "type": "tonescan-faq",
      "blocks": {
        "q1": {
          "type": "qa",
          "settings": {
            "q": "Is it free right now?",
            "a": "Yes. toneScan Studio is in open beta, and every feature is unlocked while it lasts. Licences go on sale at launch."
          }
        },
        "q2": {
          "type": "qa",
          "settings": {
            "q": "What happens to my beta licence when you launch?",
            "a": "It carries on. Buying converts the licence you already have rather than issuing a new one, so the key on your machine keeps working and there is nothing to paste in. Testers also get a discount on whichever licence they pick."
          }
        },
        "q3": {
          "type": "qa",
          "settings": {
            "q": "How do I join the beta?",
            "a": "Sign up further down this page and we will send you a key."
          }
        },
        "q4": {
          "type": "qa",
          "settings": {
            "q": "Is there a free trial?",
            "a": "There will be at launch: fourteen days with every feature unlocked, no account and no card, started from inside the app. During the beta you do not need it, since the beta itself is free."
          }
        },
        "q5": {
          "type": "qa",
          "settings": {
            "q": "What happens when the trial runs out?",
            "a": "The app keeps working in demo mode, which is free forever. Exports are watermarked and capped in size, and any library you built stays open and readable."
          }
        },
        "q6": {
          "type": "qa",
          "settings": {
            "q": "Do I need special hardware?",
            "a": "No. toneScan Studio works with raw scans from any digital camera and whatever light you already have. It can also drive our own toneLight and toneCarrier, and selected third-party lights, directly from the app, but nothing depends on that."
          }
        },
        "q7": {
          "type": "qa",
          "settings": {
            "q": "Do I have to shoot RGB?",
            "a": "No. Single-shot scanning under white light works the whole way through the app. Trichromatic scanning is there when you want the cleanest colour separation, and it is a choice rather than a requirement."
          }
        },
        "q8": {
          "type": "qa",
          "settings": {
            "q": "Can I use it on scans I have already shot?",
            "a": "Yes. Point it at a folder of raw captures and it brings them in, groups them into rolls, and combines the red, green and blue frames if you shot that way. Nothing needs re-scanning."
          }
        },
        "q9": {
          "type": "qa",
          "settings": {
            "q": "What film can I convert?",
            "a": "Colour negative, black and white negative, and slide film, across the common formats."
          }
        },
        "q10": {
          "type": "qa",
          "settings": {
            "q": "What do I get at the end?",
            "a": "TIFF, JPG or DNG at the size and quality you choose, named with a pattern you control. Exports carry the film camera, lens and stock you shot on. You can also write unrendered linear raw files to archive or take elsewhere."
          }
        },
        "q11": {
          "type": "qa",
          "settings": {
            "q": "Which computers does it run on?",
            "a": "Native builds for macOS and Windows. One licence covers two machines."
          }
        },
        "q12": {
          "type": "qa",
          "settings": {
            "q": "How will it be licensed?",
            "a": "Buy it once or subscribe. Buying outright is yours to keep, with free updates within a major version. A subscription suits a single project or a longer look than the trial gives, and you can cancel whenever you like. Either way one licence covers two machines."
          }
        },
        "q13": {
          "type": "qa",
          "settings": {
            "q": "Is this a Lightroom plugin?",
            "a": "No, it is a complete application. Cataloguing, conversion, colour, calibration and export all happen in one place, so there is no host application to keep a licence for and no round trip between programs to finish a roll."
          }
        }
      },
