    "feature-list": {
      "type": "tonescan-feature-list",
      "blocks": {
        "group_1": {
          "type": "group",
          "settings": {
            "title": "Capture & calibration",
            "icon": "icon0",
            "items": "<b>Hardware control</b>: drives your light source and advances the film carrier\nTrichromatic capture from any camera, mono sensors included\n<b>Tethered capture</b> straight into the current roll\n<b>Light presets</b> read from a connected light\n<b>Scan profiles</b>: calibrate once, reuse on every roll\n<b>Per-channel exposure targets</b> with an EV meter\n<b>Crosstalk correction</b> measured from your own setup\nFlat-field correction: cancels uneven light and lens falloff, so corners match the centre\n<b>Linearity calibration</b>\n<b>White-light scanning</b>: single-shot works too",
            "image_url": "https://cdn.shopify.com/s/files/1/0634/3199/9736/files/calibration-crosstalk.png"
          }
        },
        "group_2": {
          "type": "group",
          "settings": {
            "title": "Project management",
            "icon": "icon1",
            "items": "<b>Roll-based library</b> with live frame counts\n<b>Watch folders</b> that ingest new scans as they land\n<b>Automatic triplet detection</b> and merge\nBatch editing: get one frame right and the whole roll follows\n<b>Markers and colour labels</b> for fast culling\n<b>Per-channel inspection</b>: view R, G or B alone\n<b>Undo and redo</b> throughout\nBackground processing: whole rolls convert and export while you carry on working",
            "image_url": "https://cdn.shopify.com/s/files/1/0634/3199/9736/files/organise.png"
          }
        },
        "group_3": {
          "type": "group",
          "settings": {
            "title": "Rich editing experience",
            "icon": "icon2",
            "items": "Inversion modelled on film physics and the way darkroom paper responds to light\n<b>Three process modes</b>: colour negative, B&amp;W negative, slide\n<b>Live RGB histogram</b>\nGPU viewport: every slider lands on a full-resolution preview instantly, with no proxy image\n<b>Exposure, contrast, density,</b> highlight rolloff and shadow lift\n<b>Auto density</b>\n<b>Smart auto white balance</b>, or pick your own neutral\n<b>Levels, tone trims and sharpening</b>\n<b>Crop, rotate and flip</b>\nSmart auto-crop: frame edges found and squared up for you\n<b>Pixel loupe</b> with a live density readout\n<b>True exposure from raw</b>: read from signal, not the histogram",
            "image_url": "https://cdn.shopify.com/s/files/1/0634/3199/9736/files/develop.png"
          }
        },
        "group_4": {
          "type": "group",
          "settings": {
            "title": "Professional exports",
            "icon": "icon3",
            "items": "<b>Colour-managed viewport and export</b>: sRGB, Adobe RGB, Display-P3 or Rec.2020, with the matching ICC profile embedded on the way out\n<b>TIFF or JPG</b>, your quality and long edge\n<b>Cineon log export</b> for grading downstream\n<b>Filename patterns</b> from name, date, project or sequence\n<b>Batch export</b> a selection or a whole roll\n<b>Rich metadata</b>: film stock, camera and dev info on every file",
            "image_url": "https://cdn.shopify.com/s/files/1/0634/3199/9736/files/batch-export.png"
          }
        },
        "group_5": {
          "type": "group",
          "settings": {
            "title": "Platform",
            "icon": "icon4",
            "items": "<b>macOS and Windows</b>: native builds for both\n<b>Keyboard-driven</b>: shortcuts for everything\n<b>Fully standalone</b>: no host app, no plugin bridge\n<b>Flexible licensing</b>: own it outright or subscribe",
            "image_url": "https://cdn.shopify.com/s/files/1/0634/3199/9736/files/pixel-preview.png"
