    "faq": {
      "type": "tonescan-faq",
      "blocks": {
        "qa_1": {
          "type": "qa",
          "settings": {
            "q": "Which cameras are supported?",
            "a": "Any camera with a standard remote shutter input. toneLight triggers the shutter directly and never touches your exposure settings, so metering stays in your hands. All major brands."
          }
        },
        "qa_2": {
          "type": "qa",
          "settings": {
            "q": "Which film formats does it support?",
            "a": "35 mm and 120, and motorised upgrades are available for both. Frame spacing can be set to any standard frame size or a custom one, and half-frame masks are available. The motor drive also makes automatic 6x17 capture possible: it takes two shots of each frame, which are then stitched together. 16 mm, 4x5 and 8x10 are not supported."
          }
        },
        "qa_3": {
          "type": "qa",
          "settings": {
            "q": "How does it compare to a lab scanner?",
            "a": "For most negatives, comparable, and better in resolution and flexibility. Two honest caveats: transport is currently open-loop (a small jog every few frames), and a Bayer sensor is softer at deep red and blue than a mono camera. Both are in active development."
          }
        },
        "qa_4": {
          "type": "qa",
          "settings": {
            "q": "What about slide film / E-6?",
            "a": "toneLight has a high-CRI white mode for slides. Slides are positive, so they work like normal photos in any editor, so toneScan Studio isn't required."
          }
        },
        "qa_5": {
          "type": "qa",
          "settings": {
            "q": "Do I need toneScan Studio, or can I use other software?",
            "a": "toneScan Studio is the intended workflow and what the system is built around. The three captures are standard RAW, so anyone comfortable with manual channel work can experiment elsewhere. For slides, any editor works with no extra steps."
          }
        },
        "qa_6": {
          "type": "qa",
          "settings": {
            "q": "How long does a roll take?",
            "a": "About two minutes to capture in semi-auto. In hot-folder mode, toneScan Studio merges scans as they arrive, so by the time you step away from the rig the files are ready to preview."
          }
        },
        "qa_shutter": {
          "type": "qa",
          "settings": {
            "q": "How does it trigger the shutter?",
            "a": "There is a 3.5 mm shutter release cable port which can trigger all popular cameras."
          }
        },
        "qa_power": {
          "type": "qa",
          "settings": {
            "q": "How is it powered?",
            "a": "It uses a USB-C PD power supply, so it will run on any PD capable power bank or charger."
          }
        },
        "qa_wavelengths": {
          "type": "qa",
          "settings": {
            "q": "What are the LED wavelengths?",
            "a": "Red: 650–670 nm\nGreen: 520–540 nm\nBlue: 440–455 nm\nWhite: 95 CRI, 5700 K\nInfrared: 880 nm"
          }
        },
        "qa_colour_cam": {
          "type": "qa",
          "settings": {
            "q": "Does this even make sense on a non-monochrome camera?",
            "a": "Yes, because by extracting only the relevant RGB channel from each single-colour capture, you are effectively simulating a monochrome camera with some reduction in resolution."
          }
        },
        "qa_mono_cam": {
          "type": "qa",
          "settings": {
            "q": "Would this work better with a monochrome camera?",
            "a": "Yes, this is an ideal scenario, but it is not required to get excellent results. An advantage is that a monochrome/full spectrum sensor allows using the IR array for dust removal in software."
          }
        },
        "qa_combine": {
          "type": "qa",
          "settings": {
            "q": "How do you combine RGB captures?",
            "a": "toneScan Studio does it for you. It captures and merges the RAW files from any camera, and exports them as JPEG or 16-bit TIFF. You can also combine them by hand in Photoshop."
          }
        },
        "qa_what_tonescan": {
          "type": "qa",
          "settings": {
            "q": "What is toneScan?",
            "a": "toneScan is a film scanning system for digital cameras. It combines the toneLight RGB light, the motorised toneCarrier film holder and the toneScan Studio software, so digitising film with your camera is fast and effortless."
          }
        },
        "qa_what_tonelight": {
          "type": "qa",
          "settings": {
            "q": "What is toneLight?",
            "a": "toneLight is our light panel made specifically for film scanning. Its red, green and blue LED arrays are picked for the best channel separation with colour negative film. It also has a 95 CRI white panel for slides and black and white film, and an 880 nm infrared panel for dust reduction with compatible cameras."
          }
        },
        "qa_what_tonecarrier": {
          "type": "qa",
          "settings": {
            "q": "What is toneCarrier?",
            "a": "toneCarrier is our film holder for 35 mm and 120 film, used by thousands of photographers around the world. The motorised version feeds and advances the film for you, and any existing toneCarrier can be upgraded to it in less than 5 minutes."
          }
        },
        "qa_why_camera": {
          "type": "qa",
          "settings": {
            "q": "Why scan film with a camera?",
            "a": "A digital camera with the right light and film holder gives results comparable to a lab scanner, often with more resolution and flexibility, using gear you may already own. toneScan uses the same technique as lab scanners, separate red, green and blue exposures, and automates the rest, so a full roll takes about two minutes."
          }
        },
        "qa_need": {
          "type": "qa",
          "settings": {
            "q": "What do I need?",
            "a": "The toneScan kit (toneLight, the motorised toneCarrier and toneScan Studio), a camera with a standard remote shutter input, and a copy stand or a sturdy tripod to mount it over the kit. toneScan Studio runs on macOS and Windows."
          }
        },
        "qa_kickstarter": {
          "type": "qa",
          "settings": {
            "q": "What is Kickstarter?",
            "a": "Kickstarter is a crowdfunding platform. You back a project by pledging for one of its rewards, and your card is only charged if the project reaches its funding goal by the end of the campaign. Our campaign will help us raise funds for the final prototyping, manufacturing and certification of toneScan."
          }
        },
        "qa_ir": {
          "type": "qa",
          "settings": {
            "q": "Is IR dust removal supported in toneScan Studio?",
            "a": "Not yet. toneLight has an 880 nm infrared panel for dust reduction, but toneScan Studio doesn't support it yet. It also needs a monochrome or full-spectrum camera, because regular camera sensors have a built-in filter that blocks almost all infrared light."
          }
        }
