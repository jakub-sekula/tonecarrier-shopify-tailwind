          "type": "clip",
          "settings": {
            "title": "Colours separated at the source",
            "text": "Each exposure reads essentially one dye layer on its own, making any camera sensor behave like photographic paper and achieving excellent colour separation."
          }
        },
        "clip_consistent": {
          "type": "clip",
          "settings": {
            "title": "Consistent results",
            "text": "Clean input data makes clean final scans which are easy to edit and adjust to your liking. Shadows come out clean, skin tones look more natural and don't drift frame to frame. Set the look once and apply it on the rest of the roll with no surprises."
          }
        },
        "clip_fast": {
          "type": "clip",
          "settings": {
            "title": "Fast and effortless scanning",
            "text": "Digitising film with toneScan is quick and easy: just load the film, advance, and shoot! toneLight sequences the colours, fires the shutter, and advances the film; toneScan picks up the captures and merges them on the fly. Go from first shot to export in just a couple of minutes."
          }
        },
        "clip_integrated": {
          "type": "clip",
          "settings": {
            "title": "An integrated scanning experience",
            "text": "The light, film transport, and software were built to work together from the start. Everything feels cohesive and consistent like a professional tool that you can rely on."
          }
