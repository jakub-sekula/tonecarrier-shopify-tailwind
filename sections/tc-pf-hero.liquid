{{ 'component-tc-pf.css' | asset_url | stylesheet_tag }}

{%- capture tc_dl_icon -%}
  <svg fill="none" stroke-width="2.4" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
{%- endcapture -%}

<section class="tc-pf tc-pf-hero">
  <div class="tc-pf__inner">
    <div class="tc-pf-hero__cols">
      <div class="tc-pf-hero__left">
      <div class="tc-pf-hero__copy tc-pf-hero__a-copy{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {%- if section.settings.caption != blank -%}
          <p class="tc-pf-hero__caption">{{ section.settings.caption | escape }}</p>
        {%- endif -%}
        <h1 class="tc-pf-hero__title">
          {%- if section.settings.heading != blank -%}
            {{ section.settings.heading | escape }}
          {%- else -%}
            {{ collection.title | escape }}
          {%- endif -%}
        </h1>
        {%- if section.settings.text != blank -%}
          <div class="tc-pf-hero__text">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>

      {%- if section.settings.bundle_text != blank -%}
        <div class="tc-pf-hero__bundle tc-pf-hero__a-bundle">
          {%- if section.settings.bundle_badge != blank -%}
            <span class="tc-pf-hero__bundle-badge">{{ section.settings.bundle_badge | escape }}</span>
          {%- endif -%}
          <p class="tc-pf-hero__bundle-text">{{ section.settings.bundle_text | escape }}</p>
        </div>
      {%- endif -%}

      <div class="tc-pf-hero__a-reviews">
        {%- render 'tc-pf-review-carousel', section: section -%}
      </div>

      </div>

      <div class="tc-pf-hero__right">
      {%- assign bundle = section.settings.bundle_product -%}
      {%- if bundle != blank -%}
        {%- liquid
          assign bundle_title = bundle.title | remove: ' (STL only)' | remove: ' (STL Only)' | remove: ' (toneCarrier 35 mm / 120)' | remove: ' (toneCarrier 35 mm)' | remove: ' (toneCarrier 120)'
          assign bundle_digital = false
          if bundle.tags contains 'Digital download'
            assign bundle_digital = true
          endif
        -%}
        <div class="tc-pf-card tc-pf-hero__product tc-pf-hero__a-product{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" {% if settings.animations_reveal_on_scroll %}data-cascade style="--animation-order: 2;"{% endif %}>
          <div class="tc-pf-card__badges">
            {%- if section.settings.savings_badge != blank -%}
              <span class="tc-pf-badge tc-pf-badge--save">{{ section.settings.savings_badge | escape }}</span>
            {%- endif -%}
            {%- if bundle_digital -%}
              <span class="tc-pf-badge">{{ tc_dl_icon }}Digital</span>
            {%- endif -%}
          </div>
          <a class="tc-pf-card__thumb" href="{{ bundle.url }}" tabindex="-1" aria-hidden="true">
            {%- if bundle.featured_image -%}
              <img
                src="{{ bundle.featured_image | image_url: width: 900 }}"
                srcset="{{ bundle.featured_image | image_url: width: 600 }} 600w, {{ bundle.featured_image | image_url: width: 900 }} 900w"
                sizes="(min-width: 990px) 440px, 100vw"
                width="{{ bundle.featured_image.width }}"
                height="{{ bundle.featured_image.height }}"
                loading="eager"
                alt="{{ bundle.featured_image.alt | default: bundle.title | escape }}"
              >
            {%- endif -%}
          </a>
          <div class="tc-pf-card__meta">
            <h2 class="tc-pf-card__title">
              <a class="tc-pf-card__view" href="{{ bundle.url }}" style="font-size: inherit; color: inherit; text-decoration: none;">{{ bundle_title | escape }}</a>
            </h2>
            <p class="tc-pf-card__price">{{ bundle.price | money }}</p>
            <div class="tc-pf-card__row">
              {%- if bundle.variants.size == 1 and bundle.available -%}
                <tc-pf-add
                  data-variant-id="{{ bundle.selected_or_first_available_variant.id }}"
                  data-product-title="{{ bundle_title | escape }}"
                  {% if bundle_digital %}data-digital{% endif %}
                >
                  <button type="button" class="tc-pf-card__atc">{{ 'products.product.add_to_cart' | t }}</button>
                </tc-pf-add>
              {%- else -%}
                <a class="tc-pf-card__atc" style="display: inline-block; text-decoration: none;" href="{{ bundle.url }}">{{ 'products.product.choose_options' | t }}</a>
              {%- endif -%}
              <a class="tc-pf-card__view" href="{{ bundle.url }}">Details</a>
            </div>
          </div>
        </div>
      {%- endif -%}
      {%- if section.settings.cross_label != blank and section.settings.cross_link != blank -%}
        <div class="tc-pf-hero__a-cross">
          <a class="tc-pf-hero__cross" href="{{ section.settings.cross_link }}">
            {{ section.settings.cross_label | escape }}
            <svg fill="none" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/></svg>
          </a>
        </div>
      {%- endif -%}

      </div>
    </div>

  </div>
</section>

{%- render 'tc-pf-confirm' -%}

{% schema %}
{
  "name": "PF: dark hero",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "caption", "label": "Caption", "default": "Print the toneCarrier at home" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave empty to use the collection title." },
    { "type": "richtext", "id": "text", "label": "Lead text" },
    { "type": "header", "content": "Bundle product" },
    { "type": "product", "id": "bundle_product", "label": "Product", "info": "Shown as a card beside the hero copy." },
    { "type": "text", "id": "savings_badge", "label": "Savings badge", "info": "e.g. \"Bundle — save £8.96\"" },
    { "type": "text", "id": "bundle_badge", "label": "Highlight badge", "default": "Save 14%" },
    { "type": "text", "id": "bundle_text", "label": "Highlight text" },
    { "type": "header", "content": "Cross link" },
    { "type": "text", "id": "cross_label", "label": "Label" },
    { "type": "url", "id": "cross_link", "label": "Link" },
    { "type": "header", "content": "Reviews" },
    { "type": "text", "id": "reviews_heading", "label": "Reviews heading", "default": "What owners say" },
    { "type": "range", "id": "autoplay_seconds", "label": "Change review every", "min": 0, "max": 15, "step": 1, "unit": "s", "default": 6, "info": "0 turns auto-advance off." },
    { "type": "checkbox", "id": "load_live", "label": "Load live reviews (Judge.me)", "default": true, "info": "Replaces the review blocks with the latest reviews. Blocks stay as a fallback." },
    { "type": "product", "id": "review_product", "label": "Pull reviews from" },
    { "type": "product", "id": "review_product_2", "label": "…and also from", "info": "Optional — e.g. an older listing that still holds reviews." },
    { "type": "product", "id": "review_product_3", "label": "…and also from" },
    { "type": "product", "id": "review_product_4", "label": "…and also from" },
    { "type": "url", "id": "reviews_link", "label": "Reviews link", "info": "Where clicking a review goes. Leave empty to use each review's own product page." },
    { "type": "checkbox", "id": "show_photos", "label": "Show customer photos", "default": true },
    { "type": "range", "id": "min_stars", "label": "Minimum rating", "min": 1, "max": 5, "step": 1, "default": 4 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "author", "label": "Author" },
        { "type": "text", "id": "source", "label": "Source", "default": "Verified purchase" },
        { "type": "url", "id": "link", "label": "Link to the review" },
        { "type": "range", "id": "stars", "label": "Stars", "min": 0, "max": 5, "step": 1, "default": 5 }
      ]
    }
  ],
  "presets": [{ "name": "PF: dark hero" }]
}
{% endschema %}
