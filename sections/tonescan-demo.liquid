{%- comment -%}
  The demo film. One clip, played large, with nothing competing beside it.

  Plays inline rather than opening the video modal the bento tiles use: this is the whole point of
  the section, so making someone click twice to reach it would be perverse. Muted and looping by
  default, because an autoplaying clip with sound is the fastest way to lose a reader, and browsers
  block it anyway. Controls stay on so it can be scrubbed.

  Nothing is required. With no video set the section renders the poster and says the film is on the
  way, so it can go into the page before the recording exists.
{%- endcomment -%}

<div class="tonescan-landing tw:text-neutral-200">
  {%- assign ts_cdn = 'https://cdn.shopify.com/s/files/1/0634/3199/9736/files' -%}
  <section class="ts-livedemo" id="demo">
    <div class="ts-livedemo__inner">
      <div class="ts-livedemo__head">
        {%- if section.settings.eyebrow != blank -%}
        <p class="ts-livedemo__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="ts-livedemo__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
        <p class="ts-livedemo__sub">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>

      {%- comment -%} A YouTube or Vimeo URL becomes an embed. Parsed to the /embed form so the
         common share links (watch?v=, youtu.be/) all work, not just the embed URL. Takes priority
         over an uploaded video: if an embed is set, that is the demo. {%- endcomment -%}
      {%- assign ts_embed = '' -%}
      {%- assign eu = section.settings.embed_url | default: '' -%}
      {%- if eu contains 'youtube.com/embed/' or eu contains 'player.vimeo.com' -%}
        {%- assign ts_embed = eu -%}
      {%- elsif eu contains 'youtu.be/' -%}
        {%- assign yid = eu | split: 'youtu.be/' | last | split: '?' | first | split: '&' | first -%}
        {%- assign ts_embed = 'https://www.youtube.com/embed/' | append: yid -%}
      {%- elsif eu contains 'v=' -%}
        {%- assign yid = eu | split: 'v=' | last | split: '&' | first -%}
        {%- assign ts_embed = 'https://www.youtube.com/embed/' | append: yid -%}
      {%- elsif eu contains 'vimeo.com/' -%}
        {%- assign vid = eu | split: 'vimeo.com/' | last | split: '?' | first | split: '/' | first -%}
        {%- assign ts_embed = 'https://player.vimeo.com/video/' | append: vid -%}
      {%- endif -%}

      <div class="ts-livedemo__frame">
        <div class="ts-livedemo__glow" aria-hidden="true"></div>
        <div class="ts-livedemo__stage">
          {%- if ts_embed != blank -%}
            <iframe class="ts-livedemo__embed" src="{{ ts_embed }}" title="{{ section.settings.heading | escape }}" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
          {%- elsif section.settings.video != blank -%}
            {%- comment -%} video_tag handles the sources and the poster; loop and muted are what
               make autoplay legal, and playsinline stops iOS taking it fullscreen. {%- endcomment -%}
            {{ section.settings.video
               | video_tag: image_size: '1600x', autoplay: section.settings.autoplay, loop: true,
                 muted: true, controls: true, preload: 'metadata',
                 poster: section.settings.poster }}
          {%- elsif section.settings.video_url != blank -%}
            <video class="ts-livedemo__video" controls playsinline preload="metadata"
                   {% if section.settings.poster != blank %}poster="{{ section.settings.poster | image_url: width: 1600 }}"{% endif %}
                   {% if section.settings.autoplay %}autoplay muted loop{% endif %}>
              <source src="{{ section.settings.video_url }}" type="video/mp4">
            </video>
          {%- else -%}
            {%- comment -%} No film yet: the poster stands in rather than an empty black box. {%- endcomment -%}
            <div class="ts-livedemo__placeholder">
              {%- if section.settings.poster != blank -%}
              <img src="{{ section.settings.poster | image_url: width: 2400 }}" alt="" loading="lazy"
                   width="{{ section.settings.poster.width }}" height="{{ section.settings.poster.height }}">
              {%- else -%}
              <img src="{{ ts_cdn }}/organise.png" alt="" loading="lazy" width="3200" height="2000">
              {%- endif -%}
              <p class="ts-livedemo__soon">{{ section.settings.placeholder_note }}</p>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "toneScan demo",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "Empty by default. Renders nothing when blank." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Live demo" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "info": "Empty by default. The film is the point; a paragraph in front of it is not." },
    { "type": "text", "id": "embed_url", "label": "YouTube or Vimeo URL", "info": "A share or watch link. Takes priority over an uploaded video." },
    { "type": "video", "id": "video", "label": "Video", "info": "A video from Shopify Files. Leave empty and the poster shows instead." },
    { "type": "text", "id": "video_url", "label": "Video URL", "info": "Used only when no video is picked above. An .mp4 URL." },
    { "type": "image_picker", "id": "poster", "label": "Poster image" },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay muted", "default": true },
    { "type": "text", "id": "placeholder_note", "label": "Placeholder note", "default": "The full walkthrough is being recorded." }
  ],
  "presets": [ { "name": "toneScan demo" } ]
}
{% endschema %}
