    "settings": [
      {
        "type": "video",
        "id": "background_video",
        "label": "Background video"
      },
      {
        "type": "image_picker",
        "id": "background_image",
        "label": "Background image"
      },
      {
        "type": "range",
        "id": "background_blur",
        "min": 0,
