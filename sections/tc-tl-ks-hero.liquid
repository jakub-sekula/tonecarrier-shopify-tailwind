{%- style -%}

  .hero-section-{{ section.id }} {
    z-index: 1;
    height: 100%;
    position: relative;
    color: white;
    padding-top: calc(5rem + var(--dynamic-header-height));
    margin-top: calc(-1 * var(--dynamic-header-height));
    margin-bottom: {{ section.settings.margin_bottom }}px;
    display: flex;
    flex-direction: column;
    overflow: visible;
  }

  .hero-blocks {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    margin: 6rem auto 10rem;
  }


  .hero-background {
    background: black;
    position: absolute;
    z-index: -10;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .hero-background video,
  .hero-background img {
    background: black;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: calc({{ section.settings.background_opacity }} / 100);
    filter: blur({{ section.settings.background_blur }}px)
  }


  .hero-heading {
    font-family: "Inter Display"
    , sans-serif;
    font-weight: 300;
    color: white;
    font-size: 3.25rem;
    line-height: 1.2em;
    letter-spacing: -0.02em;

  }

/* Perceptually uniform RGB sweep in OKLCH, with fallback */
.hero-heading strong {
  /* Fallback for older browsers */
  background-image: linear-gradient(90deg, #d32, #2a5, #26c, #d32);
  background-size: 100% 100%;
  background-clip: text;
  -webkit-background-clip: text;
  color: transparent;
  font-weight: 600;
  animation: gradientSlide 10s linear infinite;
}
@supports (color: oklch(0.7 0.25 29)) {
  :root {
    --l: 0.7;   /* brightness */
    --c: 0.25;  /* crank chroma for vibrancy */
    --r: 29;    /* red hue */
    --g: 142;   /* green hue */
    --b: 265;   /* blue hue */
  }


  .hero-heading strong {
    background-image: linear-gradient(
      90deg,
      oklch(var(--l) var(--c) var(--r)) 0%,
      oklch(var(--l) var(--c) var(--g)) 33.333%,
      oklch(var(--l) var(--c) var(--b)) 66.666%,
      oklch(var(--l) var(--c) var(--r)) 100%
    );
    background-size: 300% 100%;
  }
}

@keyframes gradientSlide {
  0%   { background-position:   0% 50%; }
  100% { background-position: 100% 50%; }
}

/* Optional: respect reduced motion */
@media (prefers-reduced-motion: reduce) {
  .hero-heading strong { animation: none; background-position: 50% 50%; }
}

.hero-text {
    font-size: 1.4rem;
    line-height: 1.5em;
    font-weight: 200;
    font-family: 'Inter'
  }

  @media (max-width: 330px) {
    .hero-heading * {
      display: inline
    }

    .hero-heading p:not(:last-child) {
      margin-right: 0.5ch;
    }
  }

  .hero-text p {
    display: inline
  }

  .hero-text p:not(:last-child) {
    /* margin-bottom: 1rem; */
    margin-right: 0.5ch;
  }

  .hero-content-wrapper {
    margin: 0 auto;
    width: 100%;
  }

  .hero-button-container {
    display: flex;
    flex-direction: column;
    width: 75%;
    gap: 2rem;
    margin: 0 auto;
  }

  .hero-button-container .button {
    flex-shrink: 0;
    background: var(--tw-color-orange-500);
    color: white;
    /* letter-spacing: inherit; */
    font-size: 1.6rem;
    padding-top: 1rem;
    padding-bottom: 1rem;
    font-weight: 400;
    font-family: "Inter Tight"
    , sans-serif;
  }

  .hero-button-container .button--secondary {
    flex-shrink: 0;
    background: transparent;
    border: 1px solid var(--tw-color-white);
    color: var(--tw-color-white);
  }

  .hero-media-container {
    width: 100%;
    max-width: 800px;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    margin: 0 auto;
    box-shadow: rgba(50, 50, 93, 0.25) 0 13px 27px -5px
    , rgba(0, 0, 0, 0.3) 0 8px 16px -8px;
    border-radius: 0.5rem;
    position: relative;
  }

  .hero-media-container video {
    border-radius: 0.5rem;
    z-index: 2;
  }


  .hero-media-glow {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 30%;
    z-index: 1;
    box-shadow: 0 0 160px 6px rgba(255, 140, 0, 0.15);
  }

  @media (min-width: 450px) {
    .hero-blocks {
      text-align: center;
    }

    .hero-heading {
      font-size: 4rem;
    }


  }


  @media (min-width: 540px) {

    .hero-button-container {
      flex-direction: row;
      width: 100%;
      justify-content: center;
      gap: 2rem;
    }


  }


  @media (min-width: 600px) {
    .hero-text p {
      display: inherit
    }
  }

  /* md (min-width: 768px) */

  @media (min-width: 768px) {

    .hero-section-{{ section.id }} {
      padding-top: calc(6rem + var(--dynamic-header-height));
      margin-top: calc(-1 * var(--dynamic-header-height));
      flex-direction: column;
      align-items: center;
      gap: 3rem
    }

    .hero-heading {
      font-size: 5rem;
      margin-top:5rem;
      margin-bottom: 2rem
    }

    .hero-text {
      font-size: 2.0rem;
      margin-bottom: 6rem
    }

    .hero-content-wrapper {}

  .hero-blocks {
    text-align: center;
  }

  .hero-media-container {
    max-width: 1200px;
    margin-top: 3rem;
    box-shadow: rgba(50, 50, 93, 0.25) 0 50px 100px -20px
    , rgba(0, 0, 0, 0.3) 0 30px 60px -30px;
  }

  .hero-button-container {
    margin-top: 1rem;
    gap: 2rem;
  }

  .hero-button-container .button {
    font-size: 1.6rem;
    padding-top: inherit;
    padding-bottom: inherit;
  }
}

/* lg (min-width: 1024px) */
@media (min-width: 1024px) {

  .hero-heading {
    font-size: 4.8rem
  }

  .hero-text {
    font-size: 1.75rem
  }


}

/* xl (min-width: 1280px) */
@media (min-width: 1280px) {
;
/* Add your 'xl' styles here */
}

/* 2xl (min-width: 1536px) */
@media (min-width: 1536px) {
;
/* Add your '2xl' styles here */
}
{%- endstyle -%}

<section class="tw:py-24 isolate hero-section-{{section.id}} tw:overflow-hidden section-{{ section.id }} section-{{ section.id }}-padding ">
  <div class="hero-content-wrapper  {% unless section.settings.full_width %} page-width{% endunless %}">
    <div class="tw:flex tw:flex-col tw:md:flex-row tw:justify-center">
      <div class="tw:flex tw:flex-col tw:text-center tw:md:text-left tw:items-center tw:md:items-start tw:md:w-7/12 tw:pr-8 tw:pt-10">

        <div class="tw:flex tw:flex-row tw:h-8 tw:gap-6 tw:items-center tw:max-w-fit">
          Coming soon to
          <img src="{{'kickstarter-logo.svg' |  asset_url}}" class="tw:h-full" />
        </div>
        <h1 class="hero-heading">Turn your digital camera into a <strong>precision film scanner.</strong></h1>
        <p class="hero-text">Meet toneLight, the smart RGB scanning light that delivers clean colours,  
improved dynamic range, and a professional workflow that just makes sense.</p>
        <div class="form tw:w-full">
          {% render 'tc-kickstarter-prelaunch-form' %}
        </div>
      </div>
      <div class="tw:flex tw:flex-col tw:md:w-5/12 tw:h-full tw:bg-neutral-900 tw:aspect-square"></div>
    </div>
  </div>
  <div class="hero-background">
    {% if section.settings.background_video != blank %}
      {% assign bg_poster = section.settings.background_image | img_url: width: 1200 %}
      {{ section.settings.background_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, preload: "auto", image_size: "1200px", poster: bg_poster }}

    {% endif %}
    {% if section.settings.background_video == blank and section.settings.background_image != blank %}
      {{ section.settings.background_image | image_url: width: 1200 | image_tag: class: "hero-background" }}
    {% endif %}
  </div>
</section>

<script>
        const header = document.querySelector('.ks-header');
        const announcementBar = document.querySelector('.announcement-bar-section');
        
        console.log(header)

        function updateHeaderHeight() {
            const headerHeight = header.offsetHeight;
            const announcementHeight = announcementBar ? announcementBar.offsetHeight : 0;
            document.documentElement.style.setProperty('--dynamic-header-height', `${headerHeight + announcementHeight}px`);
        }

        function setTransparentHeader() {
            if (window.scrollY === 0) {
                header.style.backgroundColor = 'transparent';
                header.style.border = 'none';
              } else {
                header.style.backgroundColor = ''; // Reset to default or specify another color
            }
        }

        // Update header height on load
        updateHeaderHeight();
        setTransparentHeader()

        // Update header height on window resize
        window.addEventListener('resize', updateHeaderHeight);

        // Scroll event to change header background
        window.addEventListener('scroll', setTransparentHeader);
</script>


{% schema %}
  {
    "name": "Kickstarter hero section",
    "tag": "section",
    "class": "section",
    "disabled_on": {
      "groups": ["header", "footer"]
