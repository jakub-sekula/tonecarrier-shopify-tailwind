{%- comment -%} ===== before/after slider: styles + init ===== {%- endcomment -%}
{%- style -%}
  .ts-ba { position: relative; width: 100%; aspect-ratio: 16 / 9; overflow: hidden; border: 1px solid rgba(255,255,255,.10); border-radius: 2px; background: #0f0f10; touch-action: none; user-select: none; }
  .ts-ba__layer { position: absolute; inset: 0; }
  .ts-ba__before { clip-path: inset(0 calc(100% - var(--pos, 50%)) 0 0); }
  .ts-ba__img { width: 100%; height: 100%;
    background:
      radial-gradient(120% 80% at 18% 12%, #7fb1dc 0%, transparent 55%),
      radial-gradient(130% 90% at 88% 100%, #223a52 0%, transparent 60%),
      linear-gradient(135deg, #13324f 0%, #27512f 55%, #3f5a26 100%); }
  .ts-ba__img--neg { filter: invert(1) hue-rotate(180deg) saturate(1.25) contrast(.95); }
  .ts-ba img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .ts-ba__divider { position: absolute; top: 0; bottom: 0; left: var(--pos, 50%); width: 2px; margin-left: -1px; background: rgba(255,255,255,.92); pointer-events: none; }
  .ts-ba__handle { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); width: 40px; height: 40px; border-radius: 9999px; background: #3b82f6; color: #fff; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 12px rgba(0,0,0,.45); }
  .ts-ba__tag { position: absolute; top: 12px; padding: 4px 8px; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: #fff; background: rgba(0,0,0,.55); border: 1px solid rgba(255,255,255,.15); border-radius: 2px; pointer-events: none; }
  .ts-ba__tag--l { left: 12px; }
  .ts-ba__tag--r { right: 12px; }
  .ts-ba__range { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; }
  .ts-ba__range:focus-visible { outline: 2px solid #3b82f6; outline-offset: -2px; }

  /* ---- scan gallery ---- */
  .ts-scan { position: relative; display: block; width: 100%; aspect-ratio: 3 / 2; overflow: hidden; padding: 0; border: 1px solid rgba(255,255,255,.10); border-radius: 2px; background: #0f0f10; cursor: zoom-in; }
  .ts-scan__img { position: absolute; inset: 0; display: block;
    background:
      radial-gradient(120% 80% at 18% 12%, #7fb1dc 0%, transparent 55%),
      radial-gradient(130% 90% at 88% 100%, #223a52 0%, transparent 60%),
      linear-gradient(135deg, #13324f 0%, #27512f 55%, #3f5a26 100%);
    filter: hue-rotate(var(--h, 0deg)); transition: transform .45s ease; }
  .ts-scan:hover .ts-scan__img { transform: scale(1.04); }
  .ts-scan__cap { position: absolute; inset: auto 0 0 0; display: flex; justify-content: space-between; gap: 8px; padding: 10px 12px; font-size: 12px; color: #fff; background: linear-gradient(to top, rgba(0,0,0,.72), transparent); opacity: 0; transition: opacity .25s ease; }
  .ts-scan:hover .ts-scan__cap, .ts-scan:focus-visible .ts-scan__cap { opacity: 1; }
  .ts-scan__fmt { color: #9db7d6; }
  .ts-scan:focus-visible { outline: 2px solid #3b82f6; outline-offset: 2px; }

  /* ---- lightbox ---- */
  .ts-lb { position: fixed; inset: 0; z-index: 100; display: flex; align-items: center; justify-content: center; padding: 24px; }
  .ts-lb[hidden] { display: none; }
  .ts-lb__backdrop { position: absolute; inset: 0; background: rgba(0,0,0,.85); backdrop-filter: blur(4px); }
  .ts-lb__panel { position: relative; z-index: 1; display: flex; flex-direction: column; width: min(1100px, 100%); max-height: 90vh; overflow: hidden; background: #0f0f10; border: 1px solid rgba(255,255,255,.12); border-radius: 2px; }
  .ts-lb__stage { position: relative; flex: 1; min-height: 300px; background: #0f0f10; }
  .ts-lb__imgwrap { position: absolute; inset: 0; }
  .ts-lb__imgwrap img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .ts-lb__meta { width: 100%; margin: 0; padding: 16px 24px; border-top: 1px solid rgba(255,255,255,.10); }
  .ts-lb__row { display: flex; flex-direction: column; gap: 2px; padding: 9px 0; border-bottom: 1px solid rgba(255,255,255,.06); }
  .ts-lb__row:last-child { border-bottom: 0; }
  .ts-lb__row dt { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: #8a8a8a; }
  .ts-lb__row dd { margin: 0; font-size: 15px; color: #fff; }
  .ts-lb__close { position: absolute; top: 10px; right: 10px; z-index: 3; width: 34px; height: 34px; border-radius: 2px; background: rgba(0,0,0,.5); border: 1px solid rgba(255,255,255,.15); color: #fff; font-size: 20px; line-height: 1; cursor: pointer; }
  .ts-lb__nav { position: absolute; top: 50%; transform: translateY(-50%); z-index: 3; width: 40px; height: 40px; border-radius: 9999px; background: rgba(0,0,0,.55); border: 1px solid rgba(255,255,255,.15); color: #fff; font-size: 22px; line-height: 1; cursor: pointer; }
  .ts-lb__prev { left: 12px; }
  .ts-lb__next { right: 12px; }
  .ts-lb__close:focus-visible, .ts-lb__nav:focus-visible { outline: 2px solid #3b82f6; outline-offset: 2px; }
  @media (min-width: 900px) {
    .ts-lb__panel { flex-direction: row; }
    .ts-lb__meta { width: 300px; flex-shrink: 0; border-top: 0; border-left: 1px solid rgba(255,255,255,.10); padding: 24px; }
  }

  /* let the splayed channels overflow their frame without causing horizontal page scroll */
  .ts-clip-x { overflow-x: clip; }

  /* ---- rgb merge (scroll-linked --s spread; .is-converted crossfades the result) ---- */
  .ts-rgb { position: relative; width: 100%; aspect-ratio: 3 / 2; overflow: visible; }
  .ts-rgb__stage { position: absolute; inset: 0; isolation: isolate; }
  .ts-rgb__ch { position: absolute; inset: 8%; mix-blend-mode: screen; background-size: cover; background-position: center; transform-origin: center; will-change: transform; }
  .ts-rgb__ch--r { background-image: url('{{ 'raw-red.jpg' | asset_url }}'); transform: translate(calc(-15% * var(--s, 1)), calc(-9% * var(--s, 1))) rotate(calc(-2deg * var(--s, 1))); }
  .ts-rgb__ch--g { background-image: url('{{ 'raw-green.jpg' | asset_url }}'); transform: translateY(calc(10% * var(--s, 1))); }
  .ts-rgb__ch--b { background-image: url('{{ 'raw-blue.jpg' | asset_url }}'); transform: translate(calc(15% * var(--s, 1)), calc(-9% * var(--s, 1))) rotate(calc(2deg * var(--s, 1))); }
  /* real converted output — crossfades in all at once once the merge completes */
  .ts-rgb__result { position: absolute; inset: 8%; z-index: 1; opacity: 0; transition: opacity .55s ease; background-size: cover; background-position: center; will-change: opacity;
    background-image: url('{{ 'converted.jpg' | asset_url }}'); }
  .ts-rgb.is-converted .ts-rgb__result { opacity: 1; }
  .ts-rgb__cap { position: absolute; left: 12px; bottom: 12px; z-index: 2; padding: 5px 10px; font-size: 12px; color: #fff; background: rgba(0,0,0,.55); border: 1px solid rgba(255,255,255,.15); border-radius: 2px; }

  /* ---- workflow story: sticky centred text (left) + scrolling media (right) ---- */
  .ts-story__frame { position: relative; aspect-ratio: 4 / 3; overflow: hidden; border: 1px solid rgba(255,255,255,.10); border-radius: 2px; background: #0f0f10; background-size: cover; background-position: center; }
  .ts-story__v0 { background-image: linear-gradient(140deg, #16263a 0%, #3a2f1c 100%); }
  .ts-story__v1 { background-image: url('{{ 'converted.jpg' | asset_url }}'); }
  .ts-story__v2 { background-image: url('{{ 'tonescan-hero.png' | asset_url }}'); }
  .ts-story__v3 { background-image: linear-gradient(140deg, #241a3a 0%, #17302b 100%); }
  .ts-story__tag { position: absolute; left: 12px; bottom: 12px; padding: 5px 10px; font-size: 12px; color: #fff; background: rgba(0,0,0,.55); border: 1px solid rgba(255,255,255,.15); border-radius: 2px; }
  .ts-story__num { display: block; margin-bottom: 12px; font-size: 12px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: #60a5fa; }
  .ts-story__title { font-size: 24px; line-height: 1.15; font-weight: 600; letter-spacing: -.01em; color: #fff; }
  .ts-story__body { margin-top: 12px; max-width: 440px; font-size: 16px; line-height: 1.6; color: #a3a3a3; }
  .ts-story__text--inline { margin-top: 20px; }
  @media (min-width: 750px) {
    .ts-story { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; }
    .ts-story__sticky { position: sticky; top: 0; height: 100vh; display: flex; align-items: center; }
    .ts-story__textwrap { display: grid; }
    .ts-story__text { grid-area: 1 / 1; opacity: 0; transition: opacity .5s ease; }
    .ts-story__text.is-active { opacity: 1; }
    .ts-story__panel { min-height: 100vh; display: flex; flex-direction: column; justify-content: center; }
    .ts-story__title { font-size: 32px; }
  }

  /* ---- hero scroll: image grows slightly (no fade); floats scatter, converge into the
         screenshot centre and rack into focus (blur->0, scale->1) as --p goes 0->1 ---- */
  .ts-hero { --p: 0; }
  /* COLOURFUL hero region — its bottom edge is the SHARP CUT to the page black (#0a0a0b). */
  .ts-hero-color {
    position: relative;
    background:
      radial-gradient(46% 42% at 18% 16%, rgba(239,68,68,.20) 0%, transparent 62%),   /* red blob */
      radial-gradient(44% 40% at 84% 20%, rgba(34,197,94,.16) 0%, transparent 62%),    /* green blob */
      radial-gradient(56% 48% at 55% 40%, rgba(59,130,246,.22) 0%, transparent 64%),   /* blue blob */
      linear-gradient(180deg, #17171b 0%, #141416 55%, #0f0f11 100%);                  /* dark grey base */
  }
  /* hero text/CTAs pin (sticky), then the frame scrolls up OVER them and hides them (GitHub-style).
     z-order: floats (-1) < text (0) < frame (1). Fade is a safety net so the text can't reappear
     after the frame passes above it. */
  /* pinned from the top (JS sets `top` to the text's natural offset so it doesn't scroll before
     sticking — GitHub-style). Shrinks + fades as --p grows and the frame rises to cover it. */
  .ts-hero-text { position: sticky; top: 80px; z-index: 0; opacity: calc(1 - var(--p) * 1.35); transform: scale(calc(1 - var(--p) * 0.08)); transform-origin: center top; will-change: opacity, transform; }
  /* frame dips PAST the colour cut (negative bottom margin) so the dark screenshot bottom melts
     into black — the "cut off" look. Bottom of the glass is open (no border/radius). */
  .ts-hero-frame { position: relative; z-index: 1; margin-bottom: -104px; }
  .ts-hero-glow { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .ts-hero-glow::before, .ts-hero-glow::after { content: ''; position: absolute; border-radius: 50%; aspect-ratio: 1; filter: blur(90px); }
  .ts-hero-glow::before { left: 30%; top: 46%; width: 52%; transform: translate(-50%, -50%); background: rgba(59,130,246,.30); }
  .ts-hero-glow::after { left: 70%; top: 56%; width: 44%; transform: translate(-50%, -50%); background: rgba(56,189,248,.18); }
  .ts-hero-glass { position: relative; z-index: 1; padding: 16px 16px 0; border: 1px solid rgba(255,255,255,.16); border-bottom: 0; border-radius: 10px 10px 0 0; background: rgba(255,255,255,.05); box-shadow: 0 30px 90px -30px rgba(0,0,0,.85); transform: scale(var(--hs, 0.8)); transform-origin: center bottom; will-change: transform; }
  /* stage crops the screenshot bottom (object-position top) so the bottom edge is a clean cut */
  .ts-hero-stage { position: relative; width: 100%; aspect-ratio: 2000 / 980; overflow: hidden; border-radius: 3px 3px 0 0; background: #0f0f10; }
  .ts-hero-shot { position: absolute; inset: 0; opacity: 0; transition: opacity .5s ease; }
  .ts-hero-shot.is-active { opacity: 1; }
  img.ts-hero-shot { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
  div.ts-hero-shot { display: flex; align-items: center; justify-content: center; background-size: cover; background-position: center; font-size: 13px; color: #6a6a6a; }
  .ts-hero-shot[data-shot="1"] { background-image: linear-gradient(135deg, #16263a, #2d3a1e); }
  .ts-hero-shot[data-shot="2"] { background-image: linear-gradient(135deg, #241a3a, #17302b); }
  .ts-hero-shot[data-shot="3"] { background-image: linear-gradient(135deg, #3a2a16, #1a2a3a); }
  /* SELECTOR bar — on the black region below the cut; clears the dipped image with top padding */
  .ts-hero-selectbar { padding-top: 140px; padding-bottom: 8px; }
  .ts-hero-tabs { position: relative; z-index: 3; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
  .ts-hero-tab { padding: 8px 16px; font-size: 14px; font-weight: 500; color: #a3a3a3; background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.10); border-radius: 2px; cursor: pointer; transition: color .2s ease, background .2s ease, border-color .2s ease; }
  .ts-hero-tab.is-active { color: #fff; background: rgba(59,130,246,.14); border-color: rgba(59,130,246,.5); }
  .ts-hero-tab:hover:not(.is-active) { color: #fff; background: rgba(255,255,255,.06); }
  .ts-hero-tab:focus-visible { outline: 2px solid #3b82f6; outline-offset: 2px; }
  /* mobile selector (dots + native select) — hidden on desktop */
  .ts-hero-mobsel { display: none; flex-direction: column; align-items: center; gap: 16px; }
  .ts-hero-dots { display: flex; gap: 8px; }
  .ts-hero-dot { width: 8px; height: 8px; border-radius: 9999px; background: rgba(255,255,255,.22); transition: background .2s ease, width .2s ease; }
  .ts-hero-dot.is-active { width: 22px; border-radius: 9999px; background: #e5e5e5; }
  .ts-hero-selectwrap { position: relative; width: 100%; max-width: 320px; }
  .ts-hero-select { -webkit-appearance: none; appearance: none; width: 100%; padding: 14px 44px 14px 20px; font-size: 16px; font-weight: 600; color: #fff; background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.14); border-radius: 3px; cursor: pointer; }
  .ts-hero-select:focus-visible { outline: 2px solid #3b82f6; outline-offset: 2px; }
  .ts-hero-select option { color: #111; }
  .ts-hero-selectcaret { position: absolute; right: 18px; top: 50%; transform: translateY(-50%); width: 12px; height: 8px; color: #a3a3a3; pointer-events: none; }
  @media (max-width: 749px) {
    /* no grow-on-scroll; screenshot bleeds wider than the viewport ("cut off / off-screen") */
    .ts-hero-glass { transform: none; }
    .ts-hero-frame { width: 132%; max-width: none; margin-left: -16%; margin-right: -16%; margin-bottom: -64px; }
    .ts-hero-selectbar { padding-top: 92px; }
    .ts-hero-tabs { display: none; }
    .ts-hero-mobsel { display: flex; }
  }
  /* z-index 0 (not -1) so the "explosion" floats sit ABOVE the colour bg but behind text/frame.
     At rest they scatter below the headline (anchor top:44%); on scroll (--p) they converge
     inward to centre AND downward (--drop, set by JS to the frame's lower edge) so they slide
     BEHIND the screenshot's bottom instead of collapsing to the middle of the page. */
  .hero-floats { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .hero-float { position: absolute; left: 50%; top: 44%; width: var(--w, 160px); aspect-ratio: 3 / 2; border-radius: 2px; border: 1px solid rgba(255,255,255,.08); background-size: cover; background-position: center;
    transform: translate(-50%, -50%)
      translate(calc(var(--x) * (1 - var(--p))), calc(var(--y) * (1 - var(--p))))
      translate(0, calc(var(--drop, 55vh) * var(--p)))
      rotate(calc(var(--r, 0deg) * (1 - var(--p))))
      scale(calc(var(--s, 1) + (1 - var(--s, 1)) * var(--p)));
    filter: blur(calc(var(--blur, 0px) * (1 - var(--p))));
    opacity: calc(0.6 + 0.4 * var(--p));
    will-change: transform, filter, opacity; }
  .hero-float--1 { --x: -40vw; --y: -6vh;  --blur: 7px;  --s: .62; --r: -6deg; --w: 200px; background-image: url('{{ 'raw-red.jpg' | asset_url }}'); }
  .hero-float--2 { --x: -28vw; --y: 12vh;  --blur: 2px;  --s: .90; --r: -3deg; --w: 240px; background-image: url('{{ 'converted.jpg' | asset_url }}'); }
  .hero-float--3 { --x: -20vw; --y: -14vh; --blur: 9px;  --s: .55; --r: 4deg;  --w: 170px; background-image: url('{{ 'raw-green.jpg' | asset_url }}'); }
  .hero-float--4 { --x: 20vw;  --y: -14vh; --blur: 8px;  --s: .58; --r: -4deg; --w: 176px; background-image: url('{{ 'raw-blue.jpg' | asset_url }}'); }
  .hero-float--5 { --x: 30vw;  --y: 6vh;   --blur: 3px;  --s: .88; --r: 5deg;  --w: 236px; background-image: url('{{ 'converted.jpg' | asset_url }}'); }
  .hero-float--6 { --x: 42vw;  --y: 16vh;  --blur: 7px;  --s: .64; --r: 7deg;  --w: 200px; background-image: url('{{ 'raw-red.jpg' | asset_url }}'); }
  .hero-float--7 { --x: -36vw; --y: 22vh;  --blur: 11px; --s: .50; --r: 6deg;  --w: 156px; background-image: url('{{ 'raw-green.jpg' | asset_url }}'); }
  @media (prefers-reduced-motion: reduce) {
    .hero-floats { display: none; }
    .ts-hero-text { position: static; opacity: 1; }
    .ts-hero-glass { transform: none; }
    .ts-hero-shot { transition: none; }
  }

  /* ---- marquee ---- */
  .ts-marquee { overflow: hidden; -webkit-mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent); mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent); }
  .ts-marquee__track { display: flex; width: max-content; animation: ts-marquee 50s linear infinite; }
  .ts-marquee:hover .ts-marquee__track { animation-play-state: paused; }
  .ts-marquee__item { flex: 0 0 auto; width: 300px; margin-right: 16px; aspect-ratio: 3 / 2; border-radius: 2px; border: 1px solid rgba(255,255,255,.10); background-size: cover; background-position: center; }
  @keyframes ts-marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .ts-marquee__track { animation: none; } }

  /* ---- beta signup form (dark, matches the page; POSTs to the Cloudflare Worker) ---- */
  .ts-signup { width: 100%; max-width: 480px; }
  .ts-form { display: flex; gap: 10px; flex-wrap: wrap; }
  .ts-email { flex: 1; min-width: 220px; height: 50px; padding: 0 16px; font-size: 15px; color: #fff; background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.14); border-radius: 2px; outline: none; }
  .ts-email::placeholder { color: #6a6a6a; }
  .ts-email:focus { border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59,130,246,.25); }
  .ts-btn { height: 50px; padding: 0 24px; font-size: 15px; font-weight: 600; color: #fff; cursor: pointer; background: #3b82f6; border: 0; border-radius: 2px; white-space: nowrap; transition: transform .15s ease, background .15s ease; }
  .ts-btn:hover { background: #2f6fed; transform: translateY(-1px); }
  .ts-btn:disabled { opacity: .6; cursor: default; transform: none; }
  .ts-btn:focus-visible { outline: 2px solid #93c5fd; outline-offset: 2px; }
  .ts-msg { min-height: 20px; margin: 14px 2px 0; font-size: 14px; line-height: 1.5; color: #a3a3a3; }
  .ts-msg.ok { color: #4ade80; }
  .ts-msg.err { color: #f87171; }
{%- endstyle -%}

<script>
  (function () {
    document.querySelectorAll('.tonescan-landing .ts-ba').forEach(function (el) {
      var range = el.querySelector('.ts-ba__range');
      if (!range) return;
      var update = function () { el.style.setProperty('--pos', range.value + '%'); };
      range.addEventListener('input', update);
      update();
    });
  })();

  /* scan gallery lightbox */
  (function () {
    var lb = document.querySelector('.tonescan-landing .ts-lb');
    var scans = Array.prototype.slice.call(document.querySelectorAll('.tonescan-landing .ts-scan'));
    if (!lb || !scans.length) return;

    var wrap = lb.querySelector('.ts-lb__imgwrap');
    var keys = ['camera', 'lens', 'light', 'film', 'shot', 'format'];
    var idx = 0;
    var lastFocus = null;

    function render(i) {
      idx = (i + scans.length) % scans.length;
      var el = scans[idx];
      keys.forEach(function (k) {
        var dd = lb.querySelector('[data-k="' + k + '"]');
        if (dd) dd.textContent = el.getAttribute('data-' + k) || '—';
      });
      var img = el.getAttribute('data-img');
      var h = el.style.getPropertyValue('--h') || '0deg';
      wrap.innerHTML = img
        ? '<img src="' + img + '" alt="">'
        : '<span class="ts-scan__img" style="--h:' + h + '"></span>';
    }
    function open(i) {
      lastFocus = document.activeElement;
      render(i);
      lb.hidden = false;
      document.body.style.overflow = 'hidden';
      lb.querySelector('.ts-lb__close').focus();
    }
    function close() {
      lb.hidden = true;
      document.body.style.overflow = '';
      if (lastFocus && lastFocus.focus) lastFocus.focus();
    }

    scans.forEach(function (el, i) { el.addEventListener('click', function () { open(i); }); });
    lb.querySelectorAll('[data-close]').forEach(function (b) { b.addEventListener('click', close); });
    lb.querySelector('.ts-lb__prev').addEventListener('click', function () { render(idx - 1); });
    lb.querySelector('.ts-lb__next').addEventListener('click', function () { render(idx + 1); });
    document.addEventListener('keydown', function (e) {
      if (lb.hidden) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') render(idx - 1);
      else if (e.key === 'ArrowRight') render(idx + 1);
    });
  })();

  /* rgb merge — scroll-linked: channels split when centred low, combine + reveal result as they scroll up */
  (function () {
    var els = document.querySelectorAll('.tonescan-landing .ts-rgb');
    if (!els.length) return;
    var clamp = function (v) { return v < 0 ? 0 : (v > 1 ? 1 : v); };
    var texts = ['Three RGB channel captures', 'Channels aligned & combined', 'Converted with tonescan'];

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      els.forEach(function (el) {
        el.style.setProperty('--s', 0);
        el.classList.add('is-converted');
        var c = el.querySelector('.ts-rgb__cap'); if (c) c.textContent = texts[2];
      });
      return;
    }

    var items = [];
    els.forEach(function (el) { items.push({ el: el, cap: el.querySelector('.ts-rgb__cap'), last: -1 }); });

    function update() {
      var vh = window.innerHeight || document.documentElement.clientHeight;
      items.forEach(function (it) {
        var r = it.el.getBoundingClientRect();
        var p = clamp((vh - r.top) / (vh + r.height)); // 0 entering bottom -> 1 leaving top
        var s = 1 - clamp(p * 2);                        // spread 1..0 over first half (scrubbed)
        it.el.style.setProperty('--s', s.toFixed(3));
        var converted = p >= 0.5;                        // merge complete -> crossfade all at once
        it.el.classList.toggle('is-converted', converted);
        if (it.cap) {
          var ti = converted ? 2 : (p < 0.3 ? 0 : 1);
          if (ti !== it.last) { it.cap.textContent = texts[ti]; it.last = ti; }
        }
      });
    }

    // When scrolling settles near the merge point, snap so it never rests half-merged.
    function maybeSnap() {
      var vh = window.innerHeight || document.documentElement.clientHeight;
      var best = null, bestDist = 1;
      items.forEach(function (it) {
        var r = it.el.getBoundingClientRect();
        var p = clamp((vh - r.top) / (vh + r.height));
        var d = Math.abs(p - 0.5);
        if (d < 0.08 && d < bestDist) { bestDist = d; best = { top: r.top, h: r.height }; }
      });
      if (best && bestDist > 0.006) {
        var targetY = Math.round(window.pageYOffset + best.top - (vh - best.h) / 2);
        try { window.scrollTo({ top: targetY, behavior: 'smooth' }); }
        catch (e) { window.scrollTo(0, targetY); }
      }
    }

    var ticking = false, snapTimer;
    function onScroll() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(function () { update(); ticking = false; });
      }
      clearTimeout(snapTimer);
      snapTimer = setTimeout(maybeSnap, 160);
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', function () { clearTimeout(snapTimer); update(); }, { passive: true });
    update();
  })();

  /* workflow story — the centred media panel drives which pinned text is shown */
  (function () {
    document.querySelectorAll('.tonescan-landing .ts-story').forEach(function (story) {
      var panels = story.querySelectorAll('.ts-story__panel');
      var texts = story.querySelectorAll('.ts-story__textcol .ts-story__text');
      if (!panels.length || !texts.length) return;
      function activate(i) {
        texts.forEach(function (t, ti) { t.classList.toggle('is-active', ti === i); });
      }
      if (!('IntersectionObserver' in window)) { texts[0].classList.add('is-active'); return; }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) activate(parseInt(e.target.getAttribute('data-i'), 10) || 0);
        });
      }, { rootMargin: '-45% 0px -45% 0px', threshold: 0 });
      panels.forEach(function (p) { io.observe(p); });
    });
  })();

  /* hero scroll — screenshot grows slightly; scattered floats converge inward (--p on .ts-hero) */
  (function () {
    var frame = document.querySelector('.tonescan-landing .ts-hero');
    if (!frame) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var scaler = frame.querySelector('.ts-hero-glass');
    var text = frame.querySelector('.ts-hero-text');
    var clamp = function (v) { return v < 0 ? 0 : (v > 1 ? 1 : v); };
    var ticking = false;
    // pin the text at its natural top so it stays put from scroll 0 (no pre-stick drift) — GitHub-style
    function pin() {
      if (!text) return;
      if ((window.pageYOffset || 0) > 2) return; // rect.top is only the natural offset while at the top
      text.style.top = Math.round(text.getBoundingClientRect().top) + 'px';
    }
    pin();
    // set --drop so floats converge onto the frame's lower edge (hide behind the screenshot),
    // not the middle of the page — robust across viewport heights.
    var glassFrame = frame.querySelector('.ts-hero-frame');
    function setDrop() {
      if (!glassFrame) return;
      var heroH = frame.offsetHeight;
      var anchorY = 0.44 * heroH;                                   // matches .hero-float top:44%
      var target = glassFrame.offsetTop + glassFrame.offsetHeight * 0.86; // ~lower edge of the frame
      frame.style.setProperty('--drop', Math.max(0, Math.round(target - anchorY)) + 'px');
    }
    setDrop();
    function onLayout() { pin(); setDrop(); }
    window.addEventListener('load', onLayout);
    window.addEventListener('resize', onLayout);
    function update() {
      var vh = window.innerHeight || document.documentElement.clientHeight;
      var p = clamp(window.pageYOffset / (vh * 0.85));
      frame.style.setProperty('--p', p.toFixed(3));
      if (scaler) {
        // scale 0.8 -> 1.0 as the frame enters from the bottom; full size once 70% has
        // entered, then HOLD (monotonic on the way down — doesn't shrink as it exits the top)
        var r = scaler.getBoundingClientRect();
        var g = r.height > 0 ? clamp((vh - r.top) / (0.7 * r.height), 0, 1) : 1;
        scaler.style.setProperty('--hs', (0.8 + 0.2 * g).toFixed(3));
      }
    }
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () { update(); ticking = false; });
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  })();

  /* hero feature selector — crossfade the framed shot. Desktop = tab pills, mobile = <select> + dots. */
  (function () {
    var hero = document.querySelector('.tonescan-landing .ts-hero-color');
    var bar = document.querySelector('.tonescan-landing .ts-hero-selectbar');
    if (!hero || !bar) return;
    var shots = hero.querySelectorAll('.ts-hero-shot');
    var tabs = bar.querySelectorAll('.ts-hero-tab');
    var dots = bar.querySelectorAll('.ts-hero-dot');
    var select = bar.querySelector('.ts-hero-select');
    function show(i) {
      tabs.forEach(function (t, ti) { var on = ti === i; t.classList.toggle('is-active', on); t.setAttribute('aria-selected', on ? 'true' : 'false'); });
      dots.forEach(function (d, di) { d.classList.toggle('is-active', di === i); });
      shots.forEach(function (s, si) { s.classList.toggle('is-active', si === i); });
      if (select && +select.value !== i) select.value = i;
    }
    tabs.forEach(function (t, ti) { t.addEventListener('click', function () { show(ti); }); });
    if (select) select.addEventListener('change', function () { show(+select.value); });
  })();

  /* beta signup — POST the email to the Cloudflare Worker (double opt-in; the Worker owns all
     key/confirm logic). Do NOT change the fetch URL, the { email } body, or the status handling. */
  (function () {
    var TS_SIGNUP_URL = "https://tonescan-beta-signup.little-pond-7bea.workers.dev/signup";
    var forms = document.querySelectorAll('.tonescan-landing .ts-signup');
    if (!forms.length) return;
    forms.forEach(function (root) {
      var form = root.querySelector('.ts-form');
      var email = root.querySelector('.ts-email');
      var btn = root.querySelector('.ts-btn');
      var msg = root.querySelector('.ts-msg');
      if (!form) return;
      function say(text, kind) { msg.textContent = text; msg.className = 'ts-msg ' + (kind || ''); }
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var value = (email.value || '').trim();
        if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(value)) { say('Please enter a valid email.', 'err'); return; }
        btn.disabled = true;
        say('Sending…');
        fetch(TS_SIGNUP_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: value })
        })
          .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
          .then(function (res) {
            if (!res.ok) throw new Error(res.d && res.d.error);
            if (res.d.status === 'already_issued')
              say("You've already got a key — check your inbox (and spam).", 'ok');
            else
              say("Almost there! Check your email to confirm and we'll send your key.", 'ok');
            form.reset();
          })
          .catch(function () { say('Something went wrong. Please try again.', 'err'); })
          .finally(function () { btn.disabled = false; });
      });
    });
  })();
</script>

