        </div>
      </div>

      <div class="tw:flex tw:flex-col tw:rounded-[2px] tw:border tw:border-white/10 tw:bg-white/[0.02] tw:p-[24px]">
        <div class="tw:mb-[16px] tw:flex tw:h-[40px] tw:w-[40px] tw:items-center tw:justify-center tw:rounded-[2px] tw:bg-[#3b82f6]/15"><div class="tw:h-[16px] tw:w-[16px] tw:rounded-[1px] tw:bg-[#3b82f6]"></div></div>
        <div class="tw:mt-auto">
          <h3 class="tw:text-[17px] tw:font-semibold tw:text-white">Physically accurate inversion</h3>
          <p class="tw:mt-[6px] tw:text-[14px] tw:leading-[1.5] tw:text-neutral-400">Natural, true colour — consistent across the whole roll.</p>
        </div>
      </div>

      <div class="tw:flex tw:flex-col tw:rounded-[2px] tw:border tw:border-white/10 tw:bg-white/[0.02] tw:p-[24px]">
        <div class="tw:mb-[16px] tw:flex tw:h-[40px] tw:w-[40px] tw:items-center tw:justify-center tw:rounded-[2px] tw:bg-[#3b82f6]/15"><div class="tw:h-[16px] tw:w-[16px] tw:rounded-[1px] tw:bg-[#3b82f6]"></div></div>
        <div class="tw:mt-auto">
          <h3 class="tw:text-[17px] tw:font-semibold tw:text-white">True exposure from raw</h3>
          <p class="tw:mt-[6px] tw:text-[14px] tw:leading-[1.5] tw:text-neutral-400">Calibrated from real raw signal, not the histogram.</p>
        </div>
      </div>

      <div class="tw:flex tw:flex-col tw:rounded-[2px] tw:border tw:border-white/10 tw:bg-white/[0.02] tw:p-[24px]">
        <div class="tw:mb-[16px] tw:flex tw:h-[40px] tw:w-[40px] tw:items-center tw:justify-center tw:rounded-[2px] tw:bg-[#3b82f6]/15"><div class="tw:h-[16px] tw:w-[16px] tw:rounded-[1px] tw:bg-[#3b82f6]"></div></div>
        <div class="tw:mt-auto">
          <h3 class="tw:text-[17px] tw:font-semibold tw:text-white">Rich metadata</h3>
          <p class="tw:mt-[6px] tw:text-[14px] tw:leading-[1.5] tw:text-neutral-400">Film stock, camera and dev info tagged into every file.</p>
        </div>
      </div>
    </div>

    {%- comment -%} secondary "and more" grid {%- endcomment -%}
    <div class="tw:mt-[16px] tw:rounded-[2px] tw:border tw:border-white/10 tw:bg-white/[0.015] tw:p-[32px] tw:md:p-[40px]">
      <h3 class="tw:mb-[28px] tw:text-center tw:text-[20px] tw:font-semibold tw:text-white">Plus everything a serious workflow needs</h3>
      <div class="tw:grid tw:grid-cols-1 tw:gap-x-[40px] tw:gap-y-[20px] tw:sm:grid-cols-2 tw:md:grid-cols-3">
        <div class="tw:flex tw:gap-[12px]">
          <span class="tw:mt-[7px] tw:h-[7px] tw:w-[7px] tw:shrink-0 tw:rounded-full tw:bg-[#3b82f6]"></span>
          <div><p class="tw:text-[15px] tw:font-semibold tw:text-white">Hardware control</p><p class="tw:text-[14px] tw:leading-[1.5] tw:text-neutral-400">Drives your light source and advances the film carrier for you.</p></div>
