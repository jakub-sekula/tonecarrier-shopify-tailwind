    { "type": "range", "id": "background_opacity", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Background opacity", "default": 8 },
    { "type": "range", "id": "background_blur", "min": 0, "max": 60, "step": 1, "unit": "px", "label": "Background blur", "default": 5 }
