{%- comment -%}
  Reviewer quotes.

  Block-driven so the toneLight page can carry its real customer quotes through the same section
  as toneScan's. Three shapes, picked by how many quote blocks there are:
    none   the original placeholder, unchanged, so a template that never added blocks renders as
           it always has
    one    the split layout: the quote beside the reviewer's photo
    two+   a row of cards under an optional heading

  Split out of tonescan-landing so the page composes from real sections in a JSON
  template. Page-wide CSS and JS are rendered once by layout/tonescan.liquid, so this
  file carries markup only and can be reordered or removed without taking them with it.
{%- endcomment -%}

<div class="tonescan-landing tw:text-neutral-200">
  {%- if section.blocks.size > 1 -%}
  <section class="tw:mx-auto tw:w-full tw:max-w-[1400px] tw:px-[15px] tw:py-[80px] tw:md:px-[50px] tw:md:py-[120px]">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
    <div class="tw:mx-auto tw:max-w-[760px] tw:text-center">
      {%- if section.settings.eyebrow != blank -%}
      <p class="tw:mb-[16px] tw:text-[13px] tw:font-semibold tw:uppercase tw:tracking-[0.16em] tw:text-[#60a5fa]">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
      <h2 class="tw:text-[32px] tw:font-semibold tw:leading-[1.1] tw:tracking-[-0.02em] tw:text-white tw:md:text-[46px]">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
      <p class="tw:mx-auto tw:mt-[16px] tw:max-w-[560px] tw:text-[16px] tw:text-neutral-400">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
    {%- endif -%}
    <div class="tw:mt-[48px] tw:grid tw:grid-cols-1 tw:gap-[20px] tw:md:grid-cols-3">
      {%- for block in section.blocks -%}
      <figure class="tw:flex tw:flex-col tw:gap-[16px] tw:rounded-[2px] tw:border tw:border-white/10 tw:bg-white/[0.02] tw:p-[28px]" {{ block.shopify_attributes }}>
        <blockquote class="tw:text-[15px] tw:leading-[1.6] tw:text-neutral-200">{{ block.settings.quote }}</blockquote>
        <figcaption class="tw:mt-auto tw:text-[14px] tw:font-semibold tw:text-white">
          {{ block.settings.name }}
          {%- if block.settings.role != blank -%}<span class="tw:block tw:text-[13px] tw:font-normal tw:text-neutral-500">{{ block.settings.role }}</span>{%- endif -%}
        </figcaption>
      </figure>
      {%- endfor -%}
    </div>
  </section>

  {%- else -%}
  <section class="ts-quote-sec">
    <div class="ts-quote">
      {%- assign q = section.blocks.first.settings -%}

      <div class="ts-quote__body" {{ section.blocks.first.shopify_attributes }}>
        <blockquote class="ts-quote__text">
          {%- if section.blocks.size == 1 -%}
          {{ q.quote }}
          {%- else -%}
          [ Short testimonial goes here. Two or three sentences at most. The best ones name the
          thing that changed: how long a roll used to take, what they stopped doing, what they can
          now hand a client. ]
          {%- endif -%}
        </blockquote>

        <div class="ts-quote__by">
          <span class="ts-quote__avatar" aria-hidden="true">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="9" r="3.6"/><path d="M4.8 20a7.2 7.2 0 0 1 14.4 0"/></svg>
          </span>
          <div>
            {%- if section.blocks.size == 1 -%}
            <p class="ts-quote__name">{{ q.name }}</p>
            {%- if q.role != blank -%}<p class="ts-quote__org">{{ q.role }}</p>{%- endif -%}
            {%- else -%}
            <p class="ts-quote__name">[ Reviewer name ]</p>
            <p class="ts-quote__org">[ Role ] · [ Organisation ]</p>
            {%- endif -%}
          </div>
        </div>
      </div>

      {%- comment -%}
        Right half: a photo supplied by the person quoted. Borderless and full height on
        purpose, so the picture fills the cell edge to edge.
      {%- endcomment -%}
      <div class="ts-quote__media">
        {%- if section.blocks.size == 1 and q.photo != blank -%}
        {{ q.photo | image_url: width: 1200 | image_tag: class: 'ts-quote__img', alt: q.name, loading: 'lazy' }}
        {%- else -%}
        <div class="ts-quote__ph">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1"/><circle cx="8.5" cy="10" r="1.6"/><path d="M4 17l5-5 3.5 3.5L16 12l4 4"/></svg>
          <span>[ Photo from the reviewer ]</span>
        </div>
        {%- endif -%}
      </div>

    </div>
  </section>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "toneScan testimonial",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "paragraph", "content": "No quotes shows the placeholder. One quote shows beside its photo. Two or more show as a row of cards under the heading." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "Cards layout only." },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Cards layout only." },
    { "type": "textarea", "id": "subheading", "label": "Subtitle", "info": "Cards layout only." }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "role", "label": "Role or location", "info": "Optional." },
        { "type": "image_picker", "id": "photo", "label": "Photo", "info": "Single-quote layout only." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "toneScan testimonial"
    }
  ]
}
{% endschema %}
