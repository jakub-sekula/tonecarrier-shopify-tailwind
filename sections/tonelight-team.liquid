{%- comment -%}
  toneLight team: one block per person. The photo falls back to a plain square until one is set.
  Optional background video (or image) under a colour overlay. A dark overlay switches the section
  to the dark scheme (ts-dark) so the text stays light over the footage.
{%- endcomment -%}
{%- assign tl_bg = false -%}
{%- if section.settings.bg_video != blank or section.settings.bg_image != blank -%}{%- assign tl_bg = true -%}{%- endif -%}
{%- assign tl_dark = false -%}
{%- if tl_bg and section.settings.overlay == 'dark' -%}{%- assign tl_dark = true -%}{%- endif -%}

<div class="tonescan-landing{% if tl_dark %} ts-dark{% endif %} tw:text-neutral-200">
  <section class="tl-team{% if tl_bg %} tl-team--bg tl-team--{{ section.settings.overlay }}{% endif %} tw:border-y tw:border-white/10 tw:bg-white/[0.015]">
    {%- if tl_bg -%}
    <div class="tl-team__bg" aria-hidden="true">
      {%- if section.settings.bg_video != blank -%}
        {% render 'ts-video', video: section.settings.bg_video, class: 'tl-team__bgmedia' %}
      {%- else -%}
        {%- assign fp = '' -%}{%- if section.settings.bg_image.presentation.focal_point != blank -%}{%- capture fp -%}object-position: {{ section.settings.bg_image.presentation.focal_point }}{%- endcapture -%}{%- endif -%}
        {{ section.settings.bg_image | image_url: width: 2400 | image_tag: class: 'tl-team__bgmedia', alt: '', loading: 'lazy', sizes: '100vw', style: fp }}
      {%- endif -%}
      <span class="tl-team__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}"></span>
    </div>
    {%- endif -%}
    {%- comment -%} Heading centred on top, the people below: two side by side from tablets up. {%- endcomment -%}
    <div class="tl-team__wrap tw:mx-auto tw:w-full tw:max-w-[1400px] tw:px-[15px] tw:py-[80px] tw:md:px-[50px] tw:md:py-[120px]">
      <div class="tl-team__head">
        {%- if section.settings.eyebrow != blank -%}
        <p class="tw:mb-[16px] tw:text-[13px] tw:font-semibold tw:uppercase tw:tracking-[0.16em] tw:text-[#60a5fa]">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="tw:text-[32px] tw:font-semibold tw:leading-[1.1] tw:tracking-[-0.02em] tw:text-white tw:md:text-[46px]">{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
        <p class="tl-team__sub tw:text-[16px] tw:text-neutral-400">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
      <div class="tl-team__list">
        {%- for block in section.blocks -%}
        {%- assign m = block.settings -%}
        <div class="tl-team__card tw:flex tw:gap-[20px] tw:rounded-[2px] tw:border tw:border-white/10 tw:bg-white/[0.02] tw:p-[28px]" {{ block.shopify_attributes }}>
          {%- if m.photo != blank -%}
          {%- assign fp = '' -%}{%- if m.photo.presentation.focal_point != blank -%}{%- capture fp -%}object-position: {{ m.photo.presentation.focal_point }}{%- endcapture -%}{%- endif -%}
          {%- comment -%} Asked for well above the 80px it shows at: the square crop throws away the long
             side of a landscape photo, so a 200px-wide file left only ~130px of height, soft on
             high-density screens. The explicit widths matter: with width: 72, image_tag builds its
             srcset from 72w up, and browsers picked the 72px file. sizes steers the pick. {%- endcomment -%}
          {{ m.photo | image_url: width: 600 | image_tag: class: 'tl-team__photo', alt: m.name, loading: 'lazy', width: 80, height: 80, widths: '240, 480, 600', sizes: '240px', style: fp }}
          {%- else -%}
          <div class="tl-team__photo" aria-hidden="true"></div>
          {%- endif -%}
          <div>
            <h3 class="tl-team__name tw:font-semibold tw:text-white">{{ m.name }}</h3>
            {%- if m.role != blank -%}<p class="tl-team__role tw:text-[13px] tw:text-[#60a5fa]">{{ m.role }}</p>{%- endif -%}
            <p class="tw:mt-[10px] tw:text-[14px] tw:leading-[1.55] tw:text-neutral-400">{{ m.bio }}</p>
          </div>
        </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>

{%- style -%}
  .tl-team--bg { position: relative; isolation: isolate; overflow: hidden; }
  .tl-team__bg { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .tl-team__bgmedia { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: cover; }
  .tl-team__overlay { position: absolute; inset: 0; background: #070709; }
  .tl-team--light .tl-team__overlay { background: #fff; }
  /* cards read as panels over the footage rather than outlines on it */
  .tl-team--dark .tl-team__card { background: rgba(10,10,11,.5); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }
  .tl-team--light .tl-team__card { background: rgba(255,255,255,.7); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }
  .tl-team__photo { flex-shrink: 0; display: block; width: 80px; height: 80px; object-fit: cover; border-radius: 50%; background: #ececea; }
  .tl-team__head { max-width: 720px; margin: 0 auto; text-align: center; }
  .tl-team__sub { margin: 16px auto 0; max-width: 560px; line-height: 1.6; }
  .tl-team__list { display: grid; grid-template-columns: minmax(0, 1fr); gap: 20px; margin-top: 48px; }
  @media (min-width: 768px) { .tl-team__list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .tl-team__name { font-size: 22px; line-height: 1.2; letter-spacing: -.01em; }
  .tl-team__role { margin-top: 4px; }
  .tl-team__card { align-items: flex-start; }
  @media (min-width: 900px) { .tl-team__name { font-size: 24px; } }
{%- endstyle -%}

{% schema %}
{
  "name": "toneLight team",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The team" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The team" },
    { "type": "textarea", "id": "subheading", "label": "Subtitle" },
    { "type": "header", "content": "Background" },
    { "type": "video", "id": "bg_video", "label": "Background video", "info": "Plays muted and looping behind the section, only while it is on screen." },
    { "type": "image_picker", "id": "bg_image", "label": "Background image", "info": "Used when no video is picked." },
    {
      "type": "select",
      "id": "overlay",
      "label": "Overlay",
      "options": [
        { "value": "dark", "label": "Dark (light text)" },
        { "value": "light", "label": "Light (dark text)" }
      ],
      "default": "dark"
    },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay strength", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 70 }
  ],
  "blocks": [
    {
      "type": "member",
      "name": "Team member",
      "settings": [
        { "type": "image_picker", "id": "photo", "label": "Photo" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "role", "label": "Role" },
        { "type": "textarea", "id": "bio", "label": "Bio" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "toneLight team" }]
}
{% endschema %}
