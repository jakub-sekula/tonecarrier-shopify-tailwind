{%- comment -%}
  SPLIT variant of the hero: copy on the left, media on the right bleeding off the page edge,
  stacking on phones. Same settings, same blocks and the same driver as tonescan-hero, because
  the class names the driver binds to are unchanged. Only the layout differs.

  Top of the toneScan Studio landing page: the hero, and the problem statement under it.

  Split out of tonescan-landing so the conversion strip below could become its own section. A
  template renders sections in order, so everything ahead of the strip had to become a section
  too. This one also renders the page-wide CSS and JS, because it is always present and it owns
  the hero background settings the stylesheet needs.
{%- endcomment -%}

<div class="tonescan-landing tw:text-neutral-200">
  {%- comment -%} The lite template (page.tonescan-lite) is a trimmed variant for early testers.
     Detected from the template suffix, so markup is shared rather than duplicated. {%- endcomment -%}
  {%- assign ts_minimal = false -%}
  {%- if template.suffix == 'tonescan-lite' -%}{%- assign ts_minimal = true -%}{%- endif -%}

  {%- comment -%} App screenshots and sample scans live in Shopify Files (Content > Files). Keep
     the base here so a re-upload is a one-line change. {%- endcomment -%}
  {%- assign ts_cdn = 'https://cdn.shopify.com/s/files/1/0634/3199/9736/files' -%}

  {%- comment -%} ============================ 1 · HERO ============================ {%- endcomment -%}
  {%- comment -%}
    GitHub-style hero: a COLOURFUL region (.ts-hero-color, blue gradient) whose bottom edge is a
    SHARP CUT to the page's black (#0a0a0b). The framed screenshot dips past that cut so its dark
    bottom melts into black ("cut off"), and the feature SELECTOR (.ts-hero-selectbar) sits on the
    black part below. Desktop = tab pills; mobile = a <select> + pagination dots, screenshot bleeds
    off-screen wider than the viewport, and no grow-on-scroll.
    overflow-clip (not hidden) so the sticky hero text still pins while floats / wide image stay clipped.
  {%- endcomment -%}
  {%- comment -%} Variants, all settings on this section so both landing pages share one hero:
     theme      dark (toneScan) or light (toneLight / Kickstarter)
     cta_type   the beta signup form, or plain link buttons
     no media   when there are no media blocks the copy centres and the frame is skipped {%- endcomment -%}
  {%- assign ts_theme = section.settings.theme | default: 'dark' -%}
  {%- comment -%} Launch countdown. The same page runs before and after a Kickstarter launch, so
     nothing needs changing on the day: before the launch time the hero shows the countdown and the
     pre-launch badge, after it neither. Liquid picks the starting state so a pre-launch visitor
     never sees a flash of the live badge; the script in tonescan-scripts ticks it and flips it at
     zero, which also corrects a page served from cache. An unparseable time counts as launched. {%- endcomment -%}
  {%- assign ts_launch = section.settings.launch_at | strip -%}
  {%- assign ts_prelaunch = false -%}
  {%- assign ts_left = 0 -%}
  {%- if ts_launch != blank -%}
    {%- assign ts_launch_s = ts_launch | date: '%s' | plus: 0 -%}
    {%- assign ts_now_s = 'now' | date: '%s' | plus: 0 -%}
    {%- if ts_launch_s > ts_now_s -%}
      {%- assign ts_prelaunch = true -%}
      {%- assign ts_left = ts_launch_s | minus: ts_now_s -%}
    {%- endif -%}
  {%- endif -%}
  {%- assign ts_launch_aware = false -%}
  {%- if ts_launch != blank or section.settings.badge_prelaunch != blank -%}{%- assign ts_launch_aware = true -%}{%- endif -%}
  {%- capture ts_badge_text -%}
    {%- if section.settings.badge_prelaunch != blank -%}
      <span class="ts-hero-badge__live"{% if ts_prelaunch %} hidden{% endif %}>{{ section.settings.badge }}</span><span class="ts-hero-badge__pre"{% unless ts_prelaunch %} hidden{% endunless %}>{{ section.settings.badge_prelaunch }}</span>
    {%- else -%}
      {{ section.settings.badge }}
    {%- endif -%}
  {%- endcapture -%}
  {%- assign ts_has_media = false -%}{%- if section.blocks.size > 0 -%}{%- assign ts_has_media = true -%}{%- endif -%}
  <section class="ts-hero-split ts-hero-split--{{ ts_theme }}{% if ts_theme == 'dark' %} ts-dark{% endif %}{% unless ts_has_media %} ts-hero-split--nomedia{% endunless %}{% if section.blocks.size < 2 %} ts-hero-split--notabs{% endif %} tw:relative tw:overflow-clip">
    <div class="tw:pointer-events-none tw:absolute tw:left-1/2 tw:top-[-160px] tw:h-[360px] tw:w-[720px] tw:-translate-x-1/2 tw:rounded-full tw:bg-white/[0.04] tw:blur-[130px]"></div>

    <div class="ts-hero-color">
      {%- comment -%} Background video, same treatment as the homepage hero: blurred and held
         well back so it reads as texture under the gradient rather than competing with the
         copy. Defaults to the same clip the homepage uses; the theme editor can override it
         with a Files video or a still. {%- endcomment -%}
      {%- assign ts_hero_bg = 'https://cdn.shopify.com/videos/c/o/v/3cf4f2b9a1e647b0af03b88868030e86.mp4' -%}
      {%- unless section.settings.background_off -%}
      <div class="ts-hero-bg" aria-hidden="true">
        {%- if section.settings.background_video != blank -%}
          {%- assign ts_bg_poster = section.settings.background_image | image_url: width: 1600 -%}
          {{ section.settings.background_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, preload: "auto", image_size: "1600px", poster: ts_bg_poster }}
        {%- elsif section.settings.background_image != blank -%}
          {{ section.settings.background_image | image_url: width: 1600 | image_tag: loading: 'eager', alt: '' }}
        {%- else -%}
          <video autoplay loop muted playsinline preload="auto">
            <source src="{{ ts_hero_bg }}" type="video/mp4">
          </video>
        {%- endif -%}
      </div>
      {%- endunless -%}
      <div class="ts-hero-particles" aria-hidden="true"><span class="p1"></span><span class="p2"></span><span class="p3"></span></div>
      <div class="ts-hero tw:relative tw:mx-auto tw:w-full tw:max-w-[1400px] tw:px-[15px] tw:pt-[72px] tw:pb-0 tw:md:px-[50px] tw:md:pt-[150px]">
        {%- comment -%}
          Floating sample images, scattered high around the headline, then drift DOWN and inward
          to the screenshot centre (rack into focus) on scroll. --drop tunes how far down they
          travel to reach the hero centre. Swap gradients for real sample scans later.
        {%- endcomment -%}
        <div class="hero-floats tw:hidden tw:md:block" aria-hidden="true">
          <div class="hero-float hero-float--1"></div>
          <div class="hero-float hero-float--2"></div>
          <div class="hero-float hero-float--3"></div>
          <div class="hero-float hero-float--4"></div>
          <div class="hero-float hero-float--5"></div>
          <div class="hero-float hero-float--6"></div>
          <div class="hero-float hero-float--7"></div>
        </div>
        <div class="ts-hero-split__grid">
        <div class="ts-hero-text tw:mx-auto tw:flex tw:max-w-[940px] tw:flex-col tw:items-center tw:gap-[26px] tw:text-center">
          {%- if section.settings.show_icon != false -%}
          {%- if section.settings.icon -%}
          <img class="ts-hero-icon" src="{{ section.settings.icon | image_url: width: 256 }}" alt="" width="256" height="256" fetchpriority="high">
          {%- else -%}
          <img class="ts-hero-icon" src="{{ 'tonescan-icon.png' | asset_url }}" alt="" width="256" height="256" fetchpriority="high">
          {%- endif -%}
          {%- endif -%}

          {%- if section.settings.badge_kickstarter -%}
          <span class="ts-hero-badge ts-hero-badge--ks">{{ ts_badge_text }}{{ 'kickstarter-logo.svg' | inline_asset_content | replace: '<svg ', '<svg role="img" aria-label="Kickstarter" ' }}</span>
          {%- elsif section.settings.badge != blank -%}
          <span class="ts-hero-badge"><i aria-hidden="true"></i>{{ ts_badge_text }}</span>
          {%- endif -%}

          <h1 class="tw:text-[32px] tw:font-semibold tw:leading-[1.08] tw:tracking-[-0.03em] tw:text-white tw:md:text-[58px]">
            {%- comment -%} [rgb]words[/rgb] fills those words with the red, green, blue gradient. {%- endcomment -%}
            {{ section.settings.heading | replace: '[rgb]', '<span class="ts-rgb-text">' | replace: '[/rgb]', '</span>' }}
          </h1>

          <p class="tw:max-w-[620px] tw:text-[16px] tw:leading-[1.5] tw:text-neutral-400 tw:md:text-[20px] tw:md:leading-[1.55]">
            {{ section.settings.subheading }}
          </p>

          {%- if ts_launch_aware -%}
          {%- assign cd_d = ts_left | divided_by: 86400 -%}
          {%- assign cd_h = ts_left | modulo: 86400 | divided_by: 3600 -%}
          {%- assign cd_m = ts_left | modulo: 3600 | divided_by: 60 -%}
          {%- assign cd_s = ts_left | modulo: 60 -%}
          {%- capture cd_ds -%}{% if cd_d < 10 %}0{% endif %}{{ cd_d }}{%- endcapture -%}
          {%- capture cd_hs -%}{% if cd_h < 10 %}0{% endif %}{{ cd_h }}{%- endcapture -%}
          {%- capture cd_ms -%}{% if cd_m < 10 %}0{% endif %}{{ cd_m }}{%- endcapture -%}
          {%- capture cd_ss -%}{% if cd_s < 10 %}0{% endif %}{{ cd_s }}{%- endcapture -%}
          {%- comment -%} Split-flap board: a tile per digit, grouped by unit. {%- endcomment -%}
          <div class="ts-countdown" data-launch="{{ ts_launch | escape }}" role="timer" aria-label="Time until the Kickstarter launch"{% unless ts_prelaunch %} hidden{% endunless %}>
            <div class="ts-countdown__unit"><span class="ts-countdown__num" data-cd="d">{% render 'ts-flap-digits', value: cd_ds %}</span><span class="ts-countdown__label">days</span></div>
            <div class="ts-countdown__unit"><span class="ts-countdown__num" data-cd="h">{% render 'ts-flap-digits', value: cd_hs %}</span><span class="ts-countdown__label">hours</span></div>
            <div class="ts-countdown__unit"><span class="ts-countdown__num" data-cd="m">{% render 'ts-flap-digits', value: cd_ms %}</span><span class="ts-countdown__label">minutes</span></div>
            <div class="ts-countdown__unit"><span class="ts-countdown__num" data-cd="s">{% render 'ts-flap-digits', value: cd_ss %}</span><span class="ts-countdown__label">seconds</span></div>
          </div>
          {%- endif -%}
          {%- comment -%} The call to action is one of three variants, picked by cta_type. Each is
             captured, the chosen one is shown, and when the dev panel exists the link and Kit
             variants also ride along in inert <template>s so the panel can swap between them
             (templates are never shown or run for visitors). {%- endcomment -%}
          {%- capture ts_cta_kit -%}
          {%- comment -%} The Kit (ConvertKit) waitlist form, the same form the other Kickstarter
             pages use, with the hero's own button label. {%- endcomment -%}
          <div class="ts-hero-kit tw:mt-[6px]">
            {% render 'ts-kit-form', label: section.settings.kit_button_text %}
          </div>
          {%- endcapture -%}
          {%- capture ts_cta_link -%}
          <div class="ts-hero-ctas tw:mt-[6px]">
            {%- assign ts_cta_url = section.settings.cta_url -%}
            {%- if ts_cta_url == blank and section.settings.cta_style == 'ks' -%}{%- assign ts_cta_url = settings.tonelight_ks_url -%}{%- endif -%}
            <a class="ts-cta ts-cta--{{ section.settings.cta_style | default: 'accent' }}" href="{{ ts_cta_url | default: '#rewards' }}">{{ section.settings.cta_text }}</a>
            {%- if section.settings.cta2_text != blank -%}
            <a class="ts-cta ts-cta--ghost" href="{{ section.settings.cta2_url | default: '#' }}">{{ section.settings.cta2_text }}{% if section.settings.cta2_chevron %}<svg class="ts-cta__chev" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>{% endif %}</a>
            {%- endif -%}
          </div>
          {%- endcapture -%}
          {%- assign ts_cta = section.settings.cta_type | default: 'form' -%}
          <div class="ts-hero-cta ts-cta-swap" data-cta="{{ ts_cta }}">
          <div class="ts-cta-swap__on">
          {%- if ts_cta == 'kit' -%}
            {{ ts_cta_kit }}
          {%- elsif ts_cta == 'link' -%}
            {{ ts_cta_link }}
          {%- else -%}
          <div class="ts-signup tw:mt-[6px]">
            <form class="ts-form" novalidate>
              <input class="ts-email" type="email" name="email" required
                     placeholder="you@example.com" autocomplete="email" aria-label="Email address">
              <button class="ts-btn" type="submit">{{ section.settings.cta_text }}</button>
            </form>
            <p class="ts-msg" role="status" aria-live="polite"></p>
          </div>
          {%- endif -%}
          </div>
          {%- if ts_launch_aware -%}
            {%- unless ts_cta == 'link' -%}<template data-cta-alt="link">{{ ts_cta_link }}</template>{%- endunless -%}
            {%- unless ts_cta == 'kit' -%}<template data-cta-alt="kit">{{ ts_cta_kit }}</template>{%- endunless -%}
          {%- endif -%}
          </div>
          {%- if section.settings.show_os == false -%}
          {%- if section.settings.sub_cta_text != blank -%}<p class="ts-hero-note">{{ section.settings.sub_cta_text }}</p>{%- endif -%}
          {%- else -%}
          <p class="ts-os-row">
            <span class="ts-os">
              <svg class="ts-os__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"/></svg>
              <svg class="ts-os__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.9-1.801"/></svg>
              {{ section.settings.sub_cta_text }}
            </span>
          </p>
          {%- endif -%}
        </div>

        {%- if ts_has_media -%}
        <div class="ts-hero-frame tw:relative tw:mx-auto tw:mt-[102px] tw:max-w-[1320px]{% if section.blocks.size < 2 %} has-no-nav{% endif %}">
          <div class="ts-hero-glow" aria-hidden="true"></div>
          {%- comment -%} glass frame + stacked feature shots (crossfaded by the selector below).
             Bottom is open (no bottom border) and dips past the colour cut so the dark image
             melts into black. {%- endcomment -%}
          <button type="button" class="ts-hero-nav ts-hero-nav--prev" aria-label="Previous feature">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button type="button" class="ts-hero-nav ts-hero-nav--next" aria-label="Next feature">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="ts-hero-glass">
            <div class="ts-hero-stage">
              {%- comment -%} One slot per block. A block renders as a video when it has one, which
                 autoplays muted on entry with a replay button; otherwise as an image. The first
                 slot is the one the hero opens on. {%- endcomment -%}
              {%- for block in section.blocks -%}
                {%- assign is_video = false -%}
                {%- if block.settings.video != blank -%}{%- assign is_video = true -%}{%- endif -%}
                {%- if block.settings.media_url contains '.mp4' -%}{%- assign is_video = true -%}{%- endif -%}
                {%- if is_video -%}
                <div class="ts-hero-shot ts-hero-vslot{% if forloop.first %} is-active{% endif %}" data-shot="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
                  {%- comment -%} no poster: the video's own first frame is the placeholder {%- endcomment -%}
                  <video class="ts-hero-video" muted playsinline preload="auto"{% if block.settings.loop %} loop{% endif %}>
                    <source src="{% if block.settings.video != blank %}{{ block.settings.video.sources[1].url | default: block.settings.video.sources[0].url }}{% else %}{{ block.settings.media_url }}{% endif %}" type="video/mp4">
                  </video>
                  <button type="button" class="ts-hero-replay" aria-label="Replay video">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5V1L7 6l5 5V7a5 5 0 1 1-5 5H5a7 7 0 1 0 7-7z"/></svg>
                    <span class="ts-hero-replay__label">Replay</span>
                  </button>
                </div>
                {%- elsif block.settings.image == blank and block.settings.media_url == blank -%}
                {%- comment -%} Nothing picked yet: a plain panel holds the space rather than a broken
                   image, so the layout can be judged before the photo or clip exists. {%- endcomment -%}
                <div class="ts-hero-shot ts-hero-shot--ph{% if forloop.first %} is-active{% endif %}" data-shot="{{ forloop.index0 }}" {{ block.shopify_attributes }}><span>{{ block.settings.title | default: 'Image or video' }}</span></div>
                {%- else -%}
                <img class="ts-hero-shot{% if forloop.first %} is-active{% endif %}" data-shot="{{ forloop.index0 }}"
                     src="{% if block.settings.image %}{{ block.settings.image | image_url: width: 3200 }}{% else %}{{ block.settings.media_url }}{% endif %}"
                     alt="{{ block.settings.alt }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                     width="3200" height="2000" {{ block.shopify_attributes }}>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        </div>
        {%- endif -%}
        </div>
      </div>
      {%- comment -%} SELECTOR. Inside the coloured region here, not on the black band below the cut. Desktop: tab pills.
         Mobile: pagination dots + a native <select>. {%- endcomment -%}
      {%- if section.blocks.size > 1 -%}
      <div class="ts-hero-selectbar tw:relative tw:z-[2] tw:mx-auto tw:w-full tw:max-w-[1320px] tw:px-[15px] tw:md:px-[50px]">
        <div class="ts-hero-tabs" role="tablist" aria-label="Features">
          {%- for block in section.blocks -%}
          <button type="button" class="ts-hero-tab{% if forloop.first %} is-active{% endif %}" data-tab="{{ forloop.index0 }}" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}">{{ block.settings.title }}</button>
          {%- endfor -%}
        </div>
        <div class="ts-hero-mobsel">
          <div class="ts-hero-dots" aria-hidden="true">
            {%- for block in section.blocks -%}
            <span class="ts-hero-dot{% if forloop.first %} is-active{% endif %}" data-dot="{{ forloop.index0 }}"></span>
            {%- endfor -%}
          </div>
          <div class="ts-hero-selectwrap">
            <select class="ts-hero-select" aria-label="Choose a feature to preview">
              {%- for block in section.blocks -%}
              <option value="{{ forloop.index0 }}">{{ block.settings.title }}</option>
              {%- endfor -%}
            </select>
            <svg class="ts-hero-selectcaret" viewBox="0 0 12 8" aria-hidden="true"><path d="M1 1.5 6 6.5 11 1.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
        </div>
      </div>
      {%- endif -%}
    </div>

    {%- if ts_launch_aware -%}
    {%- comment -%} Development only, like the pricing panel: previews the hero before and after
       launch without touching the launch time. Hidden unless on a local dev server, in the theme
       editor or with ?mockup=1. "Real time" is what visitors get: whatever the launch time says.
       A direct child of the section so no transformed ancestor becomes the containing block of
       this position: fixed panel. {%- endcomment -%}
    <div class="ts-mock ts-mock--launch" role="group" aria-label="Launch state (development)" hidden>
      <div class="ts-mock__bar">
        <span class="ts-mock__label">Launch state</span>
        <button type="button" class="ts-mock__collapse" aria-expanded="true" aria-label="Collapse panel">&minus;</button>
      </div>
      <div class="ts-mock__body">
        <div class="ts-mock__row">
          <button type="button" data-launch-mock="pre">Countdown</button>
          <button type="button" data-launch-mock="live">After launch</button>
          <button type="button" data-launch-mock="auto">Real time</button>
        </div>
        <span class="ts-mock__sub">Call to action</span>
        <div class="ts-mock__row">
          <button type="button" data-cta-mock="link">Kickstarter button</button>
          <button type="button" data-cta-mock="kit">Kit form</button>
        </div>
      </div>
    </div>
    {%- endif -%}
  </section>


</div>

{%- comment -%} Page-wide CSS and JS are rendered once by layout/tonescan.liquid. Only the two
   values that are settings on THIS section are emitted here. {%- endcomment -%}
{%- style -%}
  .ts-hero-bg video, .ts-hero-bg img {
    opacity: calc({{ section.settings.background_opacity | default: 8 }} / 100);
    filter: blur({{ section.settings.background_blur | default: 5 }}px); }
{%- endstyle -%}

{% schema %}
{
  "name": "toneScan hero (split)",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "theme",
      "label": "Theme",
      "options": [
        { "value": "dark", "label": "Dark (toneScan)" },
        { "value": "light", "label": "Light (toneLight)" }
      ],
      "default": "dark"
    },
    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show app icon",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "icon",
      "label": "App icon",
      "info": "Falls back to the bundled toneScan icon."
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge above the headline",
      "info": "Leave blank to hide it.",
      "default": "Now in open beta"
    },
    {
      "type": "text",
      "id": "badge_prelaunch",
      "label": "Badge before launch",
      "info": "Shown instead of the badge while the countdown runs, e.g. \"Launching on\". Leave blank to keep the badge as it is."
    },
    {
      "type": "checkbox",
      "id": "badge_kickstarter",
      "label": "Kickstarter logo in the badge",
      "info": "Adds the Kickstarter logo after the badge text, e.g. \"Coming soon on\".",
      "default": false
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "info": "Wrap words in [rgb]…[/rgb] to fill them with a red, green, blue gradient.",
      "default": "Film scanning,<br class=\"ts-hero-br\"> start to finish."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subtitle",
      "default": "toneScan Studio turns your camera into a dedicated film scanner. Process whole rolls at the speed of a lab, with trichromatic scanning, accurate inversions and&nbsp;instant, full-resolution previews of every edit."
    },
    {
      "type": "header",
      "content": "Launch countdown"
    },
    {
      "type": "text",
      "id": "launch_at",
      "label": "Launch time",
