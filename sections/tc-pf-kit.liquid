{% comment %}
  tc-pf-kit — dark feature panel for a single (physical) product, styled to
  match the tc-pf page. Renders working variant pills; the add-to-cart goes
  through the shared tc-pf quick-add (snippet tc-pf-confirm), which feeds
  the cart drawer. Digital products would still get the confirmation gate.
{% endcomment %}

{{ 'component-tc-pf.css' | asset_url | stylesheet_tag }}

{%- assign product = section.settings.product -%}

<section class="tc-pf tc-pf-kit">
  <div class="tc-pf__inner">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="tc-pf-kit__intro{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {%- if section.settings.heading != blank -%}
          <h2 class="tc-pf-kit__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="tc-pf-kit__text">{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if product != blank -%}
      {%- liquid
        assign is_digital = false
        if product.tags contains 'Digital download'
          assign is_digital = true
        endif
        assign first_variant = product.selected_or_first_available_variant
      -%}
      <tc-pf-kit class="tc-pf-kit__panel{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" style="display: grid;">
        <div class="tc-pf-kit__media">
          {%- if product.featured_image -%}
            <img
              src="{{ product.featured_image | image_url: width: 900 }}"
              srcset="{{ product.featured_image | image_url: width: 600 }} 600w, {{ product.featured_image | image_url: width: 900 }} 900w"
              sizes="(min-width: 750px) 480px, 100vw"
              width="{{ product.featured_image.width }}"
              height="{{ product.featured_image.height }}"
              loading="lazy"
              alt="{{ product.featured_image.alt | default: product.title | escape }}"
            >
          {%- endif -%}
        </div>
        <div class="tc-pf-kit__content">
          <h3 class="tc-pf-kit__title">
            <a href="{{ product.url }}" style="color: inherit; text-decoration: none;">{{ product.title | escape }}</a>
          </h3>
          <p class="tc-pf-kit__price" data-tc-kit-price>{{ first_variant.price | money }}</p>

          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              <fieldset class="tc-pf-kit__option" style="border: none; margin: 0; padding: 0;">
                <legend class="tc-pf-kit__option-label">{{ option.name | escape }}</legend>
                <div class="tc-pf-kit__pills">
                  {%- for value in option.values -%}
                    {%- assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index -%}
                    <input
                      type="radio"
                      id="{{ input_id }}"
                      name="{{ section.id }}-option-{{ option.position }}"
                      value="{{ value | escape }}"
                      data-tc-kit-option="{{ option.position }}"
                      {% if option.selected_value == value %}checked{% endif %}
                    >
                    <label for="{{ input_id }}">{{ value | escape }}</label>
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endfor -%}
          {%- endunless -%}

          <div class="tc-pf-kit__actions">
            <tc-pf-add
              data-variant-id="{{ first_variant.id }}"
              data-product-title="{{ product.title | escape }}"
              {% if is_digital %}data-digital{% endif %}
            >
              <button type="button" class="tc-pf-card__atc" {% unless first_variant.available %}disabled{% endunless %}>
                {%- if first_variant.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
              </button>
            </tc-pf-add>
            <a class="tc-pf-card__view" href="{{ product.url }}">View full details</a>
          </div>

          <script type="application/json" data-tc-kit-variants>
            [
              {%- for variant in product.variants -%}
                {
                  "id": {{ variant.id }},
                  "available": {{ variant.available }},
                  "price": {{ variant.price | money | json }},
                  "options": {{ variant.options | json }}
                }{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            ]
          </script>
        </div>
      </tc-pf-kit>
    {%- endif -%}
  </div>
</section>

{%- render 'tc-pf-confirm' -%}

<script>
  (() => {
    if (customElements.get('tc-pf-kit')) return;
    class TcPfKit extends HTMLElement {
      connectedCallback() {
        this.variants = JSON.parse(this.querySelector('[data-tc-kit-variants]').textContent);
        this.add = this.querySelector('tc-pf-add');
        this.price = this.querySelector('[data-tc-kit-price]');
        this.button = this.add.querySelector('button');
        this.querySelectorAll('[data-tc-kit-option]').forEach((input) => {
          input.addEventListener('change', () => this.sync());
        });
      }
      sync() {
        const chosen = [];
        this.querySelectorAll('[data-tc-kit-option]:checked').forEach((input) => {
          chosen[parseInt(input.dataset.tcKitOption, 10) - 1] = input.value;
        });
        const variant = this.variants.find((v) => v.options.every((o, i) => o === chosen[i]));
        if (!variant) return;
        this.add.dataset.variantId = variant.id;
        this.price.textContent = variant.price;
        this.button.disabled = !variant.available;
        this.button.textContent = variant.available
          ? {{ 'products.product.add_to_cart' | t | json }}
          : {{ 'products.product.sold_out' | t | json }};
      }
    }
    customElements.define('tc-pf-kit', TcPfKit);
  })();
</script>

{% schema %}
{
  "name": "PF: hardware kit",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete your build" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "product", "id": "product", "label": "Product" }
  ],
  "presets": [{ "name": "PF: hardware kit" }]
}
{% endschema %}
