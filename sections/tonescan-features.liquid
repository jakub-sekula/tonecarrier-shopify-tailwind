{%- comment -%}
  The platform bento, its detail accordion, and the video lightbox those tiles open.

  Split out of tonescan-landing so the page composes from real sections in a JSON
  template. Page-wide CSS and JS are rendered once by layout/tonescan.liquid, so this
  file carries markup only and can be reordered or removed without taking them with it.
{%- endcomment -%}

<div class="tonescan-landing tw:text-neutral-200">
  {%- comment -%} Screenshots live in Shopify Files (Content > Files). {%- endcomment -%}
  {%- assign ts_cdn = 'https://cdn.shopify.com/s/files/1/0634/3199/9736/files' -%}

  <section id="features" class="tw:mx-auto tw:w-full tw:max-w-[1400px] tw:scroll-mt-[84px] tw:px-[15px] tw:py-[80px] tw:md:px-[50px] tw:md:py-[120px]">
    <div class="tw:mx-auto tw:max-w-[760px] tw:text-center">
      <h2 class="tw:text-[32px] tw:font-semibold tw:leading-[1.1] tw:tracking-[-0.02em] tw:text-white tw:md:text-[46px]">
        {{ section.settings.heading }}
      </h2>
      <p class="tw:mx-auto tw:mt-[18px] tw:max-w-[720px] tw:text-[17px] tw:leading-[1.6] tw:text-neutral-400">
        {{ section.settings.subheading }}
      </p>
    </div>

    {%- comment -%}
      HEADLINE FEATURES, these nine, in this order, are the ones the page leads on. Anything
      that isn't one of them belongs in the "Plus everything" list below, not here.
      Every tile carries a "+" that opens a short video of the feature (.ts-feature-more):
        data-video  = mp4 URL. EMPTY FOR NOW, the modal falls back to the poster plus a
                      "video coming soon" line, so tiles stay clickable until the clips exist.
        data-poster = still shown before playback / instead of it
        data-title  = heading inside the modal
      Filling in data-video is the only change needed when a clip is ready.
    {%- endcomment -%}
    {%- comment -%}
      Nine cards, two of them large. Placement is explicit per position in the CSS below, so
      SOURCE ORDER IS VISUAL ORDER, move an <article> and update its nth-child rule together.
        1 engine (2x2)  2 RGB        3 GPU viewport
        4 flat-field    5 batch edit 6 speed (2x2)
        7 standalone    8 auto-crop  9 hardware control
    {%- endcomment -%}
    {%- comment -%} One block per tile. Large tiles show a framed screenshot beside the text;
       small ones use the image as a background wash behind it. Both carry the "+" that opens the
       lightbox, which reads its poster and video off the same block. {%- endcomment -%}
    <div class="ts-bento-grid tw:mt-[48px]">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- if b.image != blank -%}{%- assign src = b.image | image_url: width: 3200 -%}
        {%- else -%}{%- assign src = b.image_url -%}{%- endif -%}
      <article class="ts-bento{% if b.size == 'large' %} ts-bento--lg{% endif %}" {{ block.shopify_attributes }}>
        <button type="button" class="ts-feature-more" data-video="{{ b.video_url }}" data-poster="{{ src }}" data-title="{{ b.title | escape }}" aria-label="Watch: {{ b.title | escape }}"><span aria-hidden="true">+</span></button>
        {%- if b.size == 'large' -%}
        <div class="ts-bento__media">
          <div class="ts-shot">
            <img src="{{ src }}" alt="{{ b.alt }}" loading="lazy" width="3200" height="2000">
          </div>
        </div>
        <div class="ts-bento__text">
          <div class="ts-tile-icon">{% render 'tonescan-tile-icon', key: b.icon %}</div>
          <h3 class="tw:text-[22px] tw:font-semibold tw:text-white">{{ b.title }}</h3>
          <p class="tw:mt-[10px] tw:text-[15px] tw:leading-[1.6] tw:text-neutral-400">{{ b.description }}</p>
          {%- if b.cta_text != blank -%}
          <a class="ts-bento__cta" href="{{ b.cta_link | default: '#gallery' }}">{{ b.cta_text }}</a>
          {%- endif -%}
        </div>
        {%- else -%}
        <span class="ts-bento__bg" style="--bg:url('{{ src }}')" aria-hidden="true"></span>
        <div class="ts-tile-icon">{% render 'tonescan-tile-icon', key: b.icon %}</div>
        <div class="tw:mt-auto">
          <h3 class="tw:text-[17px] tw:font-semibold tw:text-white">{{ b.title }}</h3>
          <p class="tw:mt-[8px] tw:text-[14px] tw:leading-[1.6] tw:text-neutral-400">{{ b.description }}</p>
        </div>
        {%- endif -%}
      </article>
      {%- endfor -%}
    </div>

  </section>

  <div class="ts-vid" hidden>
    <div class="ts-vid__backdrop" data-close></div>
    <div class="ts-vid__panel" role="dialog" aria-modal="true" aria-label="Feature video">
      <button class="ts-vid__close" type="button" aria-label="Close" data-close>&times;</button>
      <div class="ts-vid__stage"></div>
      <p class="ts-vid__title"></p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "toneScan features",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Everything a film scan needs"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subtitle",
      "default": "Capture, calibration, conversion, culling and export. A complete suite built for film photographers."
    }
  ],
  "presets": [
    {
      "name": "toneScan features"
    }
  ],
  "max_blocks": 12,
  "blocks": [
    {
      "type": "tile",
      "name": "Feature tile",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "select",
          "id": "size",
          "label": "Size",
          "default": "small",
          "options": [
            {
              "value": "large",
              "label": "Large (framed screenshot)"
            },
            {
              "value": "small",
              "label": "Small (background image)"
            }
          ]
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "ic1",
          "options": [
            {
              "value": "ic0",
              "label": "Icon 1"
            },
            {
              "value": "ic1",
              "label": "Icon 2"
            },
            {
              "value": "ic2",
              "label": "Icon 3"
            },
            {
              "value": "ic3",
              "label": "Icon 4"
            },
            {
              "value": "ic4",
              "label": "Icon 5"
            },
            {
              "value": "ic5",
              "label": "Icon 6"
            },
            {
              "value": "ic6",
              "label": "Icon 7"
            },
            {
              "value": "ic7",
              "label": "Icon 8"
            },
            {
              "value": "ic8",
              "label": "Icon 9"
            }
          ]
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Screenshot"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Or an image URL"
        },
        {
          "type": "text",
          "id": "video_url",
          "label": "Video URL",
          "info": "Opens in the lightbox from the + button. Empty shows the screenshot with a note."
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text",
          "info": "Large tiles only."
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "Link text",
          "info": "Optional."
        },
        {
          "type": "text",
          "id": "cta_link",
          "label": "Link URL",
          "default": "#gallery"
        }
      ]
    }
  ]
}
{% endschema %}
