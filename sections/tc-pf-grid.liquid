{% comment %}
  tc-pf-grid — dark megamenu-style product grid for a collection page.
  Uniform tiles; optionally skips the first product when the hero already
  features it as the bundle. Single-variant products get an inline
  add-to-cart that feeds the cart drawer; digital products (tag
  "Digital download") go through the shared confirmation dialog
  (snippet tc-pf-confirm) before adding.
{% endcomment %}

{{ 'component-tc-pf.css' | asset_url | stylesheet_tag }}

{%- capture tc_dl_icon -%}
  <svg fill="none" stroke-width="2.4" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
{%- endcapture -%}

<section class="tc-pf tc-pf-grid">
  <div class="tc-pf__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="tc-pf-grid__head">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <div class="tc-pf-grid__grid">
      {%- liquid
        assign skip = 0
        if section.settings.skip_first
          assign skip = 1
        endif
      -%}
      {%- for product in collection.products offset: skip limit: section.settings.products_to_show -%}
        {%- liquid
          assign clean_title = product.title | remove: ' (STL only)' | remove: ' (STL Only)' | remove: ' (toneCarrier 35 mm / 120)' | remove: ' (toneCarrier 35 mm)' | remove: ' (toneCarrier 120)'
          assign is_digital = false
          if product.tags contains 'Digital download'
            assign is_digital = true
          endif
        -%}
        <div
          class="tc-pf-card{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {% if settings.animations_reveal_on_scroll %}data-cascade style="--animation-order: {{ forloop.index }};"{% endif %}
        >
          <div class="tc-pf-card__badges">
            {%- if is_digital -%}
              <span class="tc-pf-badge">{{ tc_dl_icon }}Digital</span>
            {%- endif -%}
          </div>
          <a class="tc-pf-card__thumb" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
            {%- if product.featured_image -%}
              <img
                src="{{ product.featured_image | image_url: width: 900 }}"
                srcset="{{ product.featured_image | image_url: width: 400 }} 400w, {{ product.featured_image | image_url: width: 600 }} 600w, {{ product.featured_image | image_url: width: 900 }} 900w"
                sizes="(min-width: 990px) 300px, 50vw"
                width="{{ product.featured_image.width }}"
                height="{{ product.featured_image.height }}"
                loading="lazy"
                alt="{{ product.featured_image.alt | default: product.title | escape }}"
              >
            {%- endif -%}
          </a>
          <div class="tc-pf-card__meta">
            <h3 class="tc-pf-card__title">
              <a class="tc-pf-card__view" href="{{ product.url }}" style="font-size: inherit; color: inherit; text-decoration: none;">{{ clean_title | escape }}</a>
            </h3>
            <p class="tc-pf-card__price">{{ product.price | money }}</p>
            <div class="tc-pf-card__row">
              {%- if product.variants.size == 1 and product.available -%}
                <tc-pf-add
                  data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                  data-product-title="{{ clean_title | escape }}"
                  {% if is_digital %}data-digital{% endif %}
                >
                  <button type="button" class="tc-pf-card__atc">{{ 'products.product.add_to_cart' | t }}</button>
                </tc-pf-add>
              {%- else -%}
                <a class="tc-pf-card__atc" style="display: inline-block; text-decoration: none;" href="{{ product.url }}">{{ 'products.product.choose_options' | t }}</a>
              {%- endif -%}
              <a class="tc-pf-card__view" href="{{ product.url }}">Details</a>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- render 'tc-pf-confirm' -%}

{% schema %}
{
  "name": "PF: product grid",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading (optional)" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 24, "step": 1, "default": 12 },
    { "type": "checkbox", "id": "skip_first", "label": "Skip the first product", "info": "Enable when the hero already features it as the bundle.", "default": true }
  ],
  "presets": [{ "name": "PF: product grid" }]
}
{% endschema %}
