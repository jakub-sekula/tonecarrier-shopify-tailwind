  .ks-countdown__sep { color: #3b82f6; font-weight: 600; }
  .ks-countdown.is-live .ks-countdown__num { color: #3b82f6; }

  /* ---- rgb merge (scroll-linked --s spread; .is-converted crossfades the result) ---- */
  .ts-rgb { position: relative; width: 100%; aspect-ratio: 3 / 2; overflow: hidden; border: 1px solid rgba(255,255,255,.10); border-radius: 2px; background: #08080a; }
  .ts-rgb__stage { position: absolute; inset: 0; background: #000; isolation: isolate; }
  .ts-rgb__ch { position: absolute; inset: 6%; mix-blend-mode: screen; background-size: cover; background-position: center; will-change: transform; }
  .ts-rgb__ch--r { background-image: url('{{ 'raw-red.jpg' | asset_url }}'); transform: translate(calc(-12% * var(--s, 1)), calc(-7% * var(--s, 1))) rotate(calc(-2deg * var(--s, 1))); }
  .ts-rgb__ch--g { background-image: url('{{ 'raw-green.jpg' | asset_url }}'); transform: translateY(calc(8% * var(--s, 1))); }
  .ts-rgb__ch--b { background-image: url('{{ 'raw-blue.jpg' | asset_url }}'); transform: translate(calc(12% * var(--s, 1)), calc(-7% * var(--s, 1))) rotate(calc(2deg * var(--s, 1))); }
  .ts-rgb__result { position: absolute; inset: 6%; z-index: 1; opacity: 0; transition: opacity .55s ease; background-size: cover; background-position: center; will-change: opacity; background-image: url('{{ 'converted.jpg' | asset_url }}'); }
  .ts-rgb.is-converted .ts-rgb__result { opacity: 1; }
  .ts-rgb__cap { position: absolute; left: 12px; bottom: 12px; z-index: 2; padding: 5px 10px; font-size: 12px; color: #fff; background: rgba(0,0,0,.55); border: 1px solid rgba(255,255,255,.15); border-radius: 2px; }

  /* ---- timeline ---- */
  .ks-timeline { position: relative; margin: 0; padding: 0 0 0 24px; list-style: none; border-left: 1px solid rgba(255,255,255,.12); }
  .ks-timeline li { position: relative; padding-bottom: 26px; }
  .ks-timeline li:last-child { padding-bottom: 0; }
  .ks-timeline li::before { content: ''; position: absolute; left: -29px; top: 4px; width: 9px; height: 9px; border-radius: 9999px; background: rgba(255,255,255,.35); border: 2px solid #0a0a0b; }
  .ks-timeline li.is-launch::before { background: #3b82f6; box-shadow: 0 0 0 4px rgba(59,130,246,.2); }
  .ks-timeline__date { display: block; font-size: 13px; font-weight: 600; color: #60a5fa; }
  .ks-timeline__event { display: block; margin-top: 2px; font-size: 15px; line-height: 1.5; color: #d4d4d4; }

  /* ---- spectral crosstalk chart ---- */
  .ks-spectral { margin-top: 56px; border: 1px solid rgba(255,255,255,.10); border-radius: 2px; background: rgba(255,255,255,.02); padding: 24px; }
  .ks-spectral__head { display: flex; flex-direction: column; gap: 16px; margin-bottom: 8px; }
  @media (min-width: 750px) { .ks-spectral__head { flex-direction: row; align-items: flex-start; justify-content: space-between; } }
  .ks-spectral__sub { margin-top: 8px; max-width: 560px; font-size: 15px; line-height: 1.6; color: #a3a3a3; transition: opacity .3s ease; }
  .ks-spectral__chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
  .ks-spectral__chip { display: inline-flex; align-items: center; gap: 8px; padding: 7px 12px; font-size: 13px; font-weight: 600; color: #8a8a8a; background: rgba(255,255,255,.02); border: 1px solid rgba(255,255,255,.12); border-radius: 2px; cursor: pointer; transition: color .2s ease, background .2s ease, border-color .2s ease; }
  .ks-spectral__chip.is-active { color: #fff; background: rgba(255,255,255,.08); border-color: rgba(255,255,255,.25); }
  .ks-spectral__chip:focus-visible { outline: 2px solid #3b82f6; outline-offset: 2px; }
  .ks-spectral__sw { width: 20px; height: 8px; border-radius: 2px; flex-shrink: 0; opacity: .45; transition: opacity .2s ease; }
  .ks-spectral__chip.is-active .ks-spectral__sw { opacity: 1; }
  .ks-spectral__sw--dash { background: repeating-linear-gradient(90deg, #d0d0d0 0 4px, transparent 4px 7px); }
  .ks-spectral__chart { width: 100%; height: 380px; margin-top: 16px; }

  /* ---- results 3-way comparison ---- */
  .ks-compare { display: grid; grid-template-columns: 1fr; gap: 14px; }
  @media (min-width: 750px) { .ks-compare { grid-template-columns: repeat(3, 1fr); gap: 16px; } }
  .ks-compare__col { display: flex; flex-direction: column; }
  .ks-compare__label { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; font-size: 13px; font-weight: 600; color: #a3a3a3; }
  .ks-compare__col--feat .ks-compare__label { color: #fff; }
  .ks-compare__dot { width: 7px; height: 7px; border-radius: 9999px; background: #3b82f6; }
  .ks-compare__img { position: relative; display: flex; align-items: center; justify-content: center; aspect-ratio: 3 / 2; padding: 8px; text-align: center; font-size: 12px; color: #6a6a6a; border: 1px solid rgba(255,255,255,.10); border-radius: 2px; background: #0f0f10; background-size: cover; background-position: center; }
  .ks-compare__col--feat .ks-compare__img { border-color: rgba(59,130,246,.55); box-shadow: 0 0 0 1px rgba(59,130,246,.25); }
  .ks-compare__thumbs { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 26px; }
  .ks-compare__thumb { width: 88px; aspect-ratio: 3 / 2; padding: 0; overflow: hidden; cursor: pointer; border: 1px solid rgba(255,255,255,.12); border-radius: 2px; background: #14161c; background-size: cover; background-position: center; opacity: .55; transition: opacity .2s ease, border-color .2s ease; }
  .ks-compare__thumb.is-active { opacity: 1; border-color: #3b82f6; }
  .ks-compare__thumb:focus-visible { outline: 2px solid #3b82f6; outline-offset: 2px; }
{%- endstyle -%}

<script>
  (function () {
    document.querySelectorAll('.tonelight-ks .ks-countdown').forEach(function (el) {
      var target = new Date(el.getAttribute('data-launch')).getTime();
      if (isNaN(target)) return;
      var out = {
        days: el.querySelector('[data-cd="days"]'),
        hours: el.querySelector('[data-cd="hours"]'),
        mins: el.querySelector('[data-cd="mins"]'),
        secs: el.querySelector('[data-cd="secs"]')
      };
      var pad = function (n) { return (n < 10 ? '0' : '') + n; };
      function tick() {
        var diff = target - Date.now();
        if (diff <= 0) {
          el.classList.add('is-live');
          out.days.textContent = out.hours.textContent = out.mins.textContent = out.secs.textContent = '00';
          clearInterval(timer);
          return;
        }
        var s = Math.floor(diff / 1000);
        out.days.textContent = Math.floor(s / 86400);
        out.hours.textContent = pad(Math.floor(s % 86400 / 3600));
        out.mins.textContent = pad(Math.floor(s % 3600 / 60));
        out.secs.textContent = pad(s % 60);
      }
      tick();
      var timer = setInterval(tick, 1000);
    });
  })();

  /* rgb merge — scroll-linked (mirrors the tonescan component) */
  (function () {
    var els = document.querySelectorAll('.tonelight-ks .ts-rgb');
    if (!els.length) return;
    var clamp = function (v) { return v < 0 ? 0 : (v > 1 ? 1 : v); };
    var texts = ['Three RGB channel captures', 'Channels aligned & combined', 'Converted with toneScan Studio'];
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      els.forEach(function (el) {
        el.style.setProperty('--s', 0);
        el.classList.add('is-converted');
        var c = el.querySelector('.ts-rgb__cap'); if (c) c.textContent = texts[2];
      });
      return;
    }
    var items = [];
    els.forEach(function (el) { items.push({ el: el, cap: el.querySelector('.ts-rgb__cap'), last: -1 }); });
    function update() {
      var vh = window.innerHeight || document.documentElement.clientHeight;
      items.forEach(function (it) {
        var r = it.el.getBoundingClientRect();
        var p = clamp((vh - r.top) / (vh + r.height));
        it.el.style.setProperty('--s', (1 - clamp(p * 2)).toFixed(3));
        var converted = p >= 0.5;
        it.el.classList.toggle('is-converted', converted);
        if (it.cap) { var ti = converted ? 2 : (p < 0.3 ? 0 : 1); if (ti !== it.last) { it.cap.textContent = texts[ti]; it.last = ti; } }
      });
    }
    var ticking = false;
    function onScroll() { if (ticking) return; ticking = true; requestAnimationFrame(function () { update(); ticking = false; }); }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  })();

  /* spectral chart — toggleable curve groups (camera sensitivity, film dye density, narrowband RGB, broadband white). ECharts, lazy-loaded. */
  (function () {
    var root = document.querySelector('.tonelight-ks .ks-spectral');
    if (!root) return;
    var mount = root.querySelector('.ks-spectral__chart');
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    var R = [0,0.0066,0.0143,0.022,0.037,0.041,0.0319,0.0286,0.0287,0.0371,0.0466,0.0498,0.0608,0.0865,0.1255,0.1655,0.1516,0.1493,0.1786,0.3118,0.672,1,0.9997,0.903,0.7654,0.6715,0.5411,0.4241,0.2959,0.1854,0.081,0.0272,0.0111,0.0069,0.0044];
    var G = [0,0.0033,0.0116,0.0199,0.0411,0.0652,0.0868,0.1132,0.156,0.2665,0.4036,0.4831,0.6423,0.817,0.919,1,0.9362,0.8976,0.7554,0.6453,0.4866,0.3511,0.2023,0.1153,0.0657,0.0477,0.0351,0.0252,0.0177,0.0135,0.0079,0.004,0.0019,0.0012,0.001];
    var B = [0,0,0.0589,0.151,0.4235,0.7212,0.8276,0.9565,1,0.9871,0.9267,0.7706,0.5878,0.4025,0.2297,0.1412,0.0914,0.0621,0.0387,0.0299,0.0246,0.0206,0.0149,0.0116,0.0102,0.0099,0.0089,0.0095,0.0077,0.0059,0.0027,0.0008,0.0005,0.0004,0.0003];
    var SPD = [0.4242,0.4639,0.7024,0.7765,0.7931,0.7358,0.8901,0.9932,1,0.975,0.984,0.9236,0.9282,0.915,0.8895,0.9141,0.8862,0.8832,0.8488,0.8177,0.8131,0.7528,0.764,0.7605,0.7444,0.707,0.7104,0.6793,0.6809,0.6984,0.6645,0.5918,0.6078,0.6311,0.5229];
    var WL0 = 380, STEP = 10, N = R.length;
    var COL = { r: '#f2555a', g: '#4ade80', b: '#5a9cf0', cy: '#22d3ee', mg: '#e879f9', yr: '#facc15', wht: '#d0d0d0' };
    var LED_SIG = 20 / (2 * Math.sqrt(2 * Math.log(2)));
    var FILM = [['Cyan dye', COL.cy, 680.6, 50.9], ['Magenta dye', COL.mg, 536.6, 27.8], ['Yellow dye', COL.yr, 445.3, 29.5]];
    var LEDS = [['Blue LED (460 nm)', COL.b, 460], ['Green LED (540 nm)', COL.g, 540], ['Red LED (660 nm)', COL.r, 660]];

    function pair(a) { var d = []; for (var i = 0; i < N; i++) d.push([WL0 + i * STEP, a[i]]); return d; }
    function gauss(mu, sig, amp) { amp = amp || 1; var d = []; for (var w = 380; w <= 720; w += 2) d.push([w, +(amp * Math.exp(-0.5 * Math.pow((w - mu) / sig, 2))).toFixed(4)]); return d; }
    function ls(name, color, data, o) {
      o = o || {};
      return { name: name, type: 'line', smooth: (o.smooth !== undefined ? o.smooth : 0.45), symbol: 'none', showSymbol: false,
        data: data, lineStyle: { color: color, width: 2, type: (o.dash ? 'dashed' : 'solid') },
        areaStyle: { color: color, opacity: (o.fill !== undefined ? o.fill : 0.16) }, emphasis: { disabled: true }, z: (o.z || 2) };
    }

    var active = { sensor: true, film: false, narrow: false, broad: true };
    var chart = null;

    function buildSeries() {
      var s = [];
      if (active.broad) s.push(ls('White light', COL.wht, pair(SPD), { smooth: 0.3, fill: 0.04, dash: true, z: 1 }));
      if (active.sensor) { s.push(ls('Red channel', COL.r, pair(R))); s.push(ls('Green channel', COL.g, pair(G))); s.push(ls('Blue channel', COL.b, pair(B))); }
      if (active.film) FILM.forEach(function (f) { s.push(ls(f[0], f[1], gauss(f[2], f[3]), { smooth: 0.25, fill: 0.10 })); });
      if (active.narrow) LEDS.forEach(function (l) { s.push(ls(l[0], l[1], gauss(l[2], LED_SIG, 0.98), { smooth: false, fill: 0.3, z: 3 })); });
      if (!s.length) s.push({ name: '', type: 'line', data: [] });
      return s;
    }
    function option() {
      return {
        animationDuration: reduce ? 0 : 900, animationEasing: 'cubicOut',
        grid: { left: 6, right: 16, top: 22, bottom: 52, containLabel: true },
        legend: { show: false },
        tooltip: { trigger: 'axis', backgroundColor: '#141416', borderColor: 'rgba(255,255,255,.12)', textStyle: { color: '#e5e5e5', fontSize: 12 },
          axisPointer: { type: 'line', lineStyle: { color: 'rgba(255,255,255,.25)' } },
          formatter: function (ps) { var out = Math.round(ps[0].axisValue) + ' nm'; ps.forEach(function (p) { if (p.seriesName) out += '<br>' + p.marker + p.seriesName + ': ' + Math.round(p.value[1] * 100) + '%'; }); return out; } },
        xAxis: { type: 'value', min: 380, max: 720, interval: 100,
          name: 'Wavelength (nm)', nameLocation: 'middle', nameGap: 32, nameTextStyle: { color: '#8a8a8a', fontSize: 12 },
          axisLine: { lineStyle: { color: 'rgba(255,255,255,.25)' } },
          axisTick: { show: true, lineStyle: { color: 'rgba(255,255,255,.25)' } },
          minorTick: { show: true, splitNumber: 2, lineStyle: { color: 'rgba(255,255,255,.15)' } },
          axisLabel: { color: '#8a8a8a', fontSize: 11 },
          splitLine: { show: true, lineStyle: { color: 'rgba(255,255,255,.05)' } },
          minorSplitLine: { show: true, lineStyle: { color: 'rgba(255,255,255,.025)' } } },
        yAxis: { type: 'value', min: 0, max: 1.08, interval: 0.25,
          name: 'Relative (normalised)', nameLocation: 'middle', nameGap: 42, nameTextStyle: { color: '#8a8a8a', fontSize: 12 },
          axisLine: { show: false }, axisTick: { show: false },
          axisLabel: { show: true, color: '#8a8a8a', fontSize: 11, formatter: function (v) { return Math.round(v * 100) + '%'; } },
          splitLine: { show: true, lineStyle: { color: 'rgba(255,255,255,.05)' } } },
        series: buildSeries()
      };
    }
    function render() { if (chart) chart.setOption(option(), { replaceMerge: ['series'] }); }

    root.querySelectorAll('.ks-spectral__chip').forEach(function (chip) {
      chip.addEventListener('click', function () {
        var gn = chip.getAttribute('data-group');
        active[gn] = !active[gn];
        chip.classList.toggle('is-active', active[gn]);
        chip.setAttribute('aria-pressed', active[gn] ? 'true' : 'false');
        render();
      });
    });

    var libLoading = false;
    function ensure(cb) {
      if (window.echarts) return cb();
      if (libLoading) return;
      libLoading = true;
      var sc = document.createElement('script');
      sc.src = 'https://cdn.jsdelivr.net/npm/echarts@5.5.1/dist/echarts.min.js';
      sc.async = true; sc.onload = cb;
      document.head.appendChild(sc);
    }
    function boot() { if (!window.echarts || chart) return; chart = echarts.init(mount, null, { renderer: 'canvas' }); chart.setOption(option()); window.addEventListener('resize', function () { chart.resize(); }); }
    if ('IntersectionObserver' in window) { var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { ensure(boot); io.disconnect(); } }); }, { threshold: 0.35 }); io.observe(root); }
    else ensure(boot);
  })();

  /* results — 3-way comparison sample switcher */
  (function () {
    var sec = document.querySelector('.tonelight-ks #results');
    if (!sec) return;
    var slots = { white: sec.querySelector('[data-slot="white"]'), rgb: sec.querySelector('[data-slot="rgb"]'), lab: sec.querySelector('[data-slot="lab"]') };
    var thumbs = sec.querySelectorAll('.ks-compare__thumb');
    var LBL = { white: 'white light', rgb: 'toneLight RGB', lab: 'pro lab scan' };
    // Placeholder frames — set white/rgb/lab image URLs per frame (assets or CDN) when ready.
    var SAMPLES = [
      { name: 'Portra 400', white: '', rgb: '', lab: '' },
      { name: 'CineStill 800T', white: '', rgb: '', lab: '' },
      { name: 'Gold 200', white: '', rgb: '', lab: '' },
      { name: 'Ektar 100', white: '', rgb: '', lab: '' }
    ];
    function show(i) {
      var sm = SAMPLES[i] || SAMPLES[0];
      Object.keys(slots).forEach(function (k) {
        var el = slots[k]; if (!el) return;
        if (sm[k]) { el.style.backgroundImage = 'url(' + sm[k] + ')'; el.textContent = ''; }
        else { el.style.backgroundImage = ''; el.textContent = '[ ' + LBL[k] + ' — ' + sm.name + ' ]'; }
      });
      thumbs.forEach(function (t, ti) { t.classList.toggle('is-active', ti === i); });
    }
    thumbs.forEach(function (t, ti) {
      if (SAMPLES[ti]) t.setAttribute('aria-label', SAMPLES[ti].name);
      t.addEventListener('click', function () { show(ti); });
    });
    show(0);
  })();
</script>

