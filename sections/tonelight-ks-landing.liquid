      <p class="tw:mx-auto tw:mt-[12px] tw:mb-[28px] tw:max-w-[480px] tw:text-[16px] tw:text-neutral-400">Join the waitlist for early-bird pricing and launch-day access. No spam — just the campaign.</p>
      {% render 'tc-kickstarter-prelaunch-form' %}
      <div class="tw:mt-[22px] tw:flex tw:items-center tw:justify-center tw:gap-[10px]">
        <span class="tw:text-[13px] tw:text-neutral-500">Coming soon to</span>
        <img src="{{ 'kickstarter-logo.svg' | asset_url }}" alt="Kickstarter" width="252" height="26" class="tw:h-[16px] tw:w-auto">
      </div>
    </div>
