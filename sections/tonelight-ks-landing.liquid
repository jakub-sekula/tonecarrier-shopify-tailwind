      </div>

      {%- comment -%} campaign video placeholder {%- endcomment -%}
      <div class="tw:mx-auto tw:mt-[48px] tw:max-w-[960px] tw:md:mt-[64px]">
        <div class="tw:flex tw:aspect-[16/9] tw:w-full tw:items-center tw:justify-center tw:rounded-[2px] tw:border tw:border-white/10 tw:bg-neutral-900 tw:text-[13px] tw:text-neutral-600 tw:shadow-[0_30px_80px_-30px_rgba(0,0,0,0.8)]">
