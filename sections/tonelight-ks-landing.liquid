          <div class="ks-countdown__unit"><span class="ks-countdown__num" data-cd="mins">--</span><span class="ks-countdown__label">min</span></div>
          <div class="ks-countdown__sep">:</div>
          <div class="ks-countdown__unit"><span class="ks-countdown__num" data-cd="secs">--</span><span class="ks-countdown__label">sec</span></div>
        </div>

        <div class="tw:mt-[4px] tw:flex tw:flex-wrap tw:items-center tw:justify-center tw:gap-[12px]">
