{{ 'component-tc-pf.css' | asset_url | stylesheet_tag }}

<section class="tc-pf tc-pf-guides">
  <div class="tc-pf__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="tc-pf-grid__head">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <div class="tc-pf-guides__grid">
      {%- for block in section.blocks -%}
        {%- assign tag = 'div' -%}
        {%- if block.settings.link != blank -%}{%- assign tag = 'a' -%}{%- endif -%}
        <{{ tag }}
          class="tc-pf-guide{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {% if tag == 'a' %}href="{{ block.settings.link }}"{% endif %}
          {% if settings.animations_reveal_on_scroll %}data-cascade style="--animation-order: {{ forloop.index }};"{% endif %}
          {{ block.shopify_attributes }}
        >
          <span class="tc-pf-guide__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'book' -%}
                <svg fill="none" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25"/></svg>
              {%- when 'printer' -%}
                <svg fill="none" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0 1 10.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0 .229 2.523a1.125 1.125 0 0 1-1.12 1.227H7.231c-.662 0-1.18-.568-1.12-1.227L6.34 18m11.318 0h1.091A2.25 2.25 0 0 0 21 15.75V9.456c0-1.081-.768-2.015-1.837-2.175a48.055 48.055 0 0 0-1.913-.247M6.34 18H5.25A2.25 2.25 0 0 1 3 15.75V9.456c0-1.081.768-2.015 1.837-2.175a48.041 48.041 0 0 1 1.913-.247m10.5 0a48.536 48.536 0 0 0-10.5 0m10.5 0V3.375c0-.621-.504-1.125-1.125-1.125h-8.25c-.621 0-1.125.504-1.125 1.125v3.659M18 10.5h.008v.008H18V10.5Z"/></svg>
              {%- when 'tools' -%}
                <svg fill="none" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085"/></svg>
              {%- when 'chat' -%}
                <svg fill="none" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.76c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.076-4.076a1.526 1.526 0 0 1 1.037-.443 48.282 48.282 0 0 0 5.68-.494c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z"/></svg>
            {%- endcase -%}
          </span>
          <span>
            <h3 class="tc-pf-guide__title">{{ block.settings.title | escape }}</h3>
            <p class="tc-pf-guide__caption">{{ block.settings.caption | escape }}</p>
          </span>
        </{{ tag }}>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PF: guide tiles",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading (optional)", "default": "Manuals & guides" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "book", "label": "Book" },
            { "value": "printer", "label": "Printer" },
            { "value": "tools", "label": "Tools" },
            { "value": "chat", "label": "Chat" }
          ],
          "default": "book"
        },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [{ "name": "PF: guide tiles" }]
}
{% endschema %}
