{%- comment -%}
  Capture-to-export story. Media swaps as the copy scrolls past a pinned frame.

  Block-driven: one block per step, so the copy and media are edited in the theme editor rather
  than here. The scroll controller in tonescan-scripts.liquid already keys everything off data-i
  and reads the counts off the DOM, so any number of steps works without touching it.

  Each step's media can be a still or a moving image. A .mp4 or .webm URL renders as a muted
  looping video; a .gif renders as an image, as does the picked poster. The poster also stands in
  on mobile, where the pinned media column is hidden and each step shows its own image above the
  text.
{%- endcomment -%}

<div class="tonescan-landing tw:text-neutral-200">
  {%- assign ts_cdn = 'https://cdn.shopify.com/s/files/1/0634/3199/9736/files' -%}

  <section id="how-it-works" class="ts-story-sec tw:scroll-mt-[84px] tw:border-y tw:border-white/10">
    <div class="ts-story-sec__blobs" aria-hidden="true">
      <span class="ts-story-blob ts-story-blob--1"></span>
      <span class="ts-story-blob ts-story-blob--2"></span>
      <span class="ts-story-blob ts-story-blob--3"></span>
    </div>

    <div class="tw:relative tw:z-[1]">
      <div class="tw:mx-auto tw:w-full tw:max-w-[1400px] tw:px-[15px] tw:pt-[80px] tw:md:px-[50px] tw:md:pt-[120px]">
        <div class="tw:mx-auto tw:max-w-[720px] tw:text-center">
          {%- if section.settings.eyebrow != blank -%}
          <p class="tw:mb-[16px] tw:text-[13px] tw:font-semibold tw:uppercase tw:tracking-[0.16em] tw:text-[#60a5fa]">{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          <h2 class="tw:text-[32px] tw:font-semibold tw:leading-[1.1] tw:tracking-[-0.02em] tw:text-white tw:md:text-[46px]">{{ section.settings.heading }}</h2>
        </div>
      </div>

      <div class="ts-story">
        {%- comment -%} progress rail, shows how far through you are, and jumps on click {%- endcomment -%}
        <div class="ts-story__rail">
          <div class="ts-story__dots">
            {%- for block in section.blocks -%}
            <button type="button" class="ts-story__dot{% if forloop.first %} is-active{% endif %}" data-i="{{ forloop.index0 }}" aria-label="Go to: {{ block.settings.title | escape }}"></button>
            {%- endfor -%}
          </div>
        </div>

        {%- comment -%} MIDDLE: the panels that scroll. Each one activates the matching media.
           --shot is the mobile poster, drawn by the panel's ::before. {%- endcomment -%}
        <div class="ts-story__textcol">
          {%- for block in section.blocks -%}
            {%- assign b = block.settings -%}
            {%- if b.image != blank -%}{%- assign poster = b.image | image_url: width: 2400 -%}
            {%- elsif b.image_url != blank -%}{%- assign poster = b.image_url -%}
            {%- else -%}{%- assign poster = ts_cdn | append: '/organise.png' -%}{%- endif -%}
          <div class="ts-story__panel" data-i="{{ forloop.index0 }}" style="--shot:url('{{ poster }}')" {{ block.shopify_attributes }}>
            <div class="ts-story__panelinner">
              <h3 class="ts-story__title">{{ b.title }}</h3>
              <div class="ts-story__body">{{ b.body }}</div>
            </div>
          </div>
          {%- endfor -%}
        </div>

        {%- comment -%} RIGHT: pinned, oversized media. Crossfades as the panels pass. A video or gif
           lives inside the shot as a real element; a still is the same picture as the poster. {%- endcomment -%}
        <div class="ts-story__mediacol" aria-hidden="true">
          <div class="ts-story__sticky">
            <div class="ts-story__stage">
              {%- for block in section.blocks -%}
                {%- assign b = block.settings -%}
                {%- if b.image != blank -%}{%- assign still = b.image | image_url: width: 2400 -%}
                {%- elsif b.image_url != blank -%}{%- assign still = b.image_url -%}
                {%- else -%}{%- assign still = ts_cdn | append: '/organise.png' -%}{%- endif -%}
              <div class="ts-story__shot{% if forloop.first %} is-active{% endif %}" data-i="{{ forloop.index0 }}">
                {%- if b.video_url contains '.mp4' or b.video_url contains '.webm' -%}
                <video class="ts-story__media" autoplay muted loop playsinline preload="metadata" poster="{{ still }}">
                  <source src="{{ b.video_url }}" type="video/{% if b.video_url contains '.webm' %}webm{% else %}mp4{% endif %}">
                </video>
                {%- elsif b.video_url != blank -%}
                {%- comment -%} a gif or other still frame served from a URL {%- endcomment -%}
                <img class="ts-story__media" src="{{ b.video_url }}" alt="" loading="lazy">
                {%- else -%}
                <img class="ts-story__media" src="{{ still }}" alt="" loading="lazy">
                {%- endif -%}
              </div>
              {%- endfor -%}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "toneScan workflow",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "Leave blank for none." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From capture to export" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Step" },
        { "type": "richtext", "id": "body", "label": "Body" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Shown as the still, and as the poster on mobile and behind a video." },
        { "type": "text", "id": "image_url", "label": "Image URL", "info": "Used only when no image is picked." },
        { "type": "text", "id": "video_url", "label": "Video or GIF URL", "info": "Optional. An .mp4 or .webm plays muted and looping; a .gif or other URL shows as an image. Falls back to the still above." }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "toneScan workflow",
      "blocks": [
        { "type": "step", "settings": { "title": "A roll in minutes", "body": "<p>Point toneScan Studio at your capture folder and the whole roll appears, triplets already merged and frames already inverted.</p><p>You're looking at finished pictures before you've touched a single slider.</p>" } },
        { "type": "step", "settings": { "title": "Right colour, first try", "body": "<p>The inversion is built on how film and paper actually behave, so the first thing you see is already close.</p><p>No profile hunting, no per-frame guesswork, and no fighting an orange cast for twenty minutes.</p>" } },
        { "type": "step", "settings": { "title": "Instant feedback", "body": "<p>Move a slider and the frame moves with it. No lag, no stand-in preview, no waiting to find out what an adjustment really did.</p><p>And what you settle on is what you get: the exported file matches the one you approved on screen.</p>" } },
        { "type": "step", "settings": { "title": "One frame, whole roll", "body": "<p>Push your settings across every frame, then send the lot out in one go.</p><p>TIFF or JPG, your sizing, your filenames, with film stock and camera details already attached.</p>" } }
      ]
    }
  ]
}
{% endschema %}
