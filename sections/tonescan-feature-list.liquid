{%- comment -%}
  The secondary feature list: everything that is not a headline bento tile, behind tabs.

  Its own section rather than a tail on the bento, so the two can be reordered or removed
  independently. The .ts-more__acc driver is page-wide and null-guarded, so it picks this up
  wherever it lands.
{%- endcomment -%}

<div class="tonescan-landing tw:text-neutral-200">
  <section class="tw:mx-auto tw:w-full tw:max-w-[1400px] tw:px-[15px] tw:pb-[80px] tw:md:px-[50px] tw:md:pb-[120px]">
  {%- comment -%}
    SECONDARY features, everything that is NOT one of the headline tiles above.
    Shown ONE GROUP AT A TIME behind tabs: as a single flat grid this ran to ~30 items and
    read as a wall. Panels are stacked in one grid cell and crossfaded, same pattern as the
    hero selector, so the block height doesn't jump between tabs.
  {%- endcomment -%}
  <div class="ts-more tw:mt-[64px] tw:md:mt-[88px]">
    <h3 class="tw:mb-[28px] tw:text-center tw:text-[20px] tw:font-semibold tw:text-white">{{ section.settings.heading }}</h3>

    {%- comment -%} Icons stay in code: they are a fixed set chosen per group, not content, and a
       picker for six inline SVGs would be worse than a select. {%- endcomment -%}
    {%- capture ts_icons -%}{"icon0": "<svg viewBox=\"0 0 24 24\"><path d=\"M3 7h3.5l1.5-2h8l1.5 2H21v12H3z\"/><circle cx=\"12\" cy=\"12.5\" r=\"3.6\"/></svg>", "icon1": "<svg viewBox=\"0 0 24 24\"><path d=\"M3 6.5A1.5 1.5 0 0 1 4.5 5H9l2 2.5h8.5A1.5 1.5 0 0 1 21 9v9.5A1.5 1.5 0 0 1 19.5 20h-15A1.5 1.5 0 0 1 3 18.5z\"/></svg>", "icon2": "<svg viewBox=\"0 0 24 24\"><path d=\"M4 7h9M17 7h3M4 12h3M11 12h9M4 17h9M17 17h3\"/><circle cx=\"15\" cy=\"7\" r=\"2\"/><circle cx=\"9\" cy=\"12\" r=\"2\"/><circle cx=\"15\" cy=\"17\" r=\"2\"/></svg>", "icon3": "<svg viewBox=\"0 0 24 24\"><path d=\"M12 3v11M8 10.5l4 4 4-4\"/><path d=\"M4 16v3.5h16V16\"/></svg>", "icon4": "<svg viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"1\"/><path d=\"M3 9h18M6.5 6.5h.01M9 6.5h.01\"/></svg>"}{%- endcapture -%}
    {%- assign ts_icon_map = ts_icons -%}

    <div class="ts-more__acc">
      {%- for block in section.blocks -%}
      <div class="ts-more__item{% if forloop.first %} is-open{% endif %}" data-i="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
        <button type="button" class="ts-more__trigger" aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}">
          <span class="ts-more__cat">
            <span class="ts-more__ico" aria-hidden="true">{% render 'tonescan-more-icon', key: block.settings.icon %}</span>{{ block.settings.title }}
          </span>
          <span class="ts-more__icon" aria-hidden="true">+</span>
        </button>
        <div class="ts-more__panel">
          <div class="ts-more__panelinner">
            <ul class="ts-morelist">
              {%- assign lines = block.settings.items | strip | split: '
' -%}
              {%- for line in lines -%}
                {%- assign t = line | strip -%}
                {%- if t != blank -%}<li>{{ t }}</li>{%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        </div>
      </div>
      {%- endfor -%}
    </div>
  </div>
  </section>
</div>

{% schema %}
{
  "name": "toneScan feature list",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Plus everything a serious workflow needs"
    }
  ],
  "presets": [
    {
      "name": "toneScan feature list"
    }
  ],
  "max_blocks": 8,
  "blocks": [
    {
      "type": "group",
      "name": "Feature group",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Group name",
          "default": "Group"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "icon0",
          "options": [
            {
              "value": "icon0",
              "label": "Camera"
            },
            {
              "value": "icon1",
              "label": "Folders"
            },
            {
              "value": "icon2",
              "label": "Sliders"
            },
            {
              "value": "icon3",
              "label": "Export"
            },
            {
              "value": "icon4",
              "label": "Platform"
            }
          ]
        },
        {
          "type": "textarea",
          "id": "items",
          "label": "Items",
          "info": "One per line. <b>bold</b> works for the lead-in phrase."
        }
      ]
    }
  ]
}
{% endschema %}
