{%- comment -%}
  The secondary feature list: everything that is not a headline bento tile, behind tabs.

  Its own section rather than a tail on the bento, so the two can be reordered or removed
  independently. The .ts-more__acc driver is page-wide and null-guarded, so it picks this up
  wherever it lands.
{%- endcomment -%}

<div class="tonescan-landing tw:text-neutral-200">
  <section class="tw:mx-auto tw:w-full tw:max-w-[1400px] tw:px-[15px] tw:pb-[80px] tw:md:px-[50px] tw:md:pb-[120px]">
  {%- comment -%}
    SECONDARY features, everything that is NOT one of the headline tiles above.
    Shown ONE GROUP AT A TIME behind tabs: as a single flat grid this ran to ~30 items and
    read as a wall. Panels are stacked in one grid cell and crossfaded, same pattern as the
    hero selector, so the block height doesn't jump between tabs.
  {%- endcomment -%}
  <div class="ts-more tw:mt-[64px] tw:md:mt-[88px]">
    {%- comment -%} Same head treatment as every other section: centred, h2 at the shared size,
       optional subtitle under it. {%- endcomment -%}
    <div class="ts-more-head tw:mx-auto tw:mb-[48px] tw:max-w-[760px] tw:text-center">
      <h2 class="tw:text-[32px] tw:font-semibold tw:leading-[1.1] tw:tracking-[-0.02em] tw:text-white tw:md:text-[46px]">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
      <p class="tw:mx-auto tw:mt-[18px] tw:max-w-[720px] tw:text-[17px] tw:leading-[1.6] tw:text-neutral-400">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>


    <div class="ts-more__acc">
      {%- for block in section.blocks -%}
      <div class="ts-more__item{% if forloop.first %} is-open{% endif %}" data-i="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
        <button type="button" class="ts-more__trigger" aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}">
          <span class="ts-more__cat">
            <span class="ts-more__ico" aria-hidden="true">{% render 'tonescan-more-icon', key: block.settings.icon %}</span>{{ block.settings.title }}
          </span>
          <span class="ts-more__icon" aria-hidden="true">+</span>
        </button>
        <div class="ts-more__panel">
          {%- comment -%} The category's own image, sat behind its list and faded out toward the
             text so it reads as atmosphere rather than a picture. {%- endcomment -%}
          {%- if block.settings.image != blank -%}{%- assign bg = block.settings.image | image_url: width: 2400 -%}
          {%- else -%}{%- assign bg = block.settings.image_url -%}{%- endif -%}
          {%- if bg != blank -%}
          <span class="ts-more__bg" style="--bg:url('{{ bg }}')" aria-hidden="true"></span>
          {%- endif -%}
          <div class="ts-more__panelinner">
            <ul class="ts-morelist">
              {%- assign lines = block.settings.items | strip | split: '
' -%}
              {%- comment -%} Each line is written as "<b>Lead-in</b>: the rest". Split it so the
                 lead-in sits on its own line in white and the description drops underneath it,
                 muted. The separator the author typed (a colon or a comma) is dropped, since the
                 line break now does that job. {%- endcomment -%}
              {%- for line in lines -%}
                {%- assign t = line | strip -%}
                {%- if t != blank -%}
                  {%- assign parts = t | split: '</b>' -%}
                  {%- if parts.size > 1 -%}
                    {%- assign head = parts[0] | replace: '<b>', '' | strip -%}
                    {%- assign tail = head | slice: -1 -%}
                    {%- if tail == ':' or tail == ',' -%}{%- assign head = head | slice: 0, head.size | remove_last: tail -%}{%- endif -%}
                    {%- assign rest = parts[1] | strip -%}
                    {%- assign lead = rest | slice: 0 -%}
                    {%- if lead == ':' or lead == ',' -%}{%- assign rest = rest | remove_first: lead | strip -%}{%- endif -%}
                    <li><span class="ts-morelist__t">{{ head }}</span>{%- if rest != blank -%}<span class="ts-morelist__d">{{ rest }}</span>{%- endif -%}</li>
                  {%- else -%}
                    <li><span class="ts-morelist__t">{{ t }}</span></li>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        </div>
      </div>
      {%- endfor -%}
    </div>
  </div>
  </section>
</div>

{% schema %}
{
  "name": "toneScan feature list",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The full feature list"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subtitle",
      "default": "Everything toneScan Studio does, grouped by where it fits in the work."
    }
  ],
  "presets": [
    {
      "name": "toneScan feature list"
    }
  ],
  "max_blocks": 8,
  "blocks": [
    {
      "type": "group",
      "name": "Feature group",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Group name",
          "default": "Group"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "icon0",
          "options": [
            {
              "value": "icon0",
              "label": "Camera"
            },
            {
              "value": "icon1",
              "label": "Folders"
            },
            {
              "value": "icon2",
              "label": "Sliders"
            },
            {
              "value": "icon3",
              "label": "Export"
            },
            {
              "value": "icon4",
              "label": "Platform"
            }
          ]
        },
        {
          "type": "textarea",
          "id": "items",
          "label": "Items",
          "info": "One per line. <b>bold</b> works for the lead-in phrase."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image",
          "info": "Sits behind this category's list, faded. Placeholder screenshots for now."
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Or an image URL"
        }
      ]
    }
  ]
}
{% endschema %}
