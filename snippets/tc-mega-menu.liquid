{% comment %}
  tc-mega-menu — desktop navigation with a shared-shell megamenu.

  Blocks are grouped by ORDER: a panel block (panel_cards / panel_feature /
  panel_links) or a menu_link starts a top-level nav item; child blocks
  (card_group / card / slide / link_item) belong to the most recent panel
  block above them. Hide a panel's children together with the panel.

  Accessibility: APG disclosure navigation — triggers are <button>s with
  aria-expanded/aria-controls; inactive panes are hidden + inert (managed
  by tc-mega-menu.js); Esc closes and refocuses the trigger.
{% endcomment %}

{%- assign tc_starters = '|panel_cards|panel_feature|panel_links|menu_link|@app|' -%}

{%- capture tc_caret -%}
  <svg class="tc-mega__caret" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/></svg>
{%- endcapture -%}
{%- capture tc_tick -%}
  <svg fill="none" stroke-width="2.4" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg>
{%- endcapture -%}
{%- capture tc_dl_icon -%}
  <svg fill="none" stroke-width="2.4" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
{%- endcapture -%}

<tc-mega-menu class="header__inline-menu tc-mega">
  <nav class="tc-mega__hover-nav" aria-label="Main menu">
    <ul class="tc-mega__nav" role="list">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu_link' -%}
            <li class="tc-mega__item" {{ block.shopify_attributes }}>
              <a class="tc-mega__link" href="{{ block.settings.link | default: '#' }}">
                {{ block.settings.label | escape }}
                {%- if block.settings.badge != blank -%}
                  <span class="tc-mega__badge">{{ block.settings.badge | escape }}</span>
                {%- endif -%}
              </a>
            </li>
          {%- when 'panel_cards', 'panel_feature', 'panel_links' -%}
            <li class="tc-mega__item" {{ block.shopify_attributes }}>
              <button
                type="button"
                class="tc-mega__link"
                data-tc-trigger="{{ block.id }}"
                aria-expanded="false"
                aria-controls="TcPane-{{ block.id }}"
              >
                {{ block.settings.label | escape }}
                {%- if block.settings.badge != blank -%}
                  <span class="tc-mega__badge">{{ block.settings.badge | escape }}</span>
                {%- endif -%}
                {{ tc_caret }}
              </button>
            </li>
        {%- endcase -%}
      {%- endfor -%}
    </ul>
  </nav>

  <div class="tc-mega__shell" data-tc-shell>
    {%- for block in section.blocks -%}
      {%- assign tc_children_offset = forloop.index -%}

      {%- case block.type -%}
        {%- when 'panel_cards' -%}
          <div class="tc-mega__pane" id="TcPane-{{ block.id }}" role="region" aria-label="{{ block.settings.label | escape }}" hidden inert>
            <div class="tc-mega__inner">
              {%- if block.settings.lead != blank or block.settings.lead_sub != blank -%}
                <div class="tc-mega__lead-row">
                  <div>
                    {%- if block.settings.lead != blank -%}
                      <p class="tc-mega__lead">{{ block.settings.lead | escape }}</p>
                    {%- endif -%}
                    {%- if block.settings.lead_sub != blank -%}
                      <p class="tc-mega__lead tc-mega__lead--sub">{{ block.settings.lead_sub | escape }}</p>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
              <div class="tc-card-groups">
                {%- liquid
                  # leading cards (before any card_group) form an anonymous full-width group
                  assign tc_leading = 0
                  for child in section.blocks offset: tc_children_offset
                    assign tc_probe = '|' | append: child.type | append: '|'
                    if tc_starters contains tc_probe or child.type == 'card_group'
                      break
                    endif
                    if child.type == 'card'
                      assign tc_leading = tc_leading | plus: 1
                    endif
                  endfor
                -%}
                {%- if tc_leading > 0 -%}
                  <div class="tc-group" style="flex-grow: {{ tc_leading }};">
                    <div class="tc-group__grid" style="grid-template-columns: repeat({{ tc_leading }}, 1fr);">
                      {%- for child in section.blocks offset: tc_children_offset -%}
                        {%- assign tc_probe = '|' | append: child.type | append: '|' -%}
                        {%- if tc_starters contains tc_probe or child.type == 'card_group' -%}{%- break -%}{%- endif -%}
                        {%- if child.type == 'card' -%}
                          {%- render 'tc-mega-card', block: child, dl_icon: tc_dl_icon -%}
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  </div>
                {%- endif -%}
                {%- for child in section.blocks offset: tc_children_offset -%}
                  {%- assign tc_probe = '|' | append: child.type | append: '|' -%}
                  {%- if tc_starters contains tc_probe -%}{%- break -%}{%- endif -%}
                  {%- if child.type == 'card_group' -%}
                    {%- assign tc_group_offset = tc_children_offset | plus: forloop.index -%}
                    {%- assign tc_span = child.settings.span | default: 1 -%}
                    <div class="tc-group" style="flex-grow: {{ tc_span }};" {{ child.shopify_attributes }}>
                      <p class="tc-group__head">{{ child.settings.heading | escape }}</p>
                      <div class="tc-group__grid" style="grid-template-columns: repeat({{ tc_span }}, 1fr);">
                        {%- for gchild in section.blocks offset: tc_group_offset -%}
                          {%- assign tc_gprobe = '|' | append: gchild.type | append: '|' -%}
                          {%- if tc_starters contains tc_gprobe or gchild.type == 'card_group' -%}{%- break -%}{%- endif -%}
                          {%- if gchild.type == 'card' -%}
                            {%- render 'tc-mega-card', block: gchild, dl_icon: tc_dl_icon -%}
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          </div>

        {%- when 'panel_feature' -%}
          <div class="tc-mega__pane tc-mega__pane--feature" id="TcPane-{{ block.id }}" role="region" aria-label="{{ block.settings.label | escape }}" hidden inert>
            <div class="tc-mega__inner">
              <div class="tc-soft">
                <div class="tc-soft__copy">
                  <p class="tc-soft__title">
                    {{ block.settings.title | escape }}
                    {%- if block.settings.title_badge != blank -%}
                      <span class="tc-beta">{{ block.settings.title_badge | escape }}</span>
                    {%- endif -%}
                  </p>
                  {%- if block.settings.description != blank -%}
                    <p class="tc-soft__desc">{{ block.settings.description | escape }}</p>
                  {%- endif -%}
                  <ul class="tc-soft__feats" role="list">
                    {%- for i in (1..5) -%}
                      {%- assign tc_bullet_key = 'bullet_' | append: i -%}
                      {%- assign tc_bullet = block.settings[tc_bullet_key] -%}
                      {%- if tc_bullet != blank -%}
                        <li>{{ tc_tick }}{{ tc_bullet | escape }}</li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                  {%- if block.settings.cta_label != blank -%}
                    <a class="tc-soft__cta" href="{{ block.settings.cta_link | default: '#' }}">{{ block.settings.cta_label | escape }}</a>
                  {%- endif -%}
                </div>
                <tc-slider class="tc-soft__carousel" data-autoplay="4000" role="region" aria-roledescription="carousel" aria-label="{{ block.settings.title | escape }} screenshots">
                  <div class="tc-soft__shot" data-tc-viewport>
                    <div class="tc-soft__track" data-tc-track>
                      {%- for child in section.blocks offset: tc_children_offset -%}
                        {%- assign tc_probe = '|' | append: child.type | append: '|' -%}
                        {%- if tc_starters contains tc_probe -%}{%- break -%}{%- endif -%}
                        {%- if child.type == 'slide' -%}
                          {%- if child.settings.image -%}
                            <img
                              src="{{ child.settings.image | image_url: width: 1200 }}"
                              srcset="{{ child.settings.image | image_url: width: 600 }} 600w, {{ child.settings.image | image_url: width: 900 }} 900w, {{ child.settings.image | image_url: width: 1200 }} 1200w"
                              sizes="(min-width: 990px) 640px, 100vw"
                              width="{{ child.settings.image.width }}"
                              height="{{ child.settings.image.height }}"
                              loading="lazy"
                              alt="{{ child.settings.caption | escape }}"
                              data-caption="{{ child.settings.caption | escape }}"
                              {{ child.shopify_attributes }}
                            >
                          {%- else -%}
                            <img src="{{ 'tonescan-hero.png' | asset_url }}" width="3792" height="2272" loading="lazy" alt="{{ child.settings.caption | escape }}" data-caption="{{ child.settings.caption | escape }}" {{ child.shopify_attributes }}>
                          {%- endif -%}
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                    <button type="button" class="tc-soft__arrow tc-soft__arrow--prev" data-tc-prev aria-label="Previous screenshot">&#8249;</button>
                    <button type="button" class="tc-soft__arrow tc-soft__arrow--next" data-tc-next aria-label="Next screenshot">&#8250;</button>
                  </div>
                  <p class="tc-soft__caption" data-tc-caption aria-live="polite"></p>
                  <div class="tc-soft__dots" data-tc-dots></div>
                </tc-slider>
              </div>
            </div>
          </div>

        {%- when 'panel_links' -%}
          <div class="tc-mega__pane" id="TcPane-{{ block.id }}" role="region" aria-label="{{ block.settings.label | escape }}" hidden inert>
            <div class="tc-mega__inner">
              <div class="tc-guides">
                <div class="tc-guide-list">
                  {%- for child in section.blocks offset: tc_children_offset -%}
                    {%- assign tc_probe = '|' | append: child.type | append: '|' -%}
                    {%- if tc_starters contains tc_probe -%}{%- break -%}{%- endif -%}
                    {%- if child.type == 'link_item' -%}
                      <a class="tc-guide" href="{{ child.settings.link | default: '#' }}" {{ child.shopify_attributes }}>
                        <span class="tc-guide__icon" aria-hidden="true">
                          {%- case child.settings.icon -%}
                            {%- when 'book' -%}
                              <svg fill="none" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25"/></svg>
                            {%- when 'play' -%}
                              <svg fill="none" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.347a1.125 1.125 0 0 1 0 1.972l-11.54 6.347a1.125 1.125 0 0 1-1.667-.986V5.653Z"/></svg>
                            {%- when 'camera' -%}
                              <svg fill="none" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 0 1 5.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 0 0-1.134-.175 2.31 2.31 0 0 1-1.64-1.055l-.822-1.316a2.192 2.192 0 0 0-1.736-1.039 48.774 48.774 0 0 0-5.232 0 2.192 2.192 0 0 0-1.736 1.039l-.821 1.316Z M16.5 12.75a4.5 4.5 0 1 1-9 0 4.5 4.5 0 0 1 9 0Z"/></svg>
                            {%- when 'tools' -%}
                              <svg fill="none" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085"/></svg>
                          {%- endcase -%}
                        </span>
                        <span>
                          <span class="tc-guide__title">{{ child.settings.title | escape }}</span>
                          <p class="tc-guide__caption">{{ child.settings.caption | escape }}</p>
                        </span>
                      </a>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
            </div>
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</tc-mega-menu>
