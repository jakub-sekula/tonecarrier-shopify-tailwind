      // lock the line above before changing it, so the key box cannot jump under the reader
      // The two reserved lines come from CSS now; an inline lock would pin this to whatever the
      // previous state happened to measure.
      intro.innerHTML = 'Thank you for your purchase. Here is your licence key:';
