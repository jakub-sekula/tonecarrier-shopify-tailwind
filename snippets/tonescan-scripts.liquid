{%- comment -%}
  Extracted from sections/tonescan-landing.liquid: that file hit Shopify's 256 KB
  template limit. Rendered with {%% render %%}, which isolates scope, so anything this
  needs from the section has to be passed in explicitly.
{%- endcomment -%}
<script>
  (function () {
    document.querySelectorAll('.tonescan-landing .ts-ba').forEach(function (el) {
      var range = el.querySelector('.ts-ba__range');
      if (!range) return;
      var update = function () { el.style.setProperty('--pos', range.value + '%'); };
      range.addEventListener('input', update);
      update();
    });
  })();

  /* scan gallery, PhotoSwipe (pinch / wheel / double-click zoom, keyboard, swipe).
     Tiles are opened programmatically from a JSON dataSource rather than by scanning the DOM:
     each marquee row renders its frames twice for a seamless loop and rows can share a frame,
     so a DOM-driven gallery would show the same picture five or six times in a row. */
  (function () {
    var gallery = document.querySelector('.tonescan-landing .ts-gallery');
    var dataEl = document.querySelector('.tonescan-landing .ts-gallery-data');
    if (!gallery || !dataEl) return;

    var slides;
    try { slides = JSON.parse(dataEl.textContent); } catch (e) { return; }
    if (!slides || !slides.length) return;

    function start() {
      if (typeof PhotoSwipeLightbox === 'undefined' || typeof PhotoSwipe === 'undefined') return;
      var lightbox = new PhotoSwipeLightbox({
        dataSource: slides,
        pswpModule: PhotoSwipe,
        loop: true,
        zoom: true,
        wheelToZoom: true,
        showHideAnimationType: 'fade',
        bgOpacity: 0.96,
        padding: { top: 24, bottom: 24, left: 24, right: 24 }
      });

      // caption slot, stays empty (and hidden) until the capture details are filled in
      lightbox.on('uiRegister', function () {
        lightbox.pswp.ui.registerElement({
          name: 'ts-caption', order: 9, isButton: false, appendTo: 'root',
          html: '', className: 'pswp__caption',
          onInit: function (el, pswp) {
            pswp.on('change', function () {
              el.textContent = (pswp.currSlide && pswp.currSlide.data.caption) || '';
            });
          }
        });
      });

      lightbox.init();

      gallery.addEventListener('click', function (e) {
        var tile = e.target.closest('.ts-scan');
        if (!tile) return;
        e.preventDefault();
        lightbox.loadAndOpen(parseInt(tile.getAttribute('data-scan-index'), 10) || 0);
      });
    }

    // the PhotoSwipe tags are deferred, so wait for them if we got here first
    if (document.readyState === 'complete') start();
    else window.addEventListener('load', start);
  })();

  /* rgb merge, scroll-linked.
     Progress is measured against the SNAP POSITION rather than against .ts-rgb being centred
     in the viewport. Centring the image put the section heading off the top of the screen at
     the moment the merge completed, and it started the animation as soon as the section
     appeared. Anchoring to "head sits HEAD_TOP below the viewport top" means the snap target
     and the fully merged state are the same scroll position by construction, the title and
     subtitle are still on screen when it lands, and the channels only begin to appear over
     the final APPROACH pixels. */
  (function () {
    var els = document.querySelectorAll('.tonescan-landing .ts-rgb');
    if (!els.length) return;
    var clamp = function (v) { return v < 0 ? 0 : (v > 1 ? 1 : v); };

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      els.forEach(function (el) { el.style.setProperty('--s', 0); el.classList.add('is-converted'); });
      return;
    }

    var HEAD_TOP = 0;        // anchor is the pinned region: top at 0 centres the photo, --t still 0
    var APPROACH = 0.72;     // fraction of a viewport the merge plays out over

    var items = [];
    els.forEach(function (el) {
      var sec = el.closest('.ts-hdive');
      items.push({ el: el, head: sec ? sec.querySelector('.ts-hdive__pin') : null });
    });

    // scroll position at which this item is considered "snapped"
    function targetFor(it) {
      var ref = it.head || it.el;
      return window.pageYOffset + ref.getBoundingClientRect().top - HEAD_TOP;
    }

    // FIRST PASS PLAYS ITSELF.
    // Scrub the merge purely from scroll and anyone moving quickly never sees it. The first
    // time the section comes into view it runs on its own clock instead, so the effect always
    // lands. After that it is scroll-linked again, so scrubbing back and forth still works.
    // (Deliberately not capturing the wheel to force the pace: hijacking scroll to hold
    // someone in place reads as the page being broken. Say the word if you want that instead.)
    var PLAY_MS = 1700;
    var played = false, playRaf = null;
    function playOnce() {
      if (played || playRaf) return;
      var t0 = performance.now();
      (function step(now) {
        var t = Math.min(1, (now - t0) / PLAY_MS);
        var e = 1 - Math.pow(1 - t, 3);            // ease out
        items.forEach(function (it) {
          it.el.style.setProperty('--s', (1 - e).toFixed(3));
          it.el.classList.toggle('is-converted', t >= 1);
        });
        if (t < 1) { playRaf = requestAnimationFrame(step); }
        else {
          playRaf = null; played = true;
          // explicit "the timed run finished" marker. is-converted is not enough: the
          // scroll-linked path sets that too, before the animation has actually played.
          items.forEach(function (it) { it.el.classList.add('is-played'); });
        }
      })(t0);
    }
    if ('IntersectionObserver' in window) {
      var playIO = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) { if (en.isIntersecting) { playOnce(); playIO.disconnect(); } });
      }, { rootMargin: '-45% 0px -45% 0px', threshold: 0 });
      items.forEach(function (it) { playIO.observe(it.el); });
    } else {
      played = true;
      items.forEach(function (it) { it.el.classList.add('is-played'); });
    }

    function update() {
      if (playRaf) return;                          // the timed run owns --s while it plays
      var vh = window.innerHeight || document.documentElement.clientHeight;
      var travel = vh * APPROACH;
      items.forEach(function (it) {
        var target = targetFor(it);
        // 0 while still a full approach away, 1 once we are at the snap position
        var q = clamp(1 - (target - window.pageYOffset) / travel);
        it.el.style.setProperty('--s', (1 - Math.pow(q, 3)).toFixed(3));
        it.el.classList.toggle('is-converted', q >= 0.985);   // the glide lands a hair short of 1
      });
    }

    // ---- snap, matching the story section's easing ----
    var snapRaf = null, suppressSnapUntil = 0;
    var lastDir = 1, lastY = window.pageYOffset;
    function easeInOutCubic(t) { return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2; }
    function cancelSnap() {
      if (snapRaf) { cancelAnimationFrame(snapRaf); snapRaf = null; }
      suppressSnapUntil = 0;
    }
    ['wheel', 'touchstart', 'keydown', 'pointerdown'].forEach(function (evt) {
      window.addEventListener(evt, cancelSnap, { passive: true });
    });
    function glideTo(targetY, duration) {
      cancelSnap();
      var startY = window.pageYOffset, delta = targetY - startY;
      if (Math.abs(delta) < 2) return;
      var t0 = performance.now();
      suppressSnapUntil = Date.now() + duration + 250;
      (function step(now) {
        var t = Math.min(1, (now - t0) / duration);
        var y = startY + delta * easeInOutCubic(t);
        try { window.scrollTo({ top: y, behavior: 'instant' }); }
        catch (err) { window.scrollTo(0, y); }
        snapRaf = t < 1 ? requestAnimationFrame(step) : null;
      })(t0);
    }

    function maybeSnap() {
      if (Date.now() < suppressSnapUntil) return;
      if (lastDir !== 1) return;                  // only ever pulls forward, never back up
      var vh = window.innerHeight || document.documentElement.clientHeight;
      var y = window.pageYOffset;
      var best = null, bestGap = Infinity;
      items.forEach(function (it) {
        var target = targetFor(it);
        var gap = target - y;                     // positive means the snap point is still below
        // approaching from above only: once past it, leave the reader alone
        if (gap > 8 && gap < vh * 0.55 && gap < bestGap) { bestGap = gap; best = target; }
      });
      if (best === null) return;
      glideTo(best, Math.min(1500, 650 + bestGap * 0.6));
    }

    var ticking = false, snapTimer;
    function onScroll() {
      var y = window.pageYOffset;
      if (y !== lastY) { lastDir = y > lastY ? 1 : -1; lastY = y; }
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(function () { update(); ticking = false; });
      }
      clearTimeout(snapTimer);
      snapTimer = setTimeout(maybeSnap, 240);
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', function () { clearTimeout(snapTimer); update(); }, { passive: true });
    update();
  })();

  /* secondary feature list — one category open at a time; clicking the open one closes it */
  (function () {
    document.querySelectorAll('.tonescan-landing .ts-more__acc').forEach(function (acc) {
      var items = acc.querySelectorAll('.ts-more__item');
      if (!items.length) return;
      items.forEach(function (it, i) {
        it.querySelector('.ts-more__trigger').addEventListener('click', function () {
          var wasOpen = it.classList.contains('is-open');
          items.forEach(function (x, xi) {
            var on = xi === i && !wasOpen;
            x.classList.toggle('is-open', on);
            x.querySelector('.ts-more__trigger').setAttribute('aria-expanded', on ? 'true' : 'false');
          });
        });
      });
    });
  })();

  /* RGB pinned region. Once the merge has played, --t drives the panel left. It is eased and
     then damped towards its target every frame, so a fast flick still arrives smoothly instead
     of snapping across. The copy blocks follow it in, and from block three onwards the frame's
     contents swap for a screenshot, with the dot rail tracking whichever block is centred. */
  (function () {
    var pins = document.querySelectorAll('.tonescan-landing .ts-hdive__pin');
    if (!pins.length) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var clamp = function (v) { return v < 0 ? 0 : (v > 1 ? 1 : v); };
    var ease = function (v) { return v < 0.5 ? 4 * v * v * v : 1 - Math.pow(-2 * v + 2, 3) / 2; };

    pins.forEach(function (pin) {
      var stage = pin.querySelector('.ts-rgb__stage');
      var rgb = pin.querySelector('.ts-rgb');
      var panels = pin.querySelectorAll('.ts-hdive__panel');
      var shots = stage ? stage.querySelectorAll('[data-i]') : [];
      var dots = pin.querySelectorAll('.ts-hdive__dot');
      var cur = 0, target = 0, active = -1, running = false;
      var lastY = window.pageYOffset, snapped = false, snapping = false, abort = false, snapStart = 0;
      var isMerged = false, pinTop = 1e6, lastScrollAt = Date.now(), IDLE_MS = 4000;
      window.addEventListener('scroll', function () { if (!snapping) lastScrollAt = Date.now(); }, { passive: true });

      // once the panel is part-way left, pull the first copy block into the middle so the
      // section title lands in place instead of drifting past. Downward scroll only, once,
      // and never while the reader is flicking through at speed.
      function snapToFirst(slow) {
        var panel = panels[0];
        if (!panel) return;
        var vh = window.innerHeight || document.documentElement.clientHeight;
        var pr = panel.getBoundingClientRect();
        var from = window.pageYOffset;
        var to = from + pr.top + pr.height / 2 - midOffset();
        if (Math.abs(to - from) < 8) { snapped = true; return; }
        // 620ms was fine for a nudge but this move is most of a viewport. Scale with the
        // distance, and take it slower still when nothing prompted it but the idle timer.
        var dist = Math.abs(to - from);
        var dur = Math.min(2200, 900 + dist * 1.1);
        if (slow) dur = Math.min(3200, dur * 1.5);
        var t0 = 0;
        snapping = true; abort = false; snapStart = Date.now();
        function step(now) {
          if (!t0) t0 = now;
          if (abort) { snapping = false; return; }
          var k = Math.min(1, (now - t0) / dur);
          var e = k < 0.5 ? 4 * k * k * k : 1 - Math.pow(-2 * k + 2, 3) / 2;
          window.scrollTo({ top: from + (to - from) * e, behavior: 'instant' });
          if (k < 1) requestAnimationFrame(step); else { snapping = false; snapped = true; }
        }
        requestAnimationFrame(step);
      }
      // No wheel abort: trackpad inertia keeps firing wheel events for a second or more after
      // the gesture ends, which cancelled the snap every time. 620ms is short enough to ride out.
      function takeOver() { if (snapping) { abort = true; snapped = true; } }
      ['touchstart', 'keydown'].forEach(function (ev) {
        window.addEventListener(ev, takeOver, { passive: true });
      });

      // flip the entry/exit axis without animating the resting layers across the frame
      function setDir(up) {
        if (!stage || stage.classList.contains('is-up') === up) return;
        stage.classList.add('ts-no-anim');
        stage.classList.toggle('is-up', up);
        void stage.offsetWidth;                 // flush the new offsets before re-enabling
        stage.classList.remove('ts-no-anim');
      }

      function setActive(i) {
        if (i === active) return;
        if (stage) {
          stage.classList.add('is-rot');
          stage.classList.toggle('is-shot', i > 0);   // channels only hide behind a screenshot
        }
        setDir(i < active);                     // moving to an earlier block = scrolling up
        dots.forEach(function (d, di) { d.classList.toggle('is-active', di === i); });
        Array.prototype.forEach.call(shots, function (sh) {
          var si = parseInt(sh.getAttribute('data-i'), 10) || 0;
          if (si === i) {
            sh.classList.remove('is-leaving');
            sh.classList.add('is-active');
          } else if (sh.classList.contains('is-active')) {
            // send the outgoing layer away, then park it back on the entry side for next time
            sh.classList.remove('is-active');
            sh.classList.add('is-leaving');
            setTimeout(function () {
              if (!sh.classList.contains('is-active')) sh.classList.remove('is-leaving');
            }, 1100);
          }
        });
        active = i;
      }

      function measure() {
        var vh = window.innerHeight || document.documentElement.clientHeight;
        var r = pin.getBoundingClientRect();
        var merged = !rgb || rgb.classList.contains('is-played');
        isMerged = merged; pinTop = r.top;
        target = merged ? ease(clamp(-r.top / (vh * 0.7))) : 0;

        var y = window.pageYOffset;
        var speed = Math.abs(y - lastY);
        var down = y > lastY;
        lastY = y;
        if (!snapped && !snapping && merged && down && speed < 140 && cur >= 0.3) snapToFirst();

        if (y !== lastY) dirY = down ? 1 : -1;

        var gate = clamp((cur - 0.5) / 0.4);
        pin.classList.toggle('is-copy', gate > 0);
        var best = -1, bestD = Infinity;
        panels.forEach(function (panel, i) {
          var pr = panel.getBoundingClientRect();
          var d = Math.abs((pr.top + pr.height / 2) - vh / 2) / vh;
          if (d < bestD) { bestD = d; best = i; }
          // 0.62/0.36 so neighbours overlap at the midpoint instead of both landing on zero
          var pv = gate <= 0 ? 0 : clamp((0.62 - d) / 0.36) * gate;
          panel.style.setProperty('--pv', (pv * pv * (3 - 2 * pv)).toFixed(3));
        });
        if (gate > 0 && best >= 0 && bestD < 0.3) setActive(best);
        return r.bottom > -200 && r.top < vh + 200;
      }

      function frame() {
        var onScreen = measure();
        // 0.14 is a nice settle for browsing speed, but it lags badly behind a fast scroll,
        // which read as the section dragging. Close the gap quicker when it is wide.
        var gap = Math.abs(target - cur);
        cur += (target - cur) * (gap > 0.25 ? 0.34 : 0.14);
        if (Math.abs(target - cur) < 0.0005) cur = target;
        pin.style.setProperty('--t', cur.toFixed(4));
        if (onScreen || Math.abs(target - cur) > 0.0005) {
          requestAnimationFrame(frame);
        } else {
          running = false;
        }
      }
      function kick() { if (!running) { running = true; requestAnimationFrame(frame); } }

      // Gentle per-block snap, same idea as the workflow story: once scrolling settles, centre
      // whichever copy block is nearest, so the section can't be left parked between two.
      var blockTimer = null, suppressUntil = 0, blockRaf = null, dirY = 1;
      function centreOf(el) { var r = el.getBoundingClientRect(); return window.pageYOffset + r.top + r.height / 2; }
      // the sticky header covers the top of the viewport, so the optical middle sits below it
      function midOffset() {
        var vh = window.innerHeight || document.documentElement.clientHeight;
        var h = document.querySelector('header');
        var hh = h ? h.getBoundingClientRect().height : 0;
        return hh + (vh - hh) / 2;
      }
      function cancelBlockSnap() { if (blockRaf) { cancelAnimationFrame(blockRaf); blockRaf = null; } suppressUntil = 0; }
      function glideBlock(targetY, duration) {
        cancelBlockSnap();
        var startY = window.pageYOffset, delta = targetY - startY;
        if (Math.abs(delta) < 2) return;
        var t0 = performance.now();
        suppressUntil = Date.now() + duration + 250;
        (function step(now) {
          var k = Math.min(1, (now - t0) / duration);
          var e = k < 0.5 ? 4 * k * k * k : 1 - Math.pow(-2 * k + 2, 3) / 2;
          try { window.scrollTo({ top: startY + delta * e, behavior: 'instant' }); }
          catch (err) { window.scrollTo(0, startY + delta * e); }
          blockRaf = k < 1 ? requestAnimationFrame(step) : null;
        })(t0);
      }
      function maybeSnapBlock() {
        if (snapping || !snapped) return;            // the intro snap owns the scroll until it has run
        if (Date.now() < suppressUntil) return;
        var vh = window.innerHeight || document.documentElement.clientHeight;
        var mid = window.pageYOffset + midOffset(), bi = -1, best = Infinity;
        panels.forEach(function (pnl, pi) {
          var d = Math.abs(centreOf(pnl) - mid);
          if (d < best) { best = d; bi = pi; }
        });
        // 0.6, not 0.45: blocks are a viewport apart, so the midpoint is 0.5vh from both
        // neighbours and the old cut-off rejected precisely the state worth rescuing.
        if (bi < 0 || best < 24 || best > vh * 0.6) return;
        if (!pin.classList.contains('is-copy')) return;   // never during the merge
        // never drag the reader back against the way they were going: take the next block instead
        var target = centreOf(panels[bi]);
        if ((target - window.pageYOffset > 0 ? 1 : -1) !== dirY) {
          var alt = bi + dirY;
          if (!panels[alt]) return;
          target = centreOf(panels[alt]);
        }
        glideBlock(target - midOffset(), 1150);
      }
      // Any real input wins, and unlike the intro snap that includes the wheel: this one is a
      // gentle settle, so trackpad momentum should defer it rather than be ridden out. Same
      // 240ms idle as the workflow story, so it only engages once scrolling has actually stopped.
      ['touchstart', 'keydown', 'pointerdown', 'wheel'].forEach(function (ev) {
        window.addEventListener(ev, cancelBlockSnap, { passive: true });
      });
      window.addEventListener('scroll', function () {
        clearTimeout(blockTimer);
        blockTimer = setTimeout(maybeSnapBlock, 240);
      }, { passive: true });

      // parked on the finished merge with nothing happening: after four still seconds, move
      // the reader on to the copy rather than leaving them looking at a static photo
      setInterval(function () {
        if (snapped || snapping || !isMerged) return;
        var vh = window.innerHeight || document.documentElement.clientHeight;
        if (cur > 0.05 || Math.abs(pinTop) > vh * 0.25) return;
        if (Date.now() - lastScrollAt < IDLE_MS) return;
        snapToFirst(true);
      }, 500);

      dots.forEach(function (d, di) {
        d.addEventListener('click', function () {
          var panel = panels[di];
          if (!panel) return;
          var pr = panel.getBoundingClientRect();
          glideBlock(window.pageYOffset + pr.top + pr.height / 2 - midOffset(), 1150);
        });
      });

      window.addEventListener('scroll', kick, { passive: true });
      window.addEventListener('resize', kick, { passive: true });
      kick();
    });
  })();

  /* Conversion strip. Both layers are identical and are driven by one offset, so they stay
     locked together; the conversion is done entirely by their complementary CSS masks. Motion
     is deliberately stepped rather than continuous: settle, slide one frame, settle. */
  (function () {
    var wrap = document.querySelector('.tonescan-landing .ts-conv');
    if (!wrap) return;
    var tracks = wrap.querySelectorAll('.ts-conv__track');
    if (!tracks.length) return;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

    var SLIDE_MS = 1000, SETTLE_MS = 1500;     // 1.5s standing still, then a 1s step
    var offset = 0, lead = 0, timer = null, running = false;
    var gen = 0;                               // bumped on stop, so in-flight slides stand down
    var DRAG_SNAP_MS = 420, FLICK_MS = 170;
    var dragging = false, dragId = null, startX = 0, startOff = 0, lastX = 0, lastT = 0, vel = 0;
    var dot = null;

    function each(fn) { Array.prototype.forEach.call(tracks, fn); }
    function firstItem() { return tracks[0].querySelector('.ts-conv__item'); }
    function step() { var it = firstItem(); return it ? it.offsetWidth : 0; }   // gap is 0
    function wait(ms) { return new Promise(function (r) { timer = setTimeout(r, ms); }); }
    function apply() { each(function (t) { t.style.transform = 'translateX(' + (lead - offset) + 'px)'; }); }

    // 24 -> 23A -> 23 -> 22A ... the step below whatever its right-hand neighbour reads.
    // The roll wraps at 0, back round to 39A: counting down without a floor ran the strip
    // into negative frame numbers after enough recycles.
    function prevLabel(label) {
      var m = /^(\d+)(A?)$/.exec(label || '');
      if (!m) return label;
      if (m[2]) return m[1];
      var n = parseInt(m[1], 10) - 1;
      return (n < 0 ? 39 : n) + 'A';
    }
    function nextLabel(label) {
      var m = /^(\d+)(A?)$/.exec(label || '');
      if (!m) return label;
      if (!m[2]) return m[1] + 'A';
      var n = parseInt(m[1], 10) + 1;
      return (n > 39 ? 0 : n) + '';
    }
    function renumber(frame, neighbour, forward) {
      var ref = neighbour && neighbour.querySelector('.ts-conv__num');
      if (!ref) return;
      var txt = ref.textContent.trim();
      var next = forward ? nextLabel(txt) : prevLabel(txt);
      frame.querySelectorAll('.ts-conv__num').forEach(function (el) { el.textContent = next; });
    }

    // Wrap a frame from one end of the track to the other. Both layers must move together or
    // they drift apart, and the gate classes ride along on the element so shapes stay put.
    function recycle(dir) {
      each(function (t) {
        var items = t.querySelectorAll('.ts-conv__item');
        if (items.length < 2) return;
        if (dir > 0) {                       // travelling right: the last frame feeds in at the left
          var last = items[items.length - 1];
          t.insertBefore(last, items[0]);
          renumber(last, items[0], false);   // it is EARLIER on the roll than its new neighbour
        } else {                             // travelling left: the first frame feeds in at the right
          var first = items[0];
          t.appendChild(first);
          renumber(first, items[items.length - 1], true);
        }
      });
    }

    // Keep offset inside one pitch by wrapping whole frames instead, so a drag of any length
    // never runs the strip out of stock. Returns how far offset was shifted, because a drag in
    // progress has to move its own origin by the same amount or the next move undoes this.
    function normalise() {
      var d = step();
      if (!d) return 0;
      var shift = 0, guard = 0;
      while (offset <= -d && guard++ < 200) { recycle(1); offset += d; shift += d; }
      while (offset >= d && guard++ < 200) { recycle(-1); offset -= d; shift -= d; }
      return shift;
    }

    // ---- off-screen culling ------------------------------------------------------------------
    // The track runs ~6x wider than the viewport, but every frame off the sides still carries a
    // gate mask, an invert filter and a multiply blend for the compositor to honour. Hide the
    // ones nobody can see. Driven by a stylesheet rather than per-element classes because
    // nth-child re-evaluates itself as frames recycle, which is exactly the behaviour wanted
    // here: the index window stays put while the elements move through it.
    var cullSheet = null;
    function cull() {
      var d = step();
      if (!d) return;
      if (!cullSheet) { cullSheet = document.createElement('style'); document.head.appendChild(cullSheet); }
      var items = tracks[0].querySelectorAll('.ts-conv__item');
      var total = items.length;
      // the film base and the two rule strips sit ahead of the frames and span the whole track,
      // so their child indices have to be skipped or the cull would take them out too
      var head = 0, kids = tracks[0].children;
      while (head < kids.length && !kids[head].classList.contains('ts-conv__item')) head++;
