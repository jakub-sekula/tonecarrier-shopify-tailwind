    // So there is nothing to reveal, nothing to paste and nothing to download: showing a key here
    // would invite them to re-enter one that is already working. Because the page knows this
    // BEFORE checkout opens, it never polls, which also puts it out of reach of the reveal window.
    function showUpgraded(kind) {
      if (!done) return;
      showDone();
      done.classList.remove('is-generating');
      setHeading('done');
      stopIdle();
      var code = done.querySelector('.ts-done__key');
      code.textContent = '';
      code.hidden = true;
      // The product is named on the first line in both variants, so the second is identical and
      // says "the app".
      var upgraded = 'Your licence has been upgraded; you can go back to the app now.';
      done.querySelector('.ts-done__intro').innerHTML = kind === 'beta'
        ? 'Thank you for helping us beta test toneScan!<br>' + upgraded
        : 'Thank you for trying out toneScan!<br>' + upgraded;
      // Both of these speak to a key that was delivered. Neither happened.
      var mailed = done.querySelector('.ts-done__mailed');
      if (mailed) mailed.hidden = true;
      var acts = done.querySelector('.ts-done__actions');
      if (acts) acts.hidden = true;
    }

    function onPaid(txn, email) {
      if (isUpgrade()) return showUpgraded(offer.kind);
      showDone();
      if (email && done) done.querySelector('.ts-done__email').textContent = email;
      if (!txn || !done || !done.getAttribute('data-key-url')) {
        // nothing to poll with: the email note alone is the honest message
        if (done) giveUp(email);
        return;
      }
      var code = done.querySelector('.ts-done__key');
      code.classList.add('is-pending');
      startIdle(code);
      var ref = { done: false };
      window.__tsKeyRef = ref;
      pollForKey(txn, Date.now(), ref);
    }

    if (done) {
      done.querySelector('.ts-done__copy').addEventListener('click', function () {
        var k = done.querySelector('.ts-done__key').textContent;
        if (navigator.clipboard) navigator.clipboard.writeText(k);
      });
    }

    // ---- development state switcher --------------------------------------------------------
    // Drives the same functions a real purchase does rather than faking the markup, so styling
    // against it cannot drift from what a buyer sees. Only present when the section rendered it.
    // Shown where development happens and nowhere else. Local dev server, the theme editor, or
    // ?mockup=1 for checking the styling against the real live page.
    var mock = sec.querySelector('.ts-mock');
    var isDev = /^(127\.0\.0\.1|localhost|\[::1\])$/.test(location.hostname) ||
                /[?&]mockup=1\b/.test(location.search) ||
                !!(window.Shopify && window.Shopify.designMode);
    if (mock && isDev) mock.hidden = false;
    if (mock && done) {
      // hex, to match the alphabet the scramble settles through
      var SAMPLE_KEY = '4F2A9C-7B1E6D-3A8F05-C29B47-E1D6A3-5F';
      // The sandbox beta discount, standing in for what /upgrade-info would return. Overridable
      // with ?mockdiscount= so a changed or live id does not need an edit here. Nothing outside
      // this dev-only block reads it: the real flow takes the id from the Worker, which is what
      // keeps the offer changeable without a storefront deploy.
      var SAMPLE_DISCOUNT = (tsLocalDev && q0.get('mockdiscount')) || 'dsc_01kzkpxsqb3ezwscbavx3cf7cw';
      // Attaches a real discount id, so it is gated harder than the panel around it.
      var betaRow = mock.querySelector('[data-mock-localonly]');
      if (betaRow && tsLocalDev) betaRow.hidden = false;
      // Undefined stands in for the real no-address cases: a 410 that carries no email, the
      // give-up timeout when the lookup never returned one, and the network-error catch, which
      // calls giveUp with nothing at all. The copy then reads "your email address".
      var noEmail = mock.querySelector('[data-mock-opt="noemail"]');
      function sampleEmail() { return noEmail && noEmail.checked ? undefined : 'buyer@example.com'; }
      // Flipping the modifier re-runs whichever state is up, so the difference is visible without
      // clicking the state again.
      if (noEmail) noEmail.addEventListener('change', function () {
        var active = mock.querySelector('[data-mock].is-active');
        if (active) active.click();
      });
      mock.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-mock]');
        if (!btn) return;
        var state = btn.getAttribute('data-mock');

        // Back to a clean slate first, so states can be flipped in any order and a live poll
        // from an earlier click cannot land on top of the one being looked at.
        stopIdle();
        if (window.__tsKeyRef) window.__tsKeyRef.done = true;
        var code = done.querySelector('.ts-done__key');
        var intro = done.querySelector('.ts-done__intro');
        var copy = done.querySelector('.ts-done__copy');
        code.hidden = false;
        code.classList.add('is-pending');
        code.textContent = KEY_PLACEHOLDER;
        intro.textContent = 'Generating your licence key\u2026';
        copy.classList.remove('is-shown');
        var mailedEl = done.querySelector('.ts-done__mailed');
        if (mailedEl) mailedEl.hidden = false;
        // The upgrade states take this away; without restoring it here, every state picked after
        // one of them would come up with no download button.
        var actsEl = done.querySelector('.ts-done__actions');
        if (actsEl) actsEl.hidden = false;
        done.querySelector('.ts-done__email').textContent = 'your email address';
        Array.prototype.forEach.call(mock.querySelectorAll('[data-mock]'), function (b) {
          b.classList.toggle('is-active', b === btn);
        });

        if (errBox) errBox.hidden = true;
        if (state === 'reset') {
          done.hidden = true;
          if (main) main.classList.remove('is-paid');
          sec.classList.remove('has-purchase');
          // Full price again, or the discount would stick to every later state.
          if (applyMockOffer) applyMockOffer(null);
          return;
        }
        // The pricing cards as a beta tester arriving from the app sees them. Not a confirmation
        // state: it is the same cards view as reset, with the offer applied over it.
        if (state === 'beta-price') {
          done.hidden = true;
          if (main) main.classList.remove('is-paid');
          sec.classList.remove('has-purchase');
          if (tsLocalDev && applyMockOffer) {
            applyMockOffer({ eligible: true, kind: 'beta', discountId: SAMPLE_DISCOUNT });
          }
          return;
        }
        // a failed payment leaves the cards up, because they have not bought anything
        if (state === 'failed') {
          done.hidden = true;
          if (main) main.classList.remove('is-paid');
          sec.classList.remove('has-purchase');
          showError();
          return;
        }
        showDone();
        if (state === 'pending') startIdle(code);
        if (state === 'revealed') {
          // shimmer briefly first: the reveal is the thing worth looking at
          startIdle(code);
          setTimeout(function () { revealKey(SAMPLE_KEY, sampleEmail()); }, 900);
        }
        if (state === 'slow') giveUp(sampleEmail());
        if (state === 'expired') giveUp(sampleEmail(), 'expired');
        if (state === 'up-trial') showUpgraded('trial');
        if (state === 'up-beta') showUpgraded('beta');
      });
    }

    // The app sends an upgrading user here as ?upgrade=<handle>#pricing. The parameter is
    // "upgrade", not "trial", because the handle carries a BETA licence as readily as a trial one.
    // It names the licence they are already running, so the webhook moves that one onto a paid
    // policy instead of minting a second. Read once, at load, so a re-render between arriving and
    // clicking Buy cannot lose it. Absent or empty is an ordinary full-price purchase.
    //
    // There is no later chance to attach this. custom_data is fixed when the transaction is
    // created, and /shop/checkout only reopens an existing ?_ptxn=. Miss it and the failure is
    // silent: the webhook finds no handle, mints a new licence, and the buyer's installed app
    // still says trial while their key sits in their inbox.
    var upgradeHandle = (q0.get('upgrade') || '').trim();

    // What that handle entitles: { eligible, kind, discountId }. The WORKER decides, never this
    // page. A discount the storefront could grant itself is one anybody could grant themselves by
    // editing a URL, so nothing here reads a flag off the query string.
    //
    // Null until it answers, and null forever if it does not. Every failure means full price, and
    // none of them may block the buy button, so the lookup is raced against a timeout and its
    // rejection is swallowed. The endpoint fails closed on its own side; this side's only job is
    // not to turn that into a dead page.
    var offer = null;
    var offerReady = Promise.resolve(null);
    var infoUrl = sec.getAttribute('data-upgrade-info') || '';

    // Local simulation of an answer, so the discounted cards and the upgrade confirmation can be
    // looked at before the Worker route exists.
    //
    // Gated on the HOSTNAME, deliberately not on the same condition as the state switcher: that
    // one also turns on with ?mockup=1, which works on the live domain. A query parameter that
    // could attach a real discount id to a real checkout is precisely the client-side grant the
    // spec forbids, so this can only ever run on a dev server.
    //   ?mockoffer=beta|trial [&mockdiscount=dsc_…]
    var localOnly = /^(127\.0\.0\.1|localhost)$/.test(location.hostname);
    var mockOffer = localOnly ? (q0.get('mockoffer') || '') : '';
    if (mockOffer === 'beta' || mockOffer === 'trial') {
      offer = { eligible: true, kind: mockOffer, discountId: q0.get('mockdiscount') || null };
    } else if (upgradeHandle && infoUrl) {
      offerReady = Promise.race([
        fetch(infoUrl + '?handle=' + encodeURIComponent(upgradeHandle), { credentials: 'omit' })
          .then(function (r) { return r.json(); })
          .catch(function () { return null; }),
        new Promise(function (res) { setTimeout(function () { res(null); }, 4000); })
      ]).then(function (d) {
        offer = (d && d.eligible) ? d : null;
        return offer;
      }).catch(function () { return null; });
    }

    // An upgrade mints no new key, so the confirmation has nothing to poll for. Paid licences come
    // back ineligible, which is not an upgrade either: that is a second purchase.
    function isUpgrade() {
      return !!(offer && (offer.kind === 'trial' || offer.kind === 'beta'));
    }

    // Landing here from Paddle's redirect. Paddle appends the transaction id, which is what the
    // key lookup is keyed on.
    // Only reached if a return URL was configured, which is off by default: Paddle's redirect
    // fires the moment payment lands and takes the page with it, cutting the reveal short. The
    // handler stays because the redirect is still the only path some payment methods offer, and
    // because a buyer may bookmark or reload the confirmation. Paddle spells the transaction id
    // _ptxn; the alternates cost nothing and save a silent failure if that ever differs.
    //
    // Deferred until the lookup answers, so an upgrade that comes back this way still knows it is
    // one. It only can if the return URL carried ?upgrade= through; Paddle appends to whatever was
    // configured and does not preserve the original query, so a bare return URL lands here as an
    // ordinary purchase and polls for a key. That is the same fallback as the lookup being down.
    if (q0.get('purchase') === 'complete') {
      offerReady.then(function () {
        onPaid(q0.get('_ptxn') || q0.get('ptxn') || q0.get('transaction_id') || null, null);
      });
    }

    var token = sec.getAttribute('data-paddle-token');
    var buys = Array.prototype.slice.call(sec.querySelectorAll('[data-pd-buy]'));
    if (!token) {
      // No token configured: the static amounts stand, but nothing must look purchasable.
      buys.forEach(function (b) { b.disabled = true; b.setAttribute('aria-disabled', 'true'); });
      return;
    }

    var amounts = Array.prototype.slice.call(sec.querySelectorAll('[data-pd-price]'));
    var freqBtns = Array.prototype.slice.call(sec.querySelectorAll('[data-pd-freq]'));
    var period = sec.querySelector('[data-pd-period]');
    var successUrl = sec.getAttribute('data-paddle-success') || '';

    // Pinned, not inherited. Paddle's own defaults are theme:light and variant:multi-page, but the
    // effective values come from the account dashboard and from an unpinned CDN build of
    // paddle.js, so an overlay that looked right one day can change appearance with no deploy on
    // this side. Naming them here makes the checkout look the same regardless of either.
    //
    // theme and variant govern the checkout CARD only. Neither touches the backdrop behind it:
    // that is painted inside Paddle's iframe from the colours set in the Paddle dashboard, which
    // is why it can change with no deploy here and cannot be styled from this stylesheet.
    // Per Paddle's own overlay docs: "Customize colors, logo, and branding in the Paddle
    // dashboard. Structure and experience is managed by Paddle."
    //
    // Pinned anyway, so the card at least does not drift with the account default.
    var CHECKOUT_SETTINGS = {
      displayMode: 'overlay',
      theme: sec.getAttribute('data-checkout-theme') || 'light',
      variant: sec.getAttribute('data-checkout-variant') || 'multi-page'
    };

    function ready(fn) {
      if (window.Paddle) return fn();
      var tag = document.createElement('script');
      tag.src = 'https://cdn.paddle.com/paddle/v2/paddle.js';
      tag.onload = fn;
      tag.onerror = function () {
        buys.forEach(function (b) { b.disabled = true; b.setAttribute('aria-disabled', 'true'); });
      };
      document.head.appendChild(tag);
    }

    ready(function () {
      try {
        if (sec.getAttribute('data-paddle-env') === 'sandbox') Paddle.Environment.set('sandbox');
        // Not every payment method redirects, and the overlay can complete in place. Handling the
        // event as well as the redirect means the reveal happens either way, and the buyer keeps
        // their scroll position when it does.
        Paddle.Initialize({
          token: token,
          checkout: { settings: CHECKOUT_SETTINGS },
          eventCallback: function (ev) {
            if (!ev) return;
            // Closing the overlay is a decision, not a fault: saying anything about it is nagging.
            if (ev.name === 'checkout.error') { showError(); return; }
            if (ev.name !== 'checkout.completed') return;
            var d = ev.data || {};
            var email = (d.customer && d.customer.email) || null;
            setTimeout(function () { try { Paddle.Checkout.close(); } catch (e) {} }, 0);
            setTimeout(function () { try { Paddle.Checkout.close(); } catch (e) {} }, 400);
            onPaid(d.transaction_id || d.id || null, email);
            if (done) done.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        });
      } catch (e) { return; }

      // Every price in one call, both frequencies included, so flipping the toggle is a lookup
      // rather than another round trip. No address: Paddle infers the country from the IP, and
      // the sentinel some examples use is not something the API accepts.
      var ids = {};
      amounts.forEach(function (el) {
        ['data-pd-price', 'data-pd-price-month', 'data-pd-price-year'].forEach(function (a) {
          var v = el.getAttribute(a);
          if (v) ids[v] = 1;
        });
      });
      var items = Object.keys(ids).map(function (id) { return { priceId: id, quantity: 1 }; });
      if (!items.length) return;

      var formatted = {};   // what the buyer pays
      var full = {};        // the same prices with no discount, for the strike-through
      var discounted = {};
      function linesOf(res) {
        return res && res.data && res.data.details && res.data.details.lineItems;
      }
      // Waits on the offer so this is one call with the right discount, rather than a full price
      // that visibly rewrites itself a moment later. The static fallbacks hold the space meanwhile.
      function loadPrices() {
        var withDiscount = offer && offer.discountId;
        // Two lookups when an offer is on: the price they pay, and the one it replaces. The
        // undiscounted figure is asked for rather than derived, because the discount comes off
        // before tax, so the total cannot be reconstructed by adding the discount back on. Paddle
        // owns that calculation and this does not attempt it.
        var jobs = [Paddle.PricePreview({ items: items })];
        if (withDiscount) jobs.push(Paddle.PricePreview({ items: items, discountId: offer.discountId }));
        return Promise.all(jobs).then(function (res) {
          var baseLines = linesOf(res[0]);
          var payLines = linesOf(res[res.length - 1]);
          if (!baseLines || !payLines) return;
          baseLines.forEach(function (li) { full[li.price.id] = li.formattedTotals.total; });
          payLines.forEach(function (li) {
            formatted[li.price.id] = li.formattedTotals.total;
            // Paddle reports what it actually took off. Reading the discount from the response
            // rather than from the fact that we asked for one means the note can never advertise
            // an offer the checkout will decline.
            //
            // The raw integer, not formattedTotals.discount: that is locale-formatted, and a zero
            // reads "$0.00" in one place and "0,00 €" in another. Parsing it would need to know
            // where the symbol sits. This is minor units as a plain string in every currency.
            discounted[li.price.id] = Number(li.totals && li.totals.discount) > 0;
          });
          paint();
        }).catch(function () { /* leave the static fallbacks in place */ });
      }
      offerReady.then(loadPrices);

      // Lets the dev switcher put the cards under a pretend offer and take them back out again.
      // Re-runs the real price lookup rather than doing arithmetic on the displayed figures, so
      // what it shows is what Paddle would actually charge.
      applyMockOffer = function (o) {
        offer = o;
        return loadPrices();
      };

      function paint() {
        amounts.forEach(function (el) {
          var id = el.getAttribute('data-pd-price');
          if (formatted[id]) el.textContent = formatted[id];
          var was = el.parentElement && el.parentElement.querySelector('[data-pd-was]');
          if (!was) return;
          // Only when Paddle actually took something off AND the two figures differ. A discount
          // that rounds to the same total would otherwise strike through the price it is next to.
          if (discounted[id] && full[id] && full[id] !== formatted[id]) {
            was.textContent = full[id];
            was.hidden = false;
          } else {
            was.textContent = '';
            was.hidden = true;
          }
        });
        paintOffer();
      }

      // The beta discount does not recur, so on a subscription it comes off the first period only.
      // Showing the reduced figure unqualified would make the card false from the second period
      // on, which is why the recurring cards say which period it applies to and the one-time card
      // does not need to.
      function paintOffer() {
        Array.prototype.forEach.call(sec.querySelectorAll('[data-pd-offer]'), function (note) {
          var card = note.closest('div');
          var amountEl = card && card.querySelector('[data-pd-price]');
          var id = amountEl && amountEl.getAttribute('data-pd-price');
          if (!id || !discounted[id]) { note.hidden = true; return; }
          if (note.hasAttribute('data-pd-offer-recurring')) {
            var yearly = amountEl.getAttribute('data-pd-price-year') === id;
            note.textContent = 'Beta tester price, for your first ' + (yearly ? 'year' : 'month') + '.';
          } else {
            note.textContent = 'Beta tester price.';
          }
          note.hidden = false;
        });
      }

      // ---- monthly / yearly ----
      freqBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var freq = btn.getAttribute('data-pd-freq');
          freqBtns.forEach(function (b) {
            var on = b === btn;
            b.classList.toggle('is-active', on);
            b.setAttribute('aria-pressed', on ? 'true' : 'false');
          });
          amounts.forEach(function (el) {
            var id = el.getAttribute('data-pd-price-' + freq);
            if (id) el.setAttribute('data-pd-price', id);
          });
          buys.forEach(function (b) {
            var id = b.getAttribute('data-pd-buy-' + freq);
            if (id) b.setAttribute('data-pd-buy', id);
          });
          if (period) period.textContent = freq === 'year' ? 'per year' : 'per month';
          paint();
        });
      });

      // ---- checkout ----
      buys.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var id = btn.getAttribute('data-pd-buy');
          if (!id) return;
          var opts = { items: [{ priceId: id, quantity: 1 }] };
          // The URL parameter is `upgrade`; the customData key is `trialHandle`. They do not
          // match and nothing warns you: the webhook reads custom_data.trialHandle and nothing
          // else. Sent whenever a handle is present, regardless of what the lookup said, because
          // the lookup being down must not turn an upgrade into a duplicate licence.
          if (upgradeHandle) opts.customData = { trialHandle: upgradeHandle };
          // Carried explicitly rather than relying on the Initialize-level settings surviving.
          // A settings object passed here replaces the one given to Initialize rather than
          // merging into it, so sending only a successUrl would silently drop the theme and the
          // variant, and only on the checkouts that have a return URL.
          opts.settings = {
            displayMode: CHECKOUT_SETTINGS.displayMode,
            theme: CHECKOUT_SETTINGS.theme,
            variant: CHECKOUT_SETTINGS.variant
          };
          // absolute, because Paddle redirects the top window
          if (successUrl) opts.settings.successUrl = new URL(successUrl, location.origin).href;
          // Whatever the lookup has by now. It is started at load and the buyer has to read a
          // price list first, so it has effectively always answered; if it has not, they pay full
          // price rather than wait behind a spinner.
          if (offer && offer.discountId) opts.discountId = offer.discountId;
          try { Paddle.Checkout.open(opts); } catch (e) {}
        });
      });
    });
  })();

  /* beta signup, POST the email to the Cloudflare Worker (double opt-in; the Worker owns all
     key/confirm logic). Do NOT change the fetch URL, the { email } body, or the status handling. */
  (function () {
    var TS_SIGNUP_URL = "https://tonescan-beta-signup.little-pond-7bea.workers.dev/signup";
    var forms = document.querySelectorAll('.tonescan-landing .ts-signup');
    if (!forms.length) return;
    forms.forEach(function (root) {
      var form = root.querySelector('.ts-form');
      var email = root.querySelector('.ts-email');
      var btn = root.querySelector('.ts-btn');
      var msg = root.querySelector('.ts-msg');
      if (!form) return;
      function say(text, kind) { msg.textContent = text; msg.className = 'ts-msg ' + (kind || ''); }
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var value = (email.value || '').trim();
        if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(value)) { say('Please enter a valid email.', 'err'); return; }
        btn.disabled = true;
        say('Sending…');
        fetch(TS_SIGNUP_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: value })
        })
          .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
          .then(function (res) {
            if (!res.ok) throw new Error(res.d && res.d.error);
            if (res.d.status === 'already_issued')
              say("You've already got a key, check your inbox (and spam).", 'ok');
            else
              say("Almost there! Check your email to confirm and we'll send your key.", 'ok');
            form.reset();
          })
          .catch(function () { say('Something went wrong. Please try again.', 'err'); })
          .finally(function () { btn.disabled = false; });
      });
    });
  })();
}
if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', tsInit);
else tsInit();
})();
</script>
