    // Auto-advance every 10s, until the visitor picks something themselves, carousels that
    // keep moving after you've made a choice just fight you.
    var AUTO_MS = 10000, autoTimer = null, autoStopped = false;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function stopAuto() { autoStopped = true; clearTimeout(autoTimer); }
    function scheduleAuto() {
      if (autoStopped || reduce) return;
      clearTimeout(autoTimer);
      autoTimer = setTimeout(tick, AUTO_MS);
    }
    function tick() {
      if (autoStopped) return;
      // don't cut the Develop clip off part-way through, wait for it to finish
      if (video && shots[0] && shots[0].classList.contains('is-active') && !video.paused && !video.ended) {
        autoTimer = setTimeout(tick, 1000);
        return;
      }
      show(current + 1, true);
    }

    tabs.forEach(function (t, ti) { t.addEventListener('click', function () { show(ti); }); });
    if (select) select.addEventListener('change', function () { show(+select.value); });
    var prev = document.querySelector('.tonescan-landing .ts-hero-nav--prev');
    var next = document.querySelector('.tonescan-landing .ts-hero-nav--next');
    if (prev) prev.addEventListener('click', function () { show(current - 1); });
    if (next) next.addEventListener('click', function () { show(current + 1); });

    // hold while the pointer is over the media, so it can't swap out from under a reader
    if (frame) {
      frame.addEventListener('mouseenter', function () { clearTimeout(autoTimer); });
      frame.addEventListener('mouseleave', scheduleAuto);
    }
    scheduleAuto();
  })();

  /* hero Develop video, autoplay (muted) when the hero is in view AND its slot is active;
     replay button overlays when it ends. Honours reduced-motion (no autoplay; shows Play). */
  (function () {
    var video = document.querySelector('.tonescan-landing .ts-hero-video');
    if (!video) return;
    var slot = video.closest('.ts-hero-shot');
    var replay = document.querySelector('.tonescan-landing .ts-hero-replay');
    var label = replay ? replay.querySelector('.ts-hero-replay__label') : null;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var inView = false, ended = false;
    function activeSlot() { return slot && slot.classList.contains('is-active'); }
    function sync() {
      if (!reduce && inView && activeSlot() && !ended) { var p = video.play(); if (p && p.catch) p.catch(function () {}); }
      else { video.pause(); }
    }
    video.addEventListener('ended', function () { ended = true; if (label) label.textContent = 'Replay'; if (replay) replay.classList.add('is-shown'); });
    if (replay) replay.addEventListener('click', function () { ended = false; replay.classList.remove('is-shown'); video.currentTime = 0; var p = video.play(); if (p && p.catch) p.catch(function () {}); });
    if (reduce && replay) { if (label) label.textContent = 'Play'; replay.classList.add('is-shown'); } // opt-in under reduced motion
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (es) { es.forEach(function (e) { inView = e.isIntersecting; sync(); }); }, { threshold: 0.3 }).observe(video);
    } else { inView = true; sync(); }
    window.__tsHeroVideoSync = sync;
  })();

  /* beta signup, POST the email to the Cloudflare Worker (double opt-in; the Worker owns all
     key/confirm logic). Do NOT change the fetch URL, the { email } body, or the status handling. */
  (function () {
    var TS_SIGNUP_URL = "https://tonescan-beta-signup.little-pond-7bea.workers.dev/signup";
    var forms = document.querySelectorAll('.tonescan-landing .ts-signup');
    if (!forms.length) return;
    forms.forEach(function (root) {
      var form = root.querySelector('.ts-form');
      var email = root.querySelector('.ts-email');
      var btn = root.querySelector('.ts-btn');
      var msg = root.querySelector('.ts-msg');
      if (!form) return;
      function say(text, kind) { msg.textContent = text; msg.className = 'ts-msg ' + (kind || ''); }
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var value = (email.value || '').trim();
        if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(value)) { say('Please enter a valid email.', 'err'); return; }
        btn.disabled = true;
        say('Sending…');
        fetch(TS_SIGNUP_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: value })
        })
          .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
          .then(function (res) {
            if (!res.ok) throw new Error(res.d && res.d.error);
            if (res.d.status === 'already_issued')
              say("You've already got a key, check your inbox (and spam).", 'ok');
            else
              say("Almost there! Check your email to confirm and we'll send your key.", 'ok');
            form.reset();
          })
          .catch(function () { say('Something went wrong. Please try again.', 'err'); })
          .finally(function () { btn.disabled = false; });
      });
    });
  })();
</script>
