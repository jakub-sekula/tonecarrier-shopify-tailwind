  /* feature video modal, the "+" on each headline bento tile.
     data-video is empty until the clips are recorded, so fall back to the poster plus a note
     rather than opening an empty player. Adding the URL is the only change needed later. */
  (function () {
    var modal = document.querySelector('.tonescan-landing .ts-vid');
    if (!modal) return;
    var stage = modal.querySelector('.ts-vid__stage');
    var title = modal.querySelector('.ts-vid__title');
    var lastFocus = null;

    function close() {
      modal.hidden = true;
      stage.innerHTML = '';           // stops playback
      document.body.style.overflow = '';
      if (lastFocus && lastFocus.focus) lastFocus.focus();
    }
    function open(btn) {
      lastFocus = btn;
      var src = (btn.getAttribute('data-video') || '').trim();
      var poster = btn.getAttribute('data-poster') || '';
      var name = btn.getAttribute('data-title') || '';
      title.textContent = name;
      if (src) {
        stage.innerHTML = '<video controls autoplay playsinline muted loop poster="' + poster +
          '" src="' + src + '"></video>';
      } else {
        stage.innerHTML = '<img src="' + poster + '" alt="' + name + '">' +
          '<p class="ts-vid__soon">Walkthrough video coming soon</p>';
      }
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      modal.querySelector('.ts-vid__close').focus();
    }

    // The whole card is the target, the "+" is only an affordance (and the keyboard handle,
    // since its click bubbles up to the card listener below).
    document.querySelectorAll('.tonescan-landing .ts-bento').forEach(function (card) {
      var btn = card.querySelector('.ts-feature-more');
      if (!btn) return;
      var downX = null, downY = null;
      card.addEventListener('pointerdown', function (e) { downX = e.clientX; downY = e.clientY; });
      card.addEventListener('click', function (e) {
        if (e.target.closest('a')) return;   // the CTA navigates; it doesn't open the overlay
        // Releasing a text-selection drag inside the card still fires a click. Only treat it
        // as a deliberate tap when nothing got selected and the pointer barely moved.
        var sel = window.getSelection();
        if (sel && !sel.isCollapsed && sel.toString().length) return;
        if (downX !== null && (Math.abs(e.clientX - downX) > 4 || Math.abs(e.clientY - downY) > 4)) return;
        open(btn);
      });
    });
    modal.querySelectorAll('[data-close]').forEach(function (b) { b.addEventListener('click', close); });
    document.addEventListener('keydown', function (e) {
      if (!modal.hidden && e.key === 'Escape') close();
    });
  })();

  /* hero scroll, screenshot grows slightly; scattered floats converge inward (--p on .ts-hero) */
  (function () {
    var frame = document.querySelector('.tonescan-landing .ts-hero');
    if (!frame) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var scaler = frame.querySelector('.ts-hero-glass');
    var colour = document.querySelector('.tonescan-landing .ts-hero-color');
    var text = frame.querySelector('.ts-hero-text');
    var clamp = function (v) { return v < 0 ? 0 : (v > 1 ? 1 : v); };
    var ticking = false;
    // Pin the text where it already sits so it never travels, it only shrinks and fades.
    // The old version read rect.top and bailed unless we were at scroll 0, so a deep link
