{%- comment -%}
  Extracted from sections/tonescan-landing.liquid: that file hit Shopify's 256 KB
  template limit. Rendered with {%% render %%}, which isolates scope, so anything this
  needs from the section has to be passed in explicitly.
{%- endcomment -%}
<script>
/* Every driver below reaches for markup by selector. The page is split across three sections
   now and this snippet is rendered by the first of them, so at parse time most of that markup
   does not exist yet and each driver would quietly bail. Waiting for DOM ready makes the
   render position irrelevant, rather than making it a rule someone has to remember. */
(function () {
function tsInit() {
  (function () {
    document.querySelectorAll('.tonescan-landing .ts-ba').forEach(function (el) {
      var range = el.querySelector('.ts-ba__range');
      if (!range) return;
      var update = function () { el.style.setProperty('--pos', range.value + '%'); };
      range.addEventListener('input', update);
      update();
    });
  })();

  /* scan gallery, PhotoSwipe (pinch / wheel / double-click zoom, keyboard, swipe).
     Tiles are opened programmatically from a JSON dataSource rather than by scanning the DOM:
     each marquee row renders its frames twice for a seamless loop and rows can share a frame,
     so a DOM-driven gallery would show the same picture five or six times in a row. */
  (function () {
    var gallery = document.querySelector('.tonescan-landing .ts-gallery');
    var dataEl = document.querySelector('.tonescan-landing .ts-gallery-data');
    if (!gallery || !dataEl) return;

    var slides;
    try { slides = JSON.parse(dataEl.textContent); } catch (e) { return; }
    if (!slides || !slides.length) return;

    function start() {
      if (typeof PhotoSwipeLightbox === 'undefined' || typeof PhotoSwipe === 'undefined') return;
      var lightbox = new PhotoSwipeLightbox({
        dataSource: slides,
        pswpModule: PhotoSwipe,
        loop: true,
        zoom: true,
        wheelToZoom: true,
        showHideAnimationType: 'fade',
        bgOpacity: 0.96,
        padding: { top: 24, bottom: 24, left: 24, right: 24 }
      });

      // caption slot, stays empty (and hidden) until the capture details are filled in
      lightbox.on('uiRegister', function () {
        lightbox.pswp.ui.registerElement({
          name: 'ts-caption', order: 9, isButton: false, appendTo: 'root',
          html: '', className: 'pswp__caption',
          onInit: function (el, pswp) {
            pswp.on('change', function () {
              el.textContent = (pswp.currSlide && pswp.currSlide.data.caption) || '';
            });
          }
        });
      });

      lightbox.init();

      gallery.addEventListener('click', function (e) {
        var tile = e.target.closest('.ts-scan');
        if (!tile) return;
        e.preventDefault();
        lightbox.loadAndOpen(parseInt(tile.getAttribute('data-scan-index'), 10) || 0);
      });
    }

    // the PhotoSwipe tags are deferred, so wait for them if we got here first
    if (document.readyState === 'complete') start();
    else window.addEventListener('load', start);
  })();

  /* ---- shared machinery for the two pinned sections ------------------------------------------
     The workflow story and the RGB deep dive are the same component: copy blocks scrolling past
     a pinned media panel, one block active at a time, a dot rail tracking it, and a snap that
     parks the reader on a block once they stop. They were written separately, grew the same
     bugs independently, and were fixed independently. They share the machinery now.

     tsPinRig owns the two hard parts and nothing else:
       rests()   the document positions a reader is allowed to stop at
       glide()   the ONLY code that scrolls the page
       settle()  the ONLY code that decides to move, on scroll-idle, to the NEAREST rest
     Anything section-specific (the merge, the drifting blobs) stays in the caller's frame hook,
     which may write styles but must never scroll.
  ------------------------------------------------------------------------------------------- */

  // One rig may drive the page at a time. At a section boundary both can be partly on screen and
  // both pass their own in-view test, and without this they each glide to their own rest and
  // fight over the page.
  var tsRigLock = { by: null, until: 0 };

  function tsPinRig(opts) {
    var el = opts.el;
    var IDLE_MS = opts.idleMs || 180;          // scrolling counts as stopped after this
    var self = {};
    var glideRaf = null, gliding = false, quietUntil = 0, idle = null, running = false;

    function vh() { return window.innerHeight || document.documentElement.clientHeight; }
    function ease(v) { return v < 0.5 ? 4*v*v*v : 1 - Math.pow(-2*v + 2, 3) / 2; }
    function release() { if (tsRigLock.by === self) { tsRigLock.by = null; tsRigLock.until = 0; } }

    // ---- the ONLY thing here that scrolls the page ----
    function stopGlide() {
      if (glideRaf) cancelAnimationFrame(glideRaf);
      glideRaf = null; gliding = false;
      release();
    }
    function glide(to, dur) {
      stopGlide();
      var from = window.pageYOffset, delta = to - from;
      if (Math.abs(delta) < 3) return;
      var t0 = performance.now();
      gliding = true; quietUntil = Date.now() + dur + 200;
      tsRigLock.by = self; tsRigLock.until = quietUntil;
      // The glide records where it left the page each frame. If the page has moved somewhere
      // else by the next one, something other than this moved it, which can only be the reader:
      // hand back immediately. This is why the wheel is not in the cancel list below. Classifying
      // wheel events cannot separate a real gesture from the inertia that keeps firing after it,
      // but comparing against our own last write does not have to.
      var expected = null;
      (function step(now) {
        if (expected !== null && Math.abs(window.pageYOffset - expected) > 2) {
          glideRaf = null; gliding = false; quietUntil = 0; release(); return;
        }
        var k = Math.min(1, (now - t0) / dur), y = from + delta * ease(k);
        try { window.scrollTo({ top: y, behavior: 'instant' }); } catch (e) { window.scrollTo(0, y); }
        expected = window.pageYOffset;              // read back what actually landed
        if (k < 1) glideRaf = requestAnimationFrame(step);
        else { glideRaf = null; gliding = false; }
      })(t0);
    }
    // Real input always wins. Wheel is not in this list on purpose: trackpad inertia keeps firing
    // wheel events for a second after the fingers lift, which would cancel every glide.
    ['touchstart', 'keydown', 'pointerdown'].forEach(function (ev) {
      window.addEventListener(ev, function () {
        stopGlide(); quietUntil = 0;
        if (opts.onInput) opts.onInput();
      }, { passive: true });
    });

    // ---- the ONLY thing here that decides to move ----
    // Try again shortly. settle() runs off the scroll-idle timer, so when it bails for a reason
    // that will pass on its own (a glide finishing, a merge still running, the quiet window after
    // a glide) there is nothing left to call it again: if the reader has stopped, no more scroll
    // events arrive. That is how a section could sit in one place forever, and why a nudge was
    // needed to shake it loose.
    function settleSoon(ms) { clearTimeout(idle); idle = setTimeout(settle, ms); }

    function settle() {
      if (opts.snap === false) return;
      if (gliding || (opts.busy && opts.busy())) { settleSoon(220); return; }
      if (Date.now() < quietUntil) { settleSoon(quietUntil - Date.now() + 60); return; }
      if (tsRigLock.by && tsRigLock.by !== self && Date.now() < tsRigLock.until) { settleSoon(220); return; }
      var r = el.getBoundingClientRect(), H = vh();
      if (r.top > H * 0.9 || r.bottom < H * 0.1) return;     // not in front of the reader
      if (opts.beforeSettle && opts.beforeSettle(r, H, settleSoon)) return;

      // Settle to the NEAREST rest, full stop. The direction filter and the dead zone that
      // replaced it were both wrong, in opposite ways: filtering by direction meant a nudge up
      // from a block counted as "heading up" and threw the reader all the way back, and widening
      // the dead zone to stop that just let them park anywhere in between. Nearest handles both
      // on its own. A small nudge is still nearest to the block you are on, so it returns there;
      // once you are past the midpoint the next one is nearest, so it carries you on; and
      // scrolling clean past the section fails the in-view test above and is left alone entirely.
      var y = window.pageYOffset, all = opts.rests(), ti = -1, bestD = Infinity;
      for (var i = 0; i < all.length; i++) {
        var d = Math.abs(all[i] - y);
        if (d < bestD) { bestD = d; ti = i; }
      }
      if (ti < 0) return;

      // Stay inside the span the rests actually cover. The in-view test above is on the whole
      // section, and a four-block story is several viewports tall, so it still counts as in view
      // long after the reader has scrolled on into the next section: the story rig would reach
      // forward and haul them back out of the RGB merge while that section was starting it, and
      // the two would trade the page back and forth. Half a viewport past the end is the same
      // nearest-rest logic applied one level up: beyond that you are closer to whatever comes
      // next than to anything here, so this rig has no business moving you.
      if (y < all[0] - H * 0.5 || y > all[all.length - 1] + H * 0.5) return;

      if (opts.resolve) ti = opts.resolve(ti, all, r, H);
      var dist = Math.abs(all[ti] - y);
      if (dist < 8) return;                        // already parked on one
      if (dist > H * 0.85) return;                 // too far to be a settle
      glide(all[ti], Math.min(1600, 700 + dist * 0.7));
    }

    // ---- render: one rAF loop, reads scroll and writes styles, never moves the page ----
    function frame(now) {
      var r = el.getBoundingClientRect(), H = vh();
      var more = opts.frame ? opts.frame(r, H, now) : false;
      var live = r.bottom > -200 && r.top < H + 200;
      if (live || more) requestAnimationFrame(frame); else running = false;
    }
    function kick() { if (!running) { running = true; requestAnimationFrame(frame); } }

    window.addEventListener('scroll', function () { kick(); settleSoon(IDLE_MS); }, { passive: true });
    window.addEventListener('resize', kick, { passive: true });

    self.glide = glide; self.settle = settle; self.settleSoon = settleSoon;
    self.stopGlide = stopGlide; self.kick = kick; self.vh = vh; self.ease = ease;
    return self;
  }

  /* One media stage. Both sections crossfade the same way: the incoming layer rises into place
     while the outgoing one carries on out the way you are travelling, and .is-up flips that axis
     when you scroll back up. .ts-no-anim kills the transition for one frame while the resting
     offsets flip, so nothing visibly jumps across the frame at the changeover. Layers are matched
     by data-i rather than by position, so they stay correct if the blocks are ever reordered. */
  function tsStage(stage, dots, layers, onSet) {
    var active = -1;
    function setDir(up) {
      if (!stage || stage.classList.contains('is-up') === up) return;
      stage.classList.add('ts-no-anim');
      stage.classList.toggle('is-up', up);
      void stage.offsetWidth;                      // flush the new offsets before re-enabling
      stage.classList.remove('ts-no-anim');
    }
    return {
      index: function () { return active; },
      set: function (i) {
        if (i === active) return;
        if (onSet) onSet(i, active);
        setDir(i < active);
        dots.forEach(function (d, di) { d.classList.toggle('is-active', di === i); });
        layers.forEach(function (l) {
          var li = parseInt(l.getAttribute('data-i'), 10) || 0;
          if (li === i) { l.classList.remove('is-leaving'); l.classList.add('is-active'); }
          else if (l.classList.contains('is-active')) {
            // send the outgoing layer onward, then park it back for its next turn
            l.classList.remove('is-active'); l.classList.add('is-leaving');
            setTimeout(function () {
              if (!l.classList.contains('is-active')) l.classList.remove('is-leaving');
            }, 1100);
          }
        });
        active = i;
      }
    };
  }

  /* RGB deep dive. The three raw captures splay apart, draw together as you scroll, then the real
     converted frame crossfades in and the panel slides left while the copy scrolls past it on the
     right. The merge runs on its own clock; everything else is scroll-linked. */
  (function () {
    document.querySelectorAll('.tonescan-landing .ts-hdive__pin').forEach(function (pin) {
      var rgb    = pin.querySelector('.ts-rgb');
      var stg    = pin.querySelector('.ts-rgb__stage');
      var panels = Array.prototype.slice.call(pin.querySelectorAll('.ts-hdive__panel'));
      var layers = stg ? Array.prototype.slice.call(stg.querySelectorAll('[data-i]')) : [];
      var dots   = Array.prototype.slice.call(pin.querySelectorAll('.ts-hdive__dot'));

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        if (rgb) { rgb.style.setProperty('--s', 0); rgb.classList.add('is-converted', 'is-played'); }
        pin.style.setProperty('--t', 1);
        panels.forEach(function (p) { p.style.setProperty('--pv', 1); });
        pin.classList.add('is-copy');
        return;
      }

      var PLAY_MS  = 1700;   // the merge, on its own clock
      var HOLD_MS  = 900;    // how long residual inertia is absorbed once it starts
      var BEAT_MS  = 850;    // pause on the merged photo before moving to the copy
      var SLIDE    = 0.7;    // fraction of a viewport the slide plays out over
      var APPROACH = 0.72;   // and the pre-merge scrub

      var clamp = function (v) { return v < 0 ? 0 : v > 1 ? 1 : v; };
      function vh() { return window.innerHeight || document.documentElement.clientHeight; }
      function midOffset() {
        var h = document.querySelector('header');
        var hh = h ? h.getBoundingClientRect().height : 0;
        return hh + (vh() - hh) / 2;
      }

      // rest positions, in document coordinates: the merged photo, then each copy block
      function mergeRest() { return window.pageYOffset + pin.getBoundingClientRect().top; }
      function panelRest(i) {
        var r = panels[i].getBoundingClientRect();
        return window.pageYOffset + r.top + r.height / 2 - midOffset();
      }
      function rests() {
        var out = [mergeRest()];
        for (var i = 0; i < panels.length; i++) out.push(panelRest(i));
        return out;
      }

      var media = tsStage(stg, dots, layers, function (i) {
        if (stg) { stg.classList.add('is-rot'); stg.classList.toggle('is-shot', i > 0); }
      });

      var played = false, playing = false, playT0 = 0, holdY = 0, holding = false;
      var t = 0, tTarget = 0;

      function startPlay() {
        if (played || playing) return;
        playing = true; playT0 = performance.now(); holdY = window.pageYOffset; holding = true;
        setTimeout(function () { holding = false; }, HOLD_MS);
        rig.kick();
      }

      function render(r, H, now) {
        if (playing) {
          if (holding && Math.abs(window.pageYOffset - holdY) > 1) {
            try { window.scrollTo({ top: holdY, behavior: 'instant' }); } catch (e) { window.scrollTo(0, holdY); }
          }
          var k = Math.min(1, (now - playT0) / PLAY_MS), e = 1 - Math.pow(1 - k, 3);
          if (rgb) {
            rgb.style.setProperty('--s', (1 - e).toFixed(3));
            rgb.classList.toggle('is-converted', k >= 1);
          }
          if (k >= 1) {
            playing = false; played = true; holding = false;
            if (rgb) rgb.classList.add('is-played');
            setTimeout(rig.settle, BEAT_MS);        // a beat on the merged photo, then move on
          }
        } else if (rgb) {
          // Scroll-linked whenever the timed run is not driving it, so scrubbing back up
          // separates the channels again rather than leaving the photo stuck merged.
          var q = clamp(1 - (mergeRest() - window.pageYOffset) / (H * APPROACH));
          rgb.style.setProperty('--s', (1 - Math.pow(q, 3)).toFixed(3));
          rgb.classList.toggle('is-converted', q >= 0.985);
        }

        // The slide was once gated on the timed run having finished, but that run only starts if
        // you stop in the zone, so scrolling straight through left the section dead. Reaching the
        // rest position counts as merged too; the scrub has already played it out by then.
        if (!played && !playing && r.top <= 0) {
          played = true;
          if (rgb) rgb.classList.add('is-played');
        }

        tTarget = played ? rig.ease(clamp(-r.top / (H * SLIDE))) : 0;
        var gap = Math.abs(tTarget - t);
        t += (tTarget - t) * (gap > 0.25 ? 0.34 : 0.14);
        if (Math.abs(tTarget - t) < 0.0005) t = tTarget;
        pin.style.setProperty('--t', t.toFixed(4));

        var gate = clamp((t - 0.5) / 0.4);
        pin.classList.toggle('is-copy', gate > 0);
        var best = -1, bestD = Infinity;
        panels.forEach(function (p, i) {
          var pr = p.getBoundingClientRect();
          var d = Math.abs((pr.top + pr.height / 2) - H / 2) / H;
          if (d < bestD) { bestD = d; best = i; }
          var pv = gate <= 0 ? 0 : clamp((0.62 - d) / 0.36) * gate;
          p.style.setProperty('--pv', (pv * pv * (3 - 2 * pv)).toFixed(3));
        });
        if (gate > 0 && best >= 0 && bestD < 0.3) media.set(best);

        // While the merge is still scrubbing, the section is back at its opening state. The active
        // index used to keep whatever block it last showed, so is-shot stayed on, the channels
        // stayed hidden and the frame was not the active layer: entering the section a second time
        // rendered nothing at all but the glow.
        var conv = !rgb || rgb.classList.contains('is-converted');
        if (!conv && media.index() !== 0) media.set(0);

        // Glow follows the copy: all three channels while the merge is still on screen, then red,
        // green, blue as each block comes up. Driven off the same index as the dots.
        var ai = media.index();
        var ch = (gate > 0 && ai >= 0) ? ['r', 'g', 'b'][ai] : null;
        pin.classList.toggle('is-ch-r', ch === 'r');
        pin.classList.toggle('is-ch-g', ch === 'g');
        pin.classList.toggle('is-ch-b', ch === 'b');

        return Math.abs(tTarget - t) > 0.0005 || playing;
      }

      var rig = tsPinRig({
        el: pin,
        rests: rests,
        frame: render,
        busy: function () { return playing; },
        onInput: function () { holding = false; },
        beforeSettle: function (r, H, settleSoon) {
          if (played) return false;
          if (Math.abs(r.top) < H * 0.45) startPlay();   // settled in the zone: run it
          else settleSoon(400);                          // in view but short of the zone
          return true;
        },
        // all[0] is the merged photo. Once the merge has played that is a place to pass through,
        // not to stop: a static photo with no copy and nothing prompting you onward, which is
        // exactly the state you can get stuck in. Resolve it to the first copy block instead, and
        // only when actually on or past it, so scrolling up out of the section is not pushed back.
        resolve: function (ti, all, r, H) {
          return (ti === 0 && all.length > 1 && r.top <= H * 0.1) ? 1 : ti;
        }
      });

      dots.forEach(function (d, di) {
        d.addEventListener('click', function () { rig.glide(panelRest(di), 900); });
      });

      rig.kick();
      setTimeout(rig.settle, 700);
    });
  })();

  /* secondary feature list — one category open at a time; clicking the open one closes it */
  (function () {
    document.querySelectorAll('.tonescan-landing .ts-more__acc').forEach(function (acc) {
      var items = acc.querySelectorAll('.ts-more__item');
      if (!items.length) return;

      {%- comment -%} In the two-column layout the panels are positioned, so they cannot grow the
         container and a long list would spill past the section. Measure the tallest one and hold
         the container open to it. A fixed min-height was wrong the moment the row spacing
         changed; this follows the copy instead. {%- endcomment -%}
      var wide = window.matchMedia('(min-width: 900px)');
      function fit() {
        if (!wide.matches) { acc.style.minHeight = ''; return; }
        var tallest = 0;
        items.forEach(function (it) {
          var inner = it.querySelector('.ts-more__panelinner');
          if (inner) tallest = Math.max(tallest, inner.scrollHeight);
        });
        // 11px lines the first list row up with the first button; leave the same clearance below
        acc.style.minHeight = tallest ? (tallest + 22) + 'px' : '';
      }
      fit();
      window.addEventListener('resize', fit, { passive: true });
      if (window.ResizeObserver) new ResizeObserver(fit).observe(acc);
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
      items.forEach(function (it, i) {
        it.querySelector('.ts-more__trigger').addEventListener('click', function () {
          {%- comment -%} always open the one clicked, never toggle it shut: as two columns the
             panel is the whole right-hand side, and closing it would leave the section empty
             with no obvious way back. {%- endcomment -%}
          items.forEach(function (x, xi) {
            var on = xi === i;
            x.classList.toggle('is-open', on);
            x.querySelector('.ts-more__trigger').setAttribute('aria-expanded', on ? 'true' : 'false');
          });
        });
      });
    });
  })();

  /* Conversion strip. Both layers are identical and are driven by one offset, so they stay
     locked together; the conversion is done entirely by their complementary CSS masks. Motion
     is deliberately stepped rather than continuous: settle, slide one frame, settle. */
  (function () {
    var wrap = document.querySelector('.tonescan-landing .ts-conv');
    if (!wrap) return;
    var tracks = wrap.querySelectorAll('.ts-conv__track');
    if (!tracks.length) return;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

    var SLIDE_MS = 1000, SETTLE_MS = 1500;     // 1.5s standing still, then a 1s step
    var offset = 0, lead = 0, timer = null, running = false;
    var gen = 0;                               // bumped on stop, so in-flight slides stand down
    var DRAG_SNAP_MS = 420, FLICK_MS = 170;
    var dragging = false, dragId = null, startX = 0, startOff = 0, lastX = 0, lastT = 0, vel = 0;
    var dot = null;
    var cutPx = 0;                             // --cut in px, refreshed by centreLead
    var mvX = 0, mvY = 0, mvTouch = false, rafId = 0;
    var viewerOpen = false;                    // the strip holds still while a frame is open

    function each(fn) { Array.prototype.forEach.call(tracks, fn); }
    function firstItem() { return tracks[0].querySelector('.ts-conv__item'); }
    function step() { var it = firstItem(); return it ? it.offsetWidth : 0; }   // gap is 0
    function wait(ms) { return new Promise(function (r) { timer = setTimeout(r, ms); }); }
    function apply() { each(function (t) { t.style.transform = 'translateX(' + (lead - offset) + 'px)'; }); }

    // 24 -> 23A -> 23 -> 22A ... the step below whatever its right-hand neighbour reads.
    // The roll wraps at 0, back round to 39A: counting down without a floor ran the strip
    // into negative frame numbers after enough recycles.
    function prevLabel(label) {
      var m = /^(\d+)(A?)$/.exec(label || '');
      if (!m) return label;
      if (m[2]) return m[1];
      var n = parseInt(m[1], 10) - 1;
      return (n < 0 ? 39 : n) + 'A';
    }
    function nextLabel(label) {
      var m = /^(\d+)(A?)$/.exec(label || '');
      if (!m) return label;
      if (!m[2]) return m[1] + 'A';
      var n = parseInt(m[1], 10) + 1;
      return (n > 39 ? 0 : n) + '';
    }
    function renumber(frame, neighbour, forward) {
      var ref = neighbour && neighbour.querySelector('.ts-conv__num');
      if (!ref) return;
      var txt = ref.textContent.trim();
      var next = forward ? nextLabel(txt) : prevLabel(txt);
      frame.querySelectorAll('.ts-conv__num').forEach(function (el) { el.textContent = next; });
    }

    // Wrap a frame from one end of the track to the other. Both layers must move together or
    // they drift apart, and the gate classes ride along on the element so shapes stay put.
    function recycle(dir) {
      each(function (t) {
        var items = t.querySelectorAll('.ts-conv__item');
        if (items.length < 2) return;
        if (dir > 0) {                       // travelling right: the last frame feeds in at the left
          var last = items[items.length - 1];
          t.insertBefore(last, items[0]);
          renumber(last, items[0], false);   // it is EARLIER on the roll than its new neighbour
        } else {                             // travelling left: the first frame feeds in at the right
          var first = items[0];
          t.appendChild(first);
          renumber(first, items[items.length - 1], true);
        }
      });
    }

    // Keep offset inside one pitch by wrapping whole frames instead, so a drag of any length
    // never runs the strip out of stock. Returns how far offset was shifted, because a drag in
    // progress has to move its own origin by the same amount or the next move undoes this.
    function normalise() {
      var d = step();
      if (!d) return 0;
      var shift = 0, guard = 0;
      while (offset <= -d && guard++ < 200) { recycle(1); offset += d; shift += d; }
      while (offset >= d && guard++ < 200) { recycle(-1); offset -= d; shift -= d; }
      return shift;
    }

    // ---- off-screen culling ------------------------------------------------------------------
    // The track runs ~6x wider than the viewport, but every frame off the sides still carries a
    // gate mask, an invert filter and a multiply blend for the compositor to honour. Hide the
    // ones nobody can see. Driven by a stylesheet rather than per-element classes because
    // nth-child re-evaluates itself as frames recycle, which is exactly the behaviour wanted
    // here: the index window stays put while the elements move through it.
    var cullSheet = null;
    function cull() {
      var d = step();
      if (!d) return;
      if (!cullSheet) { cullSheet = document.createElement('style'); document.head.appendChild(cullSheet); }
      var items = tracks[0].querySelectorAll('.ts-conv__item');
      var total = items.length;
      // the film base and the two rule strips sit ahead of the frames and span the whole track,
      // so their child indices have to be skipped or the cull would take them out too
      var head = 0, kids = tracks[0].children;
      while (head < kids.length && !kids[head].classList.contains('ts-conv__item')) head++;
      var visible = Math.ceil(wrap.clientWidth / d) + 1;
      var kLeft = Math.ceil((wrap.clientWidth / 2) / d) + 3;
      // 4 frames of margin: enough for the frame arriving during a step plus a two-pitch flick
      var lo = kLeft - 4, hi = kLeft + visible + 4;
      var sel = [];
      if (lo >= 1) sel.push('.ts-conv__item:nth-child(-n+' + (lo + head) + ')');
      if (hi < total) sel.push('.ts-conv__item:nth-child(n+' + (hi + head + 1) + ')');
      cullSheet.textContent = sel.length
        ? sel.join(',') + '{content-visibility:hidden;contain-intrinsic-size:auto ' + d +
          'px auto ' + wrap.clientHeight + 'px}'
        : '';
    }

    // centre on the PICTURE, not the frame: the window is the first 36mm of a 37.9984mm pitch.
    // kLeft whole frames are parked off-screen to the left so the strip never runs out that side.
    function centreLead() {
      var it = firstItem(), d = step();
      if (!it || !d) return;
      var win = it.querySelector('.ts-conv__win');
      var winMid = win ? win.offsetLeft + win.offsetWidth / 2 : d / 2;
      var kLeft = Math.ceil((wrap.clientWidth / 2) / d) + 3;   // headroom for a flick
      lead = wrap.clientWidth / 2 - winMid - kLeft * d;
      // the changeover sits in the gap FOLLOWING the centred frame, so the white side runs
      // past the middle and the frame in the middle is still a negative
      var winW = win ? win.offsetWidth : d;
      // On a phone a single frame is most of the screen, so no interframe gap lands anywhere
      // near the middle. Centre the changeover instead and accept that it crosses a frame.
      // The backdrop spans the whole section, heading included, so a percentage down its height
      // does not land on the film. Publish the strip's own centreline for the glow to sit on.
      if (wrap.parentElement) {
        wrap.parentElement.style.setProperty('--strip-mid',
          (wrap.offsetTop + wrap.offsetHeight / 2) + 'px');
      }

      var cut = (wrap.clientWidth < 768
        ? wrap.clientWidth / 2
        : wrap.clientWidth / 2 + winW / 2 + (d - winW) / 2) + 'px';
      cutPx = parseFloat(cut);
      wrap.style.setProperty('--cut', cut);
      // the backdrop is a sibling, not a child, so it needs the value on a shared ancestor
      if (wrap.parentElement) wrap.parentElement.style.setProperty('--cut', cut);
      cull();
      apply();
    }

    function slide() {
      var d = step();
      if (!d) return Promise.resolve();
      var g = gen;
      offset -= d;                                   // negative offset travels right
      each(function (t) { t.style.transition = 'transform ' + SLIDE_MS + 'ms cubic-bezier(.4, 0, .2, 1)'; });
      apply();
      return wait(SLIDE_MS).then(function () {
        // A grab during the transition invalidates this tail. Leaving offset one pitch low with
        // the DOM untouched is still a consistent state; normalise() settles it on the next move.
        if (g !== gen) return;
        // travelling right, it is the LAST frame that leaves: move it to the front so the strip
        // feeds in from that side, then take the offset back by one pitch to hide the jump
        recycle(1);
        offset += d;
        each(function (t) { t.style.transition = 'none'; });
        apply();
        each(function (t) { void t.offsetWidth; });      // flush before the next transition
      });
    }

    async function loop() {
      running = true;
      while (running) { await wait(SETTLE_MS); await slide(); }
    }
    function start() { if (!running && !dragging && !viewerOpen && !reduce.matches) { centreLead(); loop(); } }
    function stop() { running = false; gen++; clearTimeout(timer); }

    // ---- free drag -------------------------------------------------------------------------
    // Grabbable anywhere along the strip. During the drag it tracks the pointer 1:1; on release
    // it carries a little, then parks on a whole pitch, because the changeover is cut to fall in
    // an interframe gap and a frame left straddling it reads as broken rather than free.

    // Mid-transition, offset already holds the TARGET while the strip is somewhere behind it.
    // Freeze on what is actually on screen, or the grab starts with a jump.
    function paintedOffset() {
      var m = getComputedStyle(tracks[0]).transform;
      if (!m || m === 'none') return offset;
      var nums = m.slice(m.indexOf('(') + 1, m.lastIndexOf(')')).split(',');
      var tx = parseFloat(nums[m.indexOf('matrix3d') === 0 ? 12 : 4]);
      return isNaN(tx) ? offset : lead - tx;
    }

    wrap.addEventListener('pointerdown', function (e) {
      if (e.button != null && e.button > 0) return;
      if (!step()) return;
      stop();
      dragging = true;
      offset = paintedOffset();
      each(function (t) { t.style.transition = 'none'; });
      apply();
      startX = lastX = e.clientX; startOff = offset; vel = 0; lastT = e.timeStamp || performance.now();
      dragId = e.pointerId;
      try { wrap.setPointerCapture(dragId); } catch (err) {}
      wrap.classList.add('is-dragging');
    });

    {%- comment -%} Everything a pointermove used to do now happens once per frame instead of once
       per event. Two things were costing frames: the drag wrote a transform and the dot then read
       two bounding rects and a computed style, forcing a synchronous layout on every single move;
       and normalise() recycled frames per event, so a fast drag crossing several pitches did
       several DOM moves on a 9000px track mid-gesture. Reads happen at the top of the tick while
       layout is still clean, writes after, and recycling happens at most once a frame. {%- endcomment -%}
    function tick() {
      rafId = 0;
      if (!dot && !dragging) return;
      // reads first, before anything writes
      var host = wrap.parentElement.getBoundingClientRect();
      var stripLeft = wrap.getBoundingClientRect().left;

      if (dragging) {
        offset = startOff - (mvX - startX);
        startOff += normalise();                        // keep the drag origin with the wrapped strip
        apply();
      }
      if (dot && !mvTouch) {
        dot.style.transform = 'translate3d(' + (mvX - host.left) + 'px,' + (mvY - host.top) + 'px,0)';
        dot.classList.toggle('on-light', cutPx > 0 && mvX - stripLeft < cutPx);
      }
    }
    function schedule() { if (!rafId) rafId = requestAnimationFrame(tick); }

    wrap.addEventListener('pointermove', function (e) {
      mvX = e.clientX; mvY = e.clientY; mvTouch = e.pointerType === 'touch';
      if (dragging && e.pointerId === dragId) {
        var now = e.timeStamp || performance.now();
        var dt = now - lastT;
        if (dt > 0) vel = (e.clientX - lastX) / dt;     // px per ms, for the flick
        lastX = e.clientX; lastT = now;
      }
      schedule();
    }, { passive: true });

    function endDrag(e) {
      if (!dragging || (e && e.pointerId !== dragId)) return;
      dragging = false;
      try { wrap.releasePointerCapture(dragId); } catch (err) {}
      wrap.classList.remove('is-dragging');
      if (dot) {
        dot.classList.remove('is-down');
        var r = wrap.getBoundingClientRect();
        if (e && (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom)) {
          dot.classList.remove('is-on');                // let go outside the strip: nothing to hint at
        }
      }
      var d = step();
      if (!d) { start(); return; }
      // cap the throw at two pitches: beyond that the snap would outrun the frames parked off-screen
      var carry = Math.max(-2 * d, Math.min(2 * d, vel * FLICK_MS));
      offset = Math.round((offset - carry) / d) * d;
      each(function (t) { t.style.transition = 'transform ' + DRAG_SNAP_MS + 'ms cubic-bezier(.22,.61,.36,1)'; });
      apply();
      var g = ++gen;
      timer = setTimeout(function () {
        if (g !== gen) return;
        each(function (t) { t.style.transition = 'none'; });
        normalise();                                    // pull back inside one pitch, invisibly
        apply();
        each(function (t) { void t.offsetWidth; });
        start();
      }, DRAG_SNAP_MS + 20);
    }
    wrap.addEventListener('pointerup', endDrag);
    wrap.addEventListener('pointercancel', endDrag);
    wrap.addEventListener('dragstart', function (e) { e.preventDefault(); });

    // ---- hover dot -------------------------------------------------------------------------
    dot = wrap.parentElement && wrap.parentElement.querySelector('.ts-conv-dot');
    var fine = window.matchMedia('(hover: hover) and (pointer: fine)');
    {%- comment -%} The dot chases pointermove with a transitioned transform, composited over a
       strip that is already carrying blends, filters and masks. Chromium keeps up; Safari does
       not, and the lag reads as the drag itself being slow. There it keeps the native grab
       cursor instead, which costs nothing. navigator.vendor is the reliable split: Apple on
       Safari, Google on Chrome, even on the same machine. {%- endcomment -%}
    var isSafari = /apple/i.test(navigator.vendor || '') &&
                   !/chrome|chromium|edg|opr/i.test(navigator.userAgent);
    if (dot && isSafari) dot.hidden = true;          // inert either way, but keep it out of the tree
    if (dot && fine.matches && !isSafari) {
      wrap.classList.add('has-dot');
      wrap.addEventListener('pointerenter', function (e) {
        if (e.pointerType === 'touch') return;
        mvX = e.clientX; mvY = e.clientY; mvTouch = false; tick();
        // no trailing lag on the way in, or it flies across from wherever it was last parked
        var t = dot.style.transition; dot.style.transition = 'none'; void dot.offsetWidth;
        dot.style.transition = t;
        dot.classList.add('is-on');
      });
      wrap.addEventListener('pointerleave', function () {
        if (!dragging) dot.classList.remove('is-on');   // capture keeps it alive through a drag
      });
      wrap.addEventListener('pointerdown', function (e) {
        if (e.pointerType !== 'touch') dot.classList.add('is-down');
      });
    }

    // ---- click a converted frame to open it full screen ---------------------------------------
    // Only the converted side is clickable: left of the changeover the frame is still a negative,
    // and blowing that up would be showing the reader the problem rather than the picture. The
    // masks that split the two sides do NOT clip hit testing, so which side a click landed on has
    // to come from the geometry, not from the event target.
    //
    // PhotoSwipe is already loaded for the scan gallery and its zoom-from-thumbnail animation is
    // exactly the "grow out of the strip" behaviour wanted here, so the clicked frame is handed
    // over as the thumb rather than any of this being animated by hand.
    var posLayer = wrap.querySelector('.ts-conv__layer--pos');
    var downCX = 0, downCY = 0;
    wrap.addEventListener('pointerdown', function (e) { downCX = e.clientX; downCY = e.clientY; });

    // The strip tiles a small pool of photos across every frame, so the same picture is on screen
    // several times over. Collapse them by source, or the viewer pages through five copies of one
    // shot, which is the bug the gallery's JSON dataSource exists to avoid.
    function collectFrames() {
      var seen = {}, slides = [], els = [], map = new Map();
      posLayer.querySelectorAll('.ts-conv__item').forEach(function (fig) {
        var img = fig.querySelector('.ts-conv__win img');
        if (!img) return;
        var full = img.getAttribute('data-full') || img.currentSrc || img.src;
        if (!full) return;
        if (seen[full] === undefined) {
          seen[full] = slides.length;
          // naturalWidth is density-corrected when srcset uses x descriptors, so it lies here;
          // the markup carries the real size of the full-size file instead
          slides.push({ src: full,
                        // The strip's own 440px file, shown scaled up for the whole zoom and
                        // swapped for the full-size one only once that has finished loading.
                        // Without it the viewer opens on nothing and the picture flicks in.
                        msrc: img.currentSrc || img.src,
                        width:  parseInt(img.getAttribute('data-fw'), 10) || img.naturalWidth,
                        height: parseInt(img.getAttribute('data-fh'), 10) || img.naturalHeight,
                        // Only matters for scans that are not 3:2; the gate itself is 36 x 24 now,
                        // so a 3:2 photo fills it exactly and nothing is cropped.
                        thumbCropped: true });
          els.push(fig.querySelector('.ts-conv__win') || fig);
        }
        map.set(fig, seen[full]);
      });
      return { slides: slides, els: els, map: map };
    }

    function openViewer(fig) {
      if (viewerOpen) return;
      if (typeof PhotoSwipeLightbox === 'undefined' || typeof PhotoSwipe === 'undefined') return;
      var data = collectFrames();
      var idx = data.map.get(fig);
      if (idx === undefined || !data.slides.length) return;
      // grow out of the frame actually clicked, not whichever copy of it was collected first
      data.els[idx] = fig.querySelector('.ts-conv__win') || fig;

      viewerOpen = true;
      stop();
      // Park on what is painted rather than on the transition's target, so the frame is still
      // where the reader clicked it when the viewer animates back into it on close.
      offset = paintedOffset();
      each(function (t) { t.style.transition = 'none'; });
      apply();

      var lb = new PhotoSwipeLightbox({
        dataSource: data.slides,
        pswpModule: PhotoSwipe,
        loop: true,
        zoom: true,
        wheelToZoom: true,
        showHideAnimationType: 'zoom',
        bgOpacity: 0.96,
        padding: { top: 24, bottom: 24, left: 24, right: 24 }
      });
      // with an array dataSource PhotoSwipe has no thumbnail to work from, so point it at ours
      lb.addFilter('thumbEl', function (el, slideData, i) { return data.els[i] || el; });
      // The frame the reader clicked is emptied while the viewer is up, so the picture reads as
      // having been lifted off the strip rather than copied from it: the gate is left showing bare
      // film. Hidden as the zoom begins and put back only once the closing animation has landed
      // the image back in the gate, so neither end of the trip shows two of the same photo.
      var liftedImg = fig.querySelector('.ts-conv__win img');
      // firstUpdate fires before the zoom has painted anything, so hiding there emptied the gate
      // for a frame or two before the rising image appeared: that gap was the flicker. Wait for
      // the animation to start AND for one frame to land, so the picture is already covering the
      // gate at the moment the original underneath it goes.
      lb.on('openingAnimationStart', function () {
        // Two frames, not one: openingAnimationStart fires before the rising image has been laid
        // out, so a single rAF can still empty the gate in a paint where nothing covers it. That
        // was the black flash. The cost is one extra frame of the original sitting underneath a
        // picture that exactly covers it, which is invisible.
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            if (liftedImg) liftedImg.style.visibility = 'hidden';
          });
        });
      });
      lb.on('destroy', function () {
        if (liftedImg) liftedImg.style.visibility = '';
        viewerOpen = false;
        start();
      });
      lb.init();
      lb.loadAndOpen(idx);
    }

    // Fetch the full-size file while the pointer is still hovering, so the viewer has it decoded
    // by the time it opens. Only the converted side, and each file only once.
    var prefetched = {};
    function prefetchAt(x, y) {
      if (!posLayer || !cutPx) return;
      if (x - wrap.getBoundingClientRect().left < cutPx) return;
      var hits = document.elementsFromPoint(x, y);
      for (var i = 0; i < hits.length; i++) {
        var f = hits[i].closest ? hits[i].closest('.ts-conv__item') : null;
        if (!f || !posLayer.contains(f)) continue;
        var im = f.querySelector('.ts-conv__win img');
        var full = im && im.getAttribute('data-full');
        if (!full || prefetched[full]) return;
        prefetched[full] = 1;
        var pre = new Image();
        pre.decoding = 'async';
        pre.src = full;
        return;
      }
    }
    // Only after the pointer has settled on one frame. Firing per move meant sweeping the strip
    // queued a full-size file for every frame crossed, which is nothing at 1000px originals and
    // tens of megabytes once real scans are uploaded. Also respects Data Saver.
    var hoverTimer = null, hoverFrame = null;
    wrap.addEventListener('pointermove', function (e) {
      if (e.pointerType === 'touch' || dragging || viewerOpen) return;
      var conn = navigator.connection;
      if (conn && conn.saveData) return;
      var x = e.clientX, y = e.clientY;
      var f = null, hits = document.elementsFromPoint(x, y);
      for (var i = 0; i < hits.length; i++) {
        var c = hits[i].closest ? hits[i].closest('.ts-conv__item') : null;
        if (c && posLayer && posLayer.contains(c)) { f = c; break; }
      }
      if (f === hoverFrame) return;                 // still on the same frame, timer already set
      hoverFrame = f;
      clearTimeout(hoverTimer);
      if (!f) return;
      hoverTimer = setTimeout(function () { prefetchAt(x, y); }, 140);
    }, { passive: true });

    wrap.addEventListener('click', function (e) {
      if (!posLayer || !cutPx) return;
      // releasing a drag also fires a click; only a release that stayed put is a click on a photo
      if (Math.abs(e.clientX - downCX) > 6 || Math.abs(e.clientY - downCY) > 6) return;
      if (e.clientX - wrap.getBoundingClientRect().left < cutPx) return;
      // the negative layer sits above the positive one, so walk the whole hit stack
      var hits = document.elementsFromPoint(e.clientX, e.clientY);
      for (var i = 0; i < hits.length; i++) {
        var f = hits[i].closest ? hits[i].closest('.ts-conv__item') : null;
        if (f && posLayer.contains(f)) { openViewer(f); return; }
      }
    });

    // Warm every frame two viewports out so nothing pops in on a cold cache. The files are
    // already in the markup; this just makes sure the fetch has happened before they matter.
    var warmed = false;
    function warm() {
      if (warmed) return;
      warmed = true;
      var seen = {};
      wrap.querySelectorAll('.ts-conv__win img').forEach(function (img) {
        var src = img.currentSrc || img.src;
        if (!src || seen[src]) return;
        seen[src] = 1;
        var pre = new Image();
        pre.decoding = 'async';
        pre.src = src;
      });
    }
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (es) {
        es.forEach(function (e) { if (e.isIntersecting) warm(); });
      }, { rootMargin: '200% 0px' }).observe(wrap);
      new IntersectionObserver(function (es) {
        es.forEach(function (e) { e.isIntersecting ? start() : stop(); });
      }, { threshold: 0 }).observe(wrap);
    } else { warm(); start(); }
    document.addEventListener('visibilitychange', function () { document.hidden ? stop() : start(); });
    window.addEventListener('resize', function () {
      if (dragging) return;
      offset = 0; each(function (t) { t.style.transition = 'none'; }); centreLead();
    }, { passive: true });
    centreLead();
  })();

  /* headline showcase accordion, one open at a time; the media panel follows the open item */
  (function () {
    document.querySelectorAll('.tonescan-landing .ts-acc').forEach(function (acc) {
      var items = acc.querySelectorAll('.ts-acc__item');
      var shots = acc.querySelectorAll('.ts-acc__shot');
      if (!items.length) return;
      function open(i) {
        items.forEach(function (it, ii) {
          var on = ii === i;
          it.classList.toggle('is-open', on);
          it.querySelector('.ts-acc__trigger').setAttribute('aria-expanded', on ? 'true' : 'false');
        });
        shots.forEach(function (s, si) { s.classList.toggle('is-active', si === i); });
      }
      items.forEach(function (it, i) {
        it.querySelector('.ts-acc__trigger').addEventListener('click', function () {
          // clicking the open one keeps it open, there is always a shot on screen to match
          open(i);
        });
      });
    });
  })();

  /* Workflow story, REVERSED: the copy block that reaches the middle of the viewport drives which
     pinned shot is shown, rather than the media driving the copy. Runs on the same rig as the RGB
     section above. It used to carry its own snap, which had the direction filter and the missing
     retry that were found and fixed there; sharing the rig means it cannot drift back out of step.
     --sp is 0 -> 1 progress through the section, for the background blobs, so they keep drifting
     while you are between two steps. */
  (function () {
    document.querySelectorAll('.tonescan-landing .ts-story-sec').forEach(function (sec) {
      var panels = Array.prototype.slice.call(sec.querySelectorAll('.ts-story__panel'));
      var shots  = Array.prototype.slice.call(sec.querySelectorAll('.ts-story__shot'));
      if (!panels.length || !shots.length) return;

      var dots  = Array.prototype.slice.call(sec.querySelectorAll('.ts-story__dot'));
      var media = tsStage(sec.querySelector('.ts-story__stage'), dots, shots);

      // Measure the copy, not the panel. On desktop they share a centre, but on mobile the panel
      // carries its own poster above the text and centring the box would push the words off.
      function inner(p) { return p.querySelector('.ts-story__panelinner') || p; }
      function centreOf(i) {
        var r = inner(panels[i]).getBoundingClientRect();
        return window.pageYOffset + r.top + r.height / 2;
      }
      // Plain viewport centre, not the area below the header: these blocks are a full viewport
      // tall, so there is already room above the copy. The RGB section allows for the header
      // because its copy column starts hard against the top of the pinned region.
      function vh() { return window.innerHeight || document.documentElement.clientHeight; }
      function restOf(i) { return centreOf(i) - vh() / 2; }

      var rig = tsPinRig({
        el: sec,
        // no snapping under reduced motion; the shots still swap, the page is just never moved
        snap: !window.matchMedia('(prefers-reduced-motion: reduce)').matches,
        rests: function () { return panels.map(function (p, i) { return restOf(i); }); },
        frame: function (r, H) {
          // 0 as the section's top reaches the bottom of the screen, 1 as its bottom leaves the top
          var sp = (H - r.top) / (H + r.height);
          sec.style.setProperty('--sp', (sp < 0 ? 0 : sp > 1 ? 1 : sp).toFixed(4));

          var best = -1, bestD = Infinity;
          panels.forEach(function (p, i) {
            var pr = inner(p).getBoundingClientRect();
            var d = Math.abs((pr.top + pr.height / 2) - H / 2);
            if (d < bestD) { bestD = d; best = i; }
          });
          if (best >= 0) media.set(best);
          return false;
        }
      });

      dots.forEach(function (d, di) {
        d.addEventListener('click', function () { rig.glide(restOf(di), 950); });
      });

      rig.kick();
    });
  })();

  /* feature video modal, the "+" on each headline bento tile.
     data-video is empty until the clips are recorded, so fall back to the poster plus a note
     rather than opening an empty player. Adding the URL is the only change needed later. */
  (function () {
    var modal = document.querySelector('.tonescan-landing .ts-vid');
    if (!modal) return;
    var stage = modal.querySelector('.ts-vid__stage');
    var title = modal.querySelector('.ts-vid__title');
    var lastFocus = null;

    function close() {
      modal.hidden = true;
      stage.innerHTML = '';           // stops playback
      document.body.style.overflow = '';
      if (lastFocus && lastFocus.focus) lastFocus.focus();
    }
    function open(btn) {
      lastFocus = btn;
      var src = (btn.getAttribute('data-video') || '').trim();
      var poster = btn.getAttribute('data-poster') || '';
      var name = btn.getAttribute('data-title') || '';
      title.textContent = name;
      if (src) {
        stage.innerHTML = '<video controls autoplay playsinline muted loop poster="' + poster +
          '" src="' + src + '"></video>';
      } else {
        stage.innerHTML = '<img src="' + poster + '" alt="' + name + '">' +
          '<p class="ts-vid__soon">Walkthrough video coming soon</p>';
      }
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      modal.querySelector('.ts-vid__close').focus();
    }

    // The whole card is the target, the "+" is only an affordance (and the keyboard handle,
    // since its click bubbles up to the card listener below).
    document.querySelectorAll('.tonescan-landing .ts-bento').forEach(function (card) {
      var btn = card.querySelector('.ts-feature-more');
      if (!btn) return;
      var downX = null, downY = null;
      card.addEventListener('pointerdown', function (e) { downX = e.clientX; downY = e.clientY; });
      card.addEventListener('click', function (e) {
        if (e.target.closest('a')) return;   // the CTA navigates; it doesn't open the overlay
        // Releasing a text-selection drag inside the card still fires a click. Only treat it
        // as a deliberate tap when nothing got selected and the pointer barely moved.
        var sel = window.getSelection();
        if (sel && !sel.isCollapsed && sel.toString().length) return;
        if (downX !== null && (Math.abs(e.clientX - downX) > 4 || Math.abs(e.clientY - downY) > 4)) return;
        open(btn);
      });
    });
    modal.querySelectorAll('[data-close]').forEach(function (b) { b.addEventListener('click', close); });
    document.addEventListener('keydown', function (e) {
      if (!modal.hidden && e.key === 'Escape') close();
    });
  })();

  /* hero scroll, screenshot grows slightly; scattered floats converge inward (--p on .ts-hero) */
  (function () {
    var frame = document.querySelector('.tonescan-landing .ts-hero');
    if (!frame) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var scaler = frame.querySelector('.ts-hero-glass');
    var colour = document.querySelector('.tonescan-landing .ts-hero-color');
    var text = frame.querySelector('.ts-hero-text');
    var clamp = function (v) { return v < 0 ? 0 : (v > 1 ? 1 : v); };
    var ticking = false;
    // Pin the text where it already sits so it never travels, it only shrinks and fades.
    // The old version read rect.top and bailed unless we were at scroll 0, so a deep link
    // (or any load below the fold) left the sticky offset at the CSS default and the text
    // slid upward before catching. Measuring in DOCUMENT space works at any scroll position;
    // position:static during the read stops a stuck element reporting its stuck offset.
    function pin() {
      if (!text) return;
      var prevPos = text.style.position;
      text.style.position = 'static';
      var docTop = text.getBoundingClientRect().top + (window.pageYOffset || 0);
      text.style.position = prevPos;
      text.style.top = Math.round(docTop) + 'px';
    }
    pin();
    // set --drop so floats converge onto the frame's lower edge (hide behind the screenshot),
    // not the middle of the page, robust across viewport heights.
    var glassFrame = frame.querySelector('.ts-hero-frame');
    function setDrop() {
      if (!glassFrame) return;
      var heroH = frame.offsetHeight;
      var anchorY = 0.44 * heroH;                                   // matches .hero-float top:44%
      var target = glassFrame.offsetTop + glassFrame.offsetHeight * 0.86; // ~lower edge of the frame
      frame.style.setProperty('--drop', Math.max(0, Math.round(target - anchorY)) + 'px');
    }
    setDrop();
    function onLayout() { pin(); setDrop(); }
    window.addEventListener('load', onLayout);
    window.addEventListener('resize', onLayout);
    function update() {
      var vh = window.innerHeight || document.documentElement.clientHeight;
      var p = clamp(window.pageYOffset / (vh * 0.85));
      frame.style.setProperty('--p', p.toFixed(3));
      // particles live on .ts-hero-color (a parent of .ts-hero), so they can't inherit --p
      if (colour) colour.style.setProperty('--pp', p.toFixed(3));
      if (scaler) {
        // scale 0.8 -> 1.0 as the frame enters from the bottom; full size once 70% has
        // entered, then HOLD (monotonic on the way down, doesn't shrink as it exits the top)
        var r = scaler.getBoundingClientRect();
        var g = r.height > 0 ? clamp((vh - r.top) / (0.7 * r.height), 0, 1) : 1;
        scaler.style.setProperty('--hs', (0.8 + 0.2 * g).toFixed(3));
      }
    }
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () { update(); ticking = false; });
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  })();

  /* hero feature selector, crossfade the framed shot. Desktop = tab pills, mobile = <select> + dots. */
  (function () {
    var hero = document.querySelector('.tonescan-landing .ts-hero-color');
    var bar = document.querySelector('.tonescan-landing .ts-hero-selectbar');
    if (!hero || !bar) return;
    var shots = hero.querySelectorAll('.ts-hero-shot');
    var tabs = bar.querySelectorAll('.ts-hero-tab');
    var dots = bar.querySelectorAll('.ts-hero-dot');
    var select = bar.querySelector('.ts-hero-select');
    var frame = document.querySelector('.tonescan-landing .ts-hero-frame');
    var video = hero.querySelector('.ts-hero-video');
    var current = 0;

    function show(i, fromAuto) {
      i = (i + shots.length) % shots.length;
      current = i;
      tabs.forEach(function (t, ti) { var on = ti === i; t.classList.toggle('is-active', on); t.setAttribute('aria-selected', on ? 'true' : 'false'); });
      dots.forEach(function (d, di) { d.classList.toggle('is-active', di === i); });
      shots.forEach(function (s, si) { s.classList.toggle('is-active', si === i); });
      if (select && +select.value !== i) select.value = i;
      if (window.__tsHeroVideoSync) window.__tsHeroVideoSync(); // play/pause the Develop video with its slot
      if (fromAuto) scheduleAuto(); else stopAuto();            // any manual pick ends the rotation
    }

    // Auto-advance every 10s, until the visitor picks something themselves, carousels that
    // keep moving after you've made a choice just fight you.
    var AUTO_MS = 10000, autoTimer = null, autoStopped = false;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function stopAuto() { autoStopped = true; clearTimeout(autoTimer); }
    function scheduleAuto() {
      if (autoStopped || reduce) return;
      clearTimeout(autoTimer);
      autoTimer = setTimeout(tick, AUTO_MS);
    }
    function tick() {
      if (autoStopped) return;
      // don't cut the Develop clip off part-way through, wait for it to finish
      if (video && shots[0] && shots[0].classList.contains('is-active') && !video.paused && !video.ended) {
        autoTimer = setTimeout(tick, 1000);
        return;
      }
      show(current + 1, true);
    }

    tabs.forEach(function (t, ti) { t.addEventListener('click', function () { show(ti); }); });
    if (select) select.addEventListener('change', function () { show(+select.value); });
    var prev = document.querySelector('.tonescan-landing .ts-hero-nav--prev');
    var next = document.querySelector('.tonescan-landing .ts-hero-nav--next');
    if (prev) prev.addEventListener('click', function () { show(current - 1); });
    if (next) next.addEventListener('click', function () { show(current + 1); });

    // Both arrows or neither. The split hero runs its media off the right-hand edge, so the
    // next arrow ends up outside the viewport and only the prev one is left on screen, which
    // reads as a broken control rather than a pair. Measured off the frame, not the buttons,
    // so hiding them does not change the answer on the next pass.
    function fitNav() {
      if (!frame || !prev || !next) return;
      var r = frame.getBoundingClientRect();
      var vw = document.documentElement.clientWidth;
      // prev sits at left:-56px, next at right:-56px, both 44px wide
      var fits = r.left - 56 >= 0 && r.right + 56 <= vw;
      frame.classList.toggle('has-no-nav', !fits);
    }

    // Centre the feature tabs under the screenshot rather than under the page, so the row reads as
    // belonging to the image above it instead of floating under the whole layout. Only when it
    // fits there: a row shoved against the window edge to stay centred looks worse than one
    // centred on the page, so that case falls back. Split hero only, and only where it is actually
    // two columns; the centred hero has nothing to line up against.
    var tabrow = bar.querySelector('.ts-hero-tabs');
    var split = document.querySelector('.tonescan-landing .ts-hero-split');
    var TAB_GAP = 8, EDGE = 50;   // the row's own gap, and the air kept at the window edge
    function fitTabs() {
      if (!frame || !tabrow || !split || !tabs.length) return;
      tabrow.style.paddingLeft = '';
      tabrow.classList.remove('is-aligned');
      if (!window.matchMedia('(min-width: 900px)').matches) return;
      var vw = document.documentElement.clientWidth;
      var rowL = tabrow.getBoundingClientRect().left;
      var f = frame.getBoundingClientRect();
      var natural = 0;
      tabs.forEach(function (t, i) { natural += t.getBoundingClientRect().width + (i ? TAB_GAP : 0); });
      // Centre on the VISIBLE part of the image. The frame deliberately runs off the right of the
      // page, so centring on its full box would push the row half off screen with it.
      var centre = (Math.max(f.left, 0) + Math.min(f.right, vw)) / 2;
      var left = centre - natural / 2;
      if (left >= rowL && left + natural <= vw - EDGE) {
        tabrow.style.paddingLeft = (left - rowL) + 'px';
        tabrow.classList.add('is-aligned');
      }
    }

    function fit() { fitNav(); fitTabs(); }
    fit();
    window.addEventListener('resize', fit, { passive: true });

    // hold while the pointer is over the media, so it can't swap out from under a reader
    if (frame) {
      frame.addEventListener('mouseenter', function () { clearTimeout(autoTimer); });
      frame.addEventListener('mouseleave', scheduleAuto);
    }
    scheduleAuto();
  })();

  /* hero Develop video, autoplay (muted) when the hero is in view AND its slot is active;
     replay button overlays when it ends. Honours reduced-motion (no autoplay; shows Play). */
  (function () {
    var video = document.querySelector('.tonescan-landing .ts-hero-video');
    if (!video) return;
    var slot = video.closest('.ts-hero-shot');
    var replay = document.querySelector('.tonescan-landing .ts-hero-replay');
    var label = replay ? replay.querySelector('.ts-hero-replay__label') : null;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var inView = false, ended = false;
    function activeSlot() { return slot && slot.classList.contains('is-active'); }
    function sync() {
      if (!reduce && inView && activeSlot() && !ended) { var p = video.play(); if (p && p.catch) p.catch(function () {}); }
      else { video.pause(); }
    }
    video.addEventListener('ended', function () { ended = true; if (label) label.textContent = 'Replay'; if (replay) replay.classList.add('is-shown'); });
    if (replay) replay.addEventListener('click', function () { ended = false; replay.classList.remove('is-shown'); video.currentTime = 0; var p = video.play(); if (p && p.catch) p.catch(function () {}); });
    if (reduce && replay) { if (label) label.textContent = 'Play'; replay.classList.add('is-shown'); } // opt-in under reduced motion
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (es) { es.forEach(function (e) { inView = e.isIntersecting; sync(); }); }, { threshold: 0.3 }).observe(video);
    } else { inView = true; sync(); }
    window.__tsHeroVideoSync = sync;
  })();

  /* beta signup, POST the email to the Cloudflare Worker (double opt-in; the Worker owns all
     key/confirm logic). Do NOT change the fetch URL, the { email } body, or the status handling. */
  (function () {
    var TS_SIGNUP_URL = "https://tonescan-beta-signup.little-pond-7bea.workers.dev/signup";
    var forms = document.querySelectorAll('.tonescan-landing .ts-signup');
    if (!forms.length) return;
    forms.forEach(function (root) {
      var form = root.querySelector('.ts-form');
      var email = root.querySelector('.ts-email');
      var btn = root.querySelector('.ts-btn');
      var msg = root.querySelector('.ts-msg');
      if (!form) return;
      function say(text, kind) { msg.textContent = text; msg.className = 'ts-msg ' + (kind || ''); }
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var value = (email.value || '').trim();
        if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(value)) { say('Please enter a valid email.', 'err'); return; }
        btn.disabled = true;
        say('Sending…');
        fetch(TS_SIGNUP_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: value })
        })
          .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
          .then(function (res) {
            if (!res.ok) throw new Error(res.d && res.d.error);
            if (res.d.status === 'already_issued')
              say("You've already got a key, check your inbox (and spam).", 'ok');
            else
              say("Almost there! Check your email to confirm and we'll send your key.", 'ok');
            form.reset();
          })
          .catch(function () { say('Something went wrong. Please try again.', 'err'); })
          .finally(function () { btn.disabled = false; });
      });
    });
  })();
}
if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', tsInit);
else tsInit();
})();
</script>
