  (function () {
    var sec = document.querySelector('.tonescan-landing .ts-pricing');
    if (!sec) return;

    // Hostname only, and deliberately not the same test as the state switcher, which also turns on
    // with ?mockup=1 and therefore works on the live domain. Anything that can attach a real
    // discount id to a real checkout has to be unreachable in production.
    var tsLocalDev = /^(127\.0\.0\.1|localhost)$/.test(location.hostname);
    // Parsed once, up here, because the dev switcher reads it well before the price driver runs.
    var q0;
    try { q0 = new URLSearchParams(location.search); } catch (e) { q0 = new URLSearchParams(''); }
    // Set once the price driver is up. Lets the switcher below re-run the price lookup under a
    // pretend offer; null until then, and null forever if Paddle never loads.
    var applyMockOffer = null;

    // ---- the confirmation, lifted from the fulfilment Worker's checkout page ------------------
    // The licence is minted asynchronously by the webhook, so the key is polled for rather than
    // being in the redirect. Ported rather than reinvented: the shimmer-then-scramble reveal, the
    // minimum shimmer, and the visibility-aware give-up all exist because of how that page
    // behaves in the real world, and reimplementing them would relearn the same lessons.
    var done = sec.querySelector('.ts-pricing__done');
    var main = sec.querySelector('.ts-pricing__main');
    var HEX = '0123456789ABCDEF';
