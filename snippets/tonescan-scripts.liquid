      wrap.querySelector('.ts-done__dlmain').href = base + b.href;
      var menu = wrap.querySelector('.ts-done__dlmenu');
      var html = '';
      ['mac', 'win'].forEach(function (k) {
        if (k === pick) return;
        html += '<a href="' + base + BUILDS[k].href + '">' + BUILDS[k].icon + '<span>' + BUILDS[k].menu + '</span></a>';
      });
