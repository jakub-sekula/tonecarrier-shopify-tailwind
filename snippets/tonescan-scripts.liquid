     Every slot gets its own driver. This used to querySelector a single video and a single replay
     button, which worked only because there was one video block: a second one rendered fine and
     then simply never played, because nothing was wired to it. The markup was always per-block. */
  (function () {
    var hero = document.querySelector('.tonescan-landing .ts-hero-color');
    var videos = hero ? Array.prototype.slice.call(hero.querySelectorAll('.ts-hero-video')) : [];
    if (!videos.length) return;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var syncs = [];

    // ONE observer, on the hero, not one per video.
    //
    // This is what stopped the later clips playing. An inactive slot is not rendered, so an
    // observer watching the video itself never reports it as intersecting, and the gate stayed
    // shut for every video except the one visible at load. Whether the hero is on screen is a
    // property of the hero, so that is what gets watched; which clip should run is decided by
    // its slot's class.
    var heroInView = false;
