      var intro = done.querySelector('.ts-done__intro');
      var to = email || 'your email address';
      // No box: there is no key to show, and a box holding a sentence still reads as a key field.
      // The panel's min-height keeps the section from resizing, and the copy is centred in it, so
      // dropping this leaves no hole.
      code.textContent = '';
      code.hidden = true;
      // One sentence per line, so no line breaks through the middle of a phrase. The heading
      // already says the payment landed, so neither of these repeats the thank you.
      // Expired is a different situation to slow: the key exists and was already sent, it is just
      // no longer safe to hand out from a URL the buyer may have kept.
      intro.innerHTML = why === 'expired'
        ? 'Your key was issued earlier.<br>We have sent your key via email to ' + esc(to) + '.'
        : 'It&rsquo;s taking longer than usual to get your key.<br>We will send it via email to ' + esc(to) + '.';
