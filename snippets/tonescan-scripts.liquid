      if (!t) return;
      var v = t.getAttribute(which === 'busy' ? 'data-heading-busy' : 'data-heading-done');
      // innerHTML, not textContent: the success heading carries a <br> so "Thank you" sits on
      // its own line. Both values are theme settings, the same trust level as any other setting
      // this page renders.
      if (v) t.innerHTML = v;
    }

    var idleIv = null;
    function startIdle(el) {
