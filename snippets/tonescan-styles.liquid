  .ts-hero { --p: 0; }
  /* force the headline to break after the comma on narrow screens instead of mid-phrase */
  @media (min-width: 750px) { .ts-hero-br { display: none; } }
  /* COLOURFUL hero region, its bottom edge is the SHARP CUT to the page black (#0a0a0b). */
  .ts-hero-icon { width: 76px; height: 76px; margin-bottom: -8px; display: block; }
  @media (min-width: 768px) { .ts-hero-icon { width: 104px; height: 104px; margin-bottom: -6px; } }
  @media (prefers-reduced-motion: no-preference) { .ts-hero-icon { filter: drop-shadow(0 14px 34px rgba(0,0,0,.55)); } }

  .ts-hero-color {
    position: relative;
    isolation: isolate;              /* keeps .ts-hero-bg's negative z-index inside the hero */
    background:
      radial-gradient(70% 55% at 12% 4%,  rgba(60,78,130,.22) 0%, transparent 70%),    /* cool top-left lift */
      radial-gradient(66% 52% at 92% 8%,  rgba(48,64,112,.18) 0%, transparent 70%),    /* cool top-right lift */
      radial-gradient(96% 76% at 50% 62%, rgba(30,86,190,.30) 0%, transparent 72%),    /* main blue pool */
      linear-gradient(180deg, #070709 0%, #070709 55%, #08080a 100%);                  /* near-black base */
  }
  /* ---- hero particles: three static tiled starfield layers ----
     Deliberately NOT animated. Drifting these by background-position repaints the whole
