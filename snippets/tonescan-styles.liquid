     compositor so the layers slide without repainting all those gradients. */
  .ts-hero-particles span { position: absolute; inset: -18% 0; display: block; background-repeat: repeat; will-change: transform; }
  .ts-hero-particles .p1 {
    background-image:
        radial-gradient(1px 1px at 32.4% 15.1%, rgba(255,255,255,0.22) 0%, transparent 100%),
        radial-gradient(1px 1px at 53.6% 36.6%, rgba(255,255,255,0.43) 0%, transparent 100%),
        radial-gradient(1px 1px at 21.5% 8.6%, rgba(255,255,255,0.22) 0%, transparent 100%),
        radial-gradient(1px 1px at 9.1% 42.5%, rgba(255,255,255,0.23) 0%, transparent 100%),
        radial-gradient(1px 1px at 22.3% 62.7%, rgba(255,255,255,0.34) 0%, transparent 100%),
        radial-gradient(1px 1px at 39.7% 97.6%, rgba(255,255,255,0.34) 0%, transparent 100%),
        radial-gradient(1px 1px at 13.3% 41.9%, rgba(255,255,255,0.23) 0%, transparent 100%),
        radial-gradient(1px 1px at 30.8% 81.6%, rgba(255,255,255,0.23) 0%, transparent 100%),
        radial-gradient(1px 1px at 57.1% 18.8%, rgba(255,255,255,0.34) 0%, transparent 100%),
        radial-gradient(1px 1px at 6.3% 6.0%, rgba(255,255,255,0.32) 0%, transparent 100%),
        radial-gradient(1px 1px at 53.2% 77.7%, rgba(255,255,255,0.35) 0%, transparent 100%),
        radial-gradient(1px 1px at 45.3% 30.0%, rgba(255,255,255,0.37) 0%, transparent 100%),
        radial-gradient(1px 1px at 24.4% 57.4%, rgba(255,255,255,0.32) 0%, transparent 100%),
        radial-gradient(1px 1px at 34.3% 44.9%, rgba(255,255,255,0.45) 0%, transparent 100%),
        radial-gradient(1px 1px at 11.8% 41.8%, rgba(255,255,255,0.24) 0%, transparent 100%),
        radial-gradient(1px 1px at 48.9% 3.9%, rgba(255,255,255,0.39) 0%, transparent 100%),
        radial-gradient(1px 1px at 57.3% 87.5%, rgba(255,255,255,0.29) 0%, transparent 100%),
        radial-gradient(1px 1px at 35.0% 49.7%, rgba(255,255,255,0.22) 0%, transparent 100%),
        radial-gradient(1px 1px at 9.4% 27.0%, rgba(255,255,255,0.22) 0%, transparent 100%),
        radial-gradient(1px 1px at 70.1% 64.7%, rgba(255,255,255,0.27) 0%, transparent 100%),
        radial-gradient(1px 1px at 38.6% 66.9%, rgba(255,255,255,0.44) 0%, transparent 100%),
        radial-gradient(1px 1px at 35.5% 61.1%, rgba(255,255,255,0.21) 0%, transparent 100%),
        radial-gradient(1px 1px at 76.8% 12.9%, rgba(255,255,255,0.3) 0%, transparent 100%),
        radial-gradient(1px 1px at 91.7% 49.7%, rgba(255,255,255,0.31) 0%, transparent 100%),
        radial-gradient(1px 1px at 54.9% 88.3%, rgba(255,255,255,0.42) 0%, transparent 100%),
        radial-gradient(1px 1px at 27.8% 41.5%, rgba(255,255,255,0.37) 0%, transparent 100%);
    background-size: 780px 620px; }
  .ts-hero-particles .p2 {
    background-image:
