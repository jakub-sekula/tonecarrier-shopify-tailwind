  @media (prefers-reduced-motion: reduce) { .ts-hero-particles span { transform: none; } }

  /* hero text/CTAs pin (sticky), then the frame scrolls up OVER them and hides them (GitHub-style).
     z-order: floats (-1) < text (0) < frame (1). Fade is a safety net so the text can't reappear
     after the frame passes above it. */
  /* pinned from the top (JS sets `top` to the text's natural offset so it doesn't scroll before
     sticking, GitHub-style). Shrinks + fades as --p grows and the frame rises to cover it. */
  .ts-hero-text { position: sticky; top: 80px; z-index: 0; opacity: calc(1 - var(--p) * 2.2); transform: scale(calc(1 - var(--p) * 0.08)); transform-origin: center top; will-change: opacity, transform; }
  /* The frame sits flush ON the colour cut rather than dipping past it: the media is shown
     whole, and the hard bottom edge (square corners, no border) is what makes the handoff to
     the black block below read as a deliberate cut. */
  .ts-hero-frame { position: relative; z-index: 1; margin-bottom: 0; }
  /* Glow discs behind the hero frame, switched off. Rules below are kept intact: drop this
     display line to bring them back. */
  .ts-hero-glow { display: none; }
  .ts-hero-glow { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .ts-hero-glow::before, .ts-hero-glow::after { content: ''; position: absolute; border-radius: 50%; aspect-ratio: 1; filter: blur(90px); }
  .ts-hero-glow::before { left: 30%; top: 46%; width: 52%; transform: translate(-50%, -50%); background: rgba(59,130,246,.30); }
  .ts-hero-glow::after { left: 70%; top: 56%; width: 44%; transform: translate(-50%, -50%); background: rgba(56,189,248,.18); }
  .ts-hero-glass { position: relative; z-index: 1; padding: 16px 16px 0; border: 1px solid rgba(255,255,255,.16); border-bottom: 0; border-radius: 10px 10px 0 0; background: rgba(255,255,255,.05); box-shadow: 0 30px 90px -30px rgba(0,0,0,.85); transform: scale(var(--hs, 0.8)); transform-origin: center bottom; will-change: transform; }
  /* 16/10 matches both the screenshots (3200x2000) and the Develop video (2000x1250), so
     nothing is cropped. Rounded on top, square on the bottom. */
  .ts-hero-stage { position: relative; width: 100%; aspect-ratio: 16 / 10; overflow: hidden; border-radius: 3px 3px 0 0; background: #0f0f10; }
  .ts-hero-shot { position: absolute; inset: 0; opacity: 0; transition: opacity .5s ease; }
  .ts-hero-shot.is-active { opacity: 1; }
  img.ts-hero-shot { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
  /* video slot (Develop) */
  .ts-hero-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; background: #0f0f10; }
  .ts-hero-replay { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); z-index: 3; display: none; align-items: center; gap: 8px; padding: 11px 18px; font-size: 14px; font-weight: 600; color: #fff; background: rgba(0,0,0,.6); border: 1px solid rgba(255,255,255,.28); border-radius: 3px; cursor: pointer; transition: background .15s ease; }
  .ts-hero-replay.is-shown { display: inline-flex; }
  .ts-hero-replay:hover { background: rgba(0,0,0,.78); }
  .ts-hero-replay:focus-visible { outline: 2px solid #3b82f6; outline-offset: 2px; }
  .ts-hero-replay svg { width: 16px; height: 16px; fill: currentColor; }
  /* prev/next arrows flanking the framed media. Desktop only, mobile has the dots + select. */
  .ts-hero-nav { position: absolute; top: 50%; z-index: 4; transform: translateY(-50%);
    display: none; align-items: center; justify-content: center; width: 44px; height: 44px; padding: 0;
    color: #e5e5e5; background: rgba(0,0,0,.42); border: 1px solid rgba(255,255,255,.18); border-radius: 9999px;
    cursor: pointer; backdrop-filter: blur(6px); transition: background .18s ease, border-color .18s ease, opacity .18s ease; }
  .ts-hero-nav svg { width: 20px; height: 20px; }
  .ts-hero-nav:hover { background: rgba(0,0,0,.68); border-color: rgba(255,255,255,.34); }
  .ts-hero-nav:focus-visible { outline: 2px solid #3b82f6; outline-offset: 2px; }
  .ts-hero-nav--prev { left: -56px; }
  .ts-hero-nav--next { right: -56px; }
  @media (min-width: 750px) {
    .ts-hero-nav { display: inline-flex; }
    /* 64px of clear gutter each side so the arrows never sit on the screenshot */
    .ts-hero-frame { width: calc(100% - 128px); margin-inline: auto; }
  }

  /* SELECTOR bar, on the black region below the cut; clears the dipped image with top padding */
  /* The next section starts flush against this bar, and the conversion strip brings a white
     background with it, so 8px left the tabs sitting on a hard colour change. */
  .ts-hero-selectbar { padding-top: 44px; padding-bottom: 64px; }
  .ts-hero-tabs { position: relative; z-index: 3; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
  .ts-hero-tab { padding: 8px 16px; font-size: 14px; font-weight: 500; color: #a3a3a3; background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.10); border-radius: 2px; cursor: pointer; transition: color .2s ease, background .2s ease, border-color .2s ease; }
  .ts-hero-tab.is-active { color: #fff; background: rgba(59,130,246,.14); border-color: rgba(59,130,246,.5); }
  .ts-hero-tab:hover:not(.is-active) { color: #fff; background: rgba(255,255,255,.06); }
  .ts-hero-tab:focus-visible { outline: 2px solid #3b82f6; outline-offset: 2px; }
  /* mobile selector (dots + native select): hidden on desktop */
  .ts-hero-mobsel { display: none; flex-direction: column; align-items: center; gap: 16px; }
  .ts-hero-dots { display: flex; gap: 8px; }
  .ts-hero-dot { width: 8px; height: 8px; border-radius: 9999px; background: rgba(255,255,255,.22); transition: background .2s ease, width .2s ease; }
  .ts-hero-dot.is-active { width: 22px; border-radius: 9999px; background: #e5e5e5; }
  .ts-hero-selectwrap { position: relative; width: 100%; max-width: 320px; }
  .ts-hero-select { -webkit-appearance: none; appearance: none; width: 100%; padding: 14px 44px 14px 20px; font-size: 16px; font-weight: 600; color: #fff; background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.14); border-radius: 3px; cursor: pointer; }
  .ts-hero-select:focus-visible { outline: 2px solid #3b82f6; outline-offset: 2px; }
  .ts-hero-select option { color: #111; }
  .ts-hero-selectcaret { position: absolute; right: 18px; top: 50%; transform: translateY(-50%); width: 12px; height: 8px; color: #a3a3a3; pointer-events: none; }
  @media (max-width: 749px) {
    /* Mobile: text is STATIC (no pin / fade / shrink). The screenshot used to be blown up to
       200% and shoved right so only its left edge showed, at phone width that read as a
       broken crop rather than a deliberate one. It now sits whole and centred, and the copy
       above it is tightened so the product is on screen without a full page of scrolling. */
    .ts-hero-text { position: static; opacity: 1; transform: none; }
    .ts-hero { padding-top: 44px; }
    .ts-hero-glass { transform: none; padding: 8px 8px 0; border-radius: 8px 8px 0 0; }
    .ts-hero-frame { width: 100%; max-width: none; margin: 44px 0 0; }
    .ts-hero-stage { aspect-ratio: 16 / 10; }
    img.ts-hero-shot, .ts-hero-video { object-position: top center; }
    .ts-hero-selectbar { padding-top: 36px; padding-bottom: 44px; }
    .ts-hero-tabs { display: none; }
    .ts-hero-mobsel { display: flex; }
    /* the blobs are sized in % of the region, at phone width that turns into a solid wash */
    .ts-hero-color {
      background:
        radial-gradient(80% 40% at 8% 6%,    rgba(60,78,130,.16) 0%, transparent 70%),
        radial-gradient(80% 40% at 96% 10%,  rgba(48,64,112,.14) 0%, transparent 70%),
        radial-gradient(120% 58% at 50% 56%, rgba(30,86,190,.26) 0%, transparent 72%),
        linear-gradient(180deg, #070709 0%, #070709 55%, #08080a 100%);
    }
  }
  /* z-index 0 (not -1) so the "explosion" floats sit ABOVE the colour bg but behind text/frame.
     At rest they scatter below the headline (anchor top:44%); on scroll (--p) they converge
     inward to centre AND downward (--drop, set by JS to the frame's lower edge) so they slide
     BEHIND the screenshot's bottom instead of collapsing to the middle of the page. */
  /* Parked for now. Kept in the DOM with all their positioning intact: drop the display line
     to bring them back. */
  .hero-floats { display: none; }
  .hero-floats { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .hero-float { position: absolute; left: 50%; top: 44%; width: var(--w, 160px); aspect-ratio: 3 / 2; border-radius: 2px; border: 1px solid rgba(255,255,255,.08); background-size: cover; background-position: center;
    transform: translate(-50%, -50%)
      translate(calc(var(--x) * (1 - var(--p))), calc(var(--y) * (1 - var(--p))))
      translate(0, calc(var(--drop, 55vh) * var(--p)))
      rotate(calc(var(--r, 0deg) * (1 - var(--p))))
      scale(calc(var(--s, 1) + (1 - var(--s, 1)) * var(--p)));
    filter: blur(calc(var(--blur, 0px) * (1 - var(--p))));
    opacity: calc(0.6 + 0.4 * var(--p));
    will-change: transform, filter, opacity; }
  .hero-float--1 { --x: -40vw; --y: -6vh;  --blur: 7px;  --s: .62; --r: -6deg; --w: 200px; background-image: url('https://cdn.shopify.com/s/files/1/0634/3199/9736/files/DSCF0049_RGB-neg.jpg?v=1784861626'); }
  .hero-float--2 { --x: -28vw; --y: 12vh;  --blur: 2px;  --s: .90; --r: -3deg; --w: 240px; background-image: url('https://cdn.shopify.com/s/files/1/0634/3199/9736/files/DSCF0049_RGB-pos.jpg?v=1784861626'); }
  .hero-float--3 { --x: -20vw; --y: -14vh; --blur: 9px;  --s: .55; --r: 4deg;  --w: 170px; background-image: url('https://cdn.shopify.com/s/files/1/0634/3199/9736/files/DSCF0025_RGB-neg.jpg?v=1784861626'); }
  .hero-float--4 { --x: 20vw;  --y: -14vh; --blur: 8px;  --s: .58; --r: -4deg; --w: 176px; background-image: url('https://cdn.shopify.com/s/files/1/0634/3199/9736/files/DSCF0079_RGB-neg.jpg?v=1784861626'); }
  .hero-float--5 { --x: 30vw;  --y: 6vh;   --blur: 3px;  --s: .88; --r: 5deg;  --w: 236px; background-image: url('https://cdn.shopify.com/s/files/1/0634/3199/9736/files/DSCF0079_RGB-pos.jpg?v=1784861626'); }
  .hero-float--6 { --x: 42vw;  --y: 16vh;  --blur: 7px;  --s: .64; --r: 7deg;  --w: 200px; background-image: url('https://cdn.shopify.com/s/files/1/0634/3199/9736/files/DSCF0028_RGB-neg.jpg?v=1784861626'); }
  .hero-float--7 { --x: -36vw; --y: 22vh;  --blur: 11px; --s: .50; --r: 6deg;  --w: 156px; background-image: url('https://cdn.shopify.com/s/files/1/0634/3199/9736/files/DSCF0061_RGB-pos.jpg?v=1784861626'); }
  @media (prefers-reduced-motion: reduce) {
    .hero-floats { display: none; }
    .ts-hero-text { position: static; opacity: 1; }
    .ts-hero-glass { transform: none; }
    .ts-hero-shot { transition: none; }
  }

  .ts-hero-text .ts-signup { margin-left: auto; margin-right: auto; }

  /* ---- beta signup form (dark, matches the page; POSTs to the Cloudflare Worker) ---- */
  .ts-signup { width: 100%; max-width: 480px; }
  .ts-form { display: flex; gap: 10px; flex-wrap: wrap; }
  .ts-email { flex: 1; min-width: 220px; height: 50px; padding: 0 16px; font-size: 15px; color: #fff; background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.14); border-radius: 2px; outline: none; }
  .ts-email::placeholder { color: #6a6a6a; }
  .ts-email:focus { border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59,130,246,.25); }
  .ts-btn { height: 50px; padding: 0 24px; font-size: 15px; font-weight: 600; color: #fff; cursor: pointer; background: #3b82f6; border: 0; border-radius: 2px; white-space: nowrap; transition: transform .15s ease, background .15s ease; }
  .ts-btn:hover { background: #2f6fed; transform: translateY(-1px); }
  .ts-btn:disabled { opacity: .6; cursor: default; transform: none; }
  .ts-btn:focus-visible { outline: 2px solid #93c5fd; outline-offset: 2px; }
  /* once the field and button wrap onto separate lines, a half-width button looks stranded */
  @media (max-width: 520px) { .ts-form .ts-btn { width: 100%; } }
  .ts-msg { min-height: 20px; margin: 14px 2px 0; font-size: 14px; line-height: 1.5; color: #a3a3a3; }
  .ts-msg.ok { color: #4ade80; }
  .ts-msg.err { color: #f87171; }

  /* Phone layout for the conversion section. Last in the sheet so its .ts-conv override wins
     over the base rule further up. */
  @media (max-width: 767px) {
    /* strip first: it is the thing worth seeing, and the copy reads as a caption under it */
    .ts-conv-sec { display: flex; flex-direction: column; }
    .ts-conv-sec .ts-conv { order: 1; }
    /* the bloom spans the whole section at z-2, so without this it washes warm across the copy
       block that now sits below the strip */
    .ts-conv-sec .ts-conv-head { order: 2; padding-top: 40px; z-index: 3; }
    /* black backing, matching the other section heads, so the copy reverts to light type */
    .ts-conv-head { background: #0a0a0b; padding-bottom: 32px; text-align: center; }
    .ts-conv-head h2 { color: #fff; margin-inline: auto; }
    .ts-conv-head p { color: #a3a3a3; margin-inline: auto; }
    .ts-conv-cta { margin-inline: auto; background: #f2f1ee; color: #121215; }
    .ts-conv-note { margin-inline: auto; max-width: 34em; color: rgba(255,255,255,.5); }
    .ts-conv-cta:hover { background: #fff; }
    /* equal air above and below the strip */
    .ts-conv { margin: 64px 0; }
  }
