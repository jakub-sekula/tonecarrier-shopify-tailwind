  .ts-hero-bg { position: absolute; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; background: #070709;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 52%, transparent 88%);
            mask-image: linear-gradient(to bottom, #000 0%, #000 52%, transparent 88%); }
  /* opacity and blur are hero section settings, so that pair is emitted by the hero itself.
