{% comment %}
  tc-mega-drawer — mobile navigation built from the same header blocks as
  tc-mega-menu (order-based ownership, see that snippet for the rules).

  Cards marked "featured on mobile" and the feature panel render as
  full-width blocks with an image and muted caption; other cards render
  as thumbnail rows. The drawer is a focus-trapped modal dialog.
{% endcomment %}

{%- assign tc_starters = '|panel_cards|panel_feature|panel_links|menu_link|@app|' -%}

{%- capture tc_caret -%}
  <svg class="tc-mega__caret" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/></svg>
{%- endcapture -%}

<tc-mega-drawer class="tc-drawer-root">
  <button
    type="button"
    class="tc-drawer__burger header__icon"
    data-tc-burger
    aria-expanded="false"
    aria-controls="TcDrawer-{{ section.id }}"
    aria-label="Menu"
  >
    <svg fill="none" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/></svg>
  </button>

  <div class="tc-drawer__scrim" data-tc-scrim hidden></div>

  <aside class="tc-drawer" id="TcDrawer-{{ section.id }}" role="dialog" aria-modal="true" aria-label="Menu" hidden>
    <div class="tc-drawer__head">
      {%- if settings.logo != blank -%}
        <img src="{{ settings.logo | image_url: width: 200 }}" alt="{{ shop.name | escape }}" width="100" height="{{ 100 | divided_by: settings.logo.aspect_ratio | round }}">
      {%- else -%}
        <span class="h4">{{ shop.name }}</span>
      {%- endif -%}
      <button type="button" class="tc-drawer__close" data-tc-close aria-label="Close menu">
        <svg fill="none" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/></svg>
      </button>
    </div>

    {%- for block in section.blocks -%}
      {%- assign tc_children_offset = forloop.index -%}

      {%- case block.type -%}
        {%- when 'menu_link' -%}
          <div class="tc-drawer__group" {{ block.shopify_attributes }}>
            <a class="tc-drawer__flat" href="{{ block.settings.link | default: '#' }}">
              <span>
                {{ block.settings.label | escape }}
                {%- if block.settings.badge != blank -%}
                  <span class="tc-mega__badge">{{ block.settings.badge | escape }}</span>
                {%- endif -%}
              </span>
            </a>
          </div>

        {%- when 'panel_cards', 'panel_links' -%}
          <div class="tc-drawer__group" {{ block.shopify_attributes }}>
            <button type="button" class="tc-drawer__toggle" data-tc-accordion aria-expanded="false">
              <span>
                {{ block.settings.label | escape }}
                {%- if block.settings.badge != blank -%}
                  <span class="tc-mega__badge">{{ block.settings.badge | escape }}</span>
                {%- endif -%}
              </span>
              {{ tc_caret }}
            </button>
            <div class="tc-drawer__sub">
              <div>
                {%- for child in section.blocks offset: tc_children_offset -%}
                  {%- assign tc_probe = '|' | append: child.type | append: '|' -%}
                  {%- if tc_starters contains tc_probe -%}{%- break -%}{%- endif -%}
                  {%- case child.type -%}
                    {%- when 'card' -%}
                      {%- if child.settings.featured_mobile -%}
                        <a class="tc-drawer__feature" {% if child.settings.link != blank %}href="{{ child.settings.link }}"{% endif %}>
                          {%- if child.settings.image -%}
                            <img src="{{ child.settings.image | image_url: width: 700 }}" loading="lazy" alt="{{ child.settings.title | escape }}" width="{{ child.settings.image.width }}" height="{{ child.settings.image.height }}">
                          {%- endif -%}
                          <span class="tc-card__title">{{ child.settings.title | escape }}</span>
                          {%- if child.settings.caption != blank -%}
                            <span class="tc-drawer__cap">{{ child.settings.caption | escape }}</span>
                          {%- endif -%}
                          {%- if child.settings.show_ks_logo -%}
                            <img class="tc-card__ks" src="{{ 'kickstarter-logo.svg' | asset_url }}" alt="Kickstarter" loading="lazy" width="252" height="26">
                          {%- endif -%}
                        </a>
                      {%- else -%}
                        <a
                          class="tc-drawer__row{% if child.settings.inactive %} tc-drawer__row--inactive{% endif %}"
                          {% if child.settings.link != blank and child.settings.inactive != true %}href="{{ child.settings.link }}"{% endif %}
                        >
                          {%- if child.settings.image -%}
                            <img class="tc-drawer__thumb" src="{{ child.settings.image | image_url: width: 200 }}" width="200" height="150" loading="lazy" alt="">
                          {%- endif -%}
                          {{ child.settings.title | escape }}
                        </a>
                      {%- endif -%}
                    {%- when 'link_item' -%}
                      <a class="tc-drawer__row" href="{{ child.settings.link | default: '#' }}">
                        {{ child.settings.title | escape }}
                      </a>
                  {%- endcase -%}
                {%- endfor -%}
                <div class="tc-drawer__pad"></div>
              </div>
            </div>
          </div>

        {%- when 'panel_feature' -%}
          {%- liquid
            assign tc_feature_slide = nil
            for child in section.blocks offset: tc_children_offset
              assign tc_probe = '|' | append: child.type | append: '|'
              if tc_starters contains tc_probe
                break
              endif
              if child.type == 'slide'
                assign tc_feature_slide = child
                break
              endif
            endfor
          -%}
          <div class="tc-drawer__group" {{ block.shopify_attributes }}>
            <button type="button" class="tc-drawer__toggle" data-tc-accordion aria-expanded="false">
              <span>
                {{ block.settings.label | escape }}
                {%- if block.settings.badge != blank -%}
                  <span class="tc-mega__badge">{{ block.settings.badge | escape }}</span>
                {%- endif -%}
              </span>
              {{ tc_caret }}
            </button>
            <div class="tc-drawer__sub">
              <div>
                <a class="tc-drawer__feature tc-drawer__feature--glow" href="{{ block.settings.cta_link | default: '#' }}">
                  {%- if tc_feature_slide and tc_feature_slide.settings.image -%}
                    <img src="{{ tc_feature_slide.settings.image | image_url: width: 700 }}" loading="lazy" alt="{{ block.settings.title | escape }}" width="{{ tc_feature_slide.settings.image.width }}" height="{{ tc_feature_slide.settings.image.height }}">
                  {%- else -%}
                    <img src="{{ 'tonescan-hero.png' | asset_url }}" width="3792" height="2272" loading="lazy" alt="{{ block.settings.title | escape }}">
                  {%- endif -%}
                  <span class="tc-card__title">
                    {{ block.settings.title | escape }}
                    {%- if block.settings.title_badge != blank -%}
                      <span class="tc-beta">{{ block.settings.title_badge | escape }}</span>
                    {%- endif -%}
                  </span>
                  {%- if block.settings.mobile_summary != blank -%}
                    <span class="tc-drawer__cap">{{ block.settings.mobile_summary | escape }}</span>
                  {%- endif -%}
                </a>
                <div class="tc-drawer__pad"></div>
              </div>
            </div>
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </aside>
</tc-mega-drawer>
