<!doctype html>
<html class="js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#0a0a0b">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- unless settings.type_body_font.system? and settings.type_header_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- comment -%} Inter as a variable font across 400-800. Loading the 800 weight ALONE was a
       mistake: it is the only Inter face the browser then has, so every element asking for Inter
       at any weight got rendered at 800, which thickened the section headings. The range covers
       body copy, semibold headings and the extrabold film-strip edge printing from one file.
    {%- endcomment -%}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400..800&display=swap">
    {%- endunless -%}

    {%- comment -%}
      Social preview (Open Graph / Twitter) for the toneScan Studio landing pages. Explicit here because
      Dawn's meta-tags snippet emits no og:image for pages without a featured image. Admin SEO
      fields (page title / meta description / a page featured image) override the defaults below.
    {%- endcomment -%}
    {%- comment -%} Shared by the toneScan Studio and toneLight landing pages, so the two stay one
       system. Only the header links, the header button and the social defaults differ, keyed off
       the template suffix. Everything else (fonts, styles, scripts, lightbox) is common. {%- endcomment -%}
    {%- liquid
      assign ts_page = 'tonescan'
      if template.suffix contains 'tonelight'
        assign ts_page = 'tonelight'
      endif
    -%}
    {%- liquid
      assign ts_title = page_title | default: shop.name
      if ts_page == 'tonelight'
        assign ts_desc = page_description | default: 'Get lab-grade results from the gear you already own. toneScan is the smart RGB film scanning system: toneLight, the motorised toneCarrier and toneScan Studio.'
        assign ts_image_alt = 'The toneScan RGB film scanning system'
      else
        assign ts_desc = page_description | default: 'Standalone software for serious film scanning. Seamless RGB, a physically accurate colour engine, and real speed. Now in open beta for macOS and Windows.'
        assign ts_image_alt = 'toneScan Studio film scanning software'
      endif
      # og:image precedence: page metafield custom.social_image → page featured image → default screenshot.
      # Works whether the metafield is a File(image) reference or a plain URL string.
      assign ts_image = 'https://cdn.shopify.com/s/files/1/0634/3199/9736/files/develop.png?v=1784862011'
      assign ts_mf = page.metafields.custom.social_image
      if ts_mf.value != blank
        assign ts_mf_url = ts_mf.value | image_url: width: 1200
        if ts_mf_url != blank
          assign ts_image = ts_mf_url | prepend: 'https:'
        else
          assign ts_image = ts_mf.value
        endif
      elsif page_image
        assign ts_image = page_image | image_url: width: 1200 | prepend: 'https:'
      endif
    -%}

    <title>{{ ts_title }}{% unless ts_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>
    <meta name="description" content="{{ ts_desc | escape }}">

    <meta property="og:site_name" content="{{ shop.name }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ canonical_url | default: request.origin }}">
    <meta property="og:title" content="{{ ts_title | escape }}">
    <meta property="og:description" content="{{ ts_desc | escape }}">
    <meta property="og:image" content="{{ ts_image }}">
    <meta property="og:image:secure_url" content="{{ ts_image }}">
    <meta property="og:image:alt" content="{{ ts_image_alt }}">
    {%- if settings.social_twitter_link != blank -%}
      <meta name="twitter:site" content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}">
    {%- endif -%}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ ts_title | escape }}">
    <meta name="twitter:description" content="{{ ts_desc | escape }}">
    <meta name="twitter:image" content="{{ ts_image }}">

    {%- comment -%} The site header (the same header-group as every other page) needs what
       layout/theme.liquid gives it: the theme's root styles, Dawn's base.css and the global JS.
       The styles go into a cascade layer, "dawn", declared between Tailwind's resets and its
       utilities, so the header is styled exactly as elsewhere while the landing pages' Tailwind
       classes and their own unlayered styles still win over Dawn's element rules. {%- endcomment -%}
    <style>@layer properties, theme, base, dawn, ts-content, components, utilities;</style>
    <script src="{{ 'constants.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'pubsub.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}

    {{ 'app.css' | asset_url | stylesheet_tag }}
    {%- capture ts_root_styles -%}{%- render 'theme-root-styles' -%}{%- endcapture -%}
    <style>
      @import url("{{ 'base.css' | asset_url }}") layer(dawn);
      @layer dawn {
        {{ ts_root_styles }}
      }
      /* The page content keeps the defaults it was built on (Tailwind's preflight), undoing the
         Dawn element and body rules that reach it by inheritance or element selectors: body
         letter-spacing, line-height and the 15px mobile size, and heading, link and paragraph
         styling. Scoped to the content, so the header keeps Dawn's, exactly as elsewhere. */
      @layer ts-content {
        :where(#MainContent, body > footer) { font-size: 16px; line-height: 1.5; letter-spacing: normal; }
        :where(#MainContent, body > footer) :where(h1, h2, h3, h4, h5, h6) {
          margin: 0; font-family: inherit; font-size: inherit; font-weight: inherit; font-style: inherit;
          letter-spacing: inherit; line-height: inherit; color: inherit; word-break: normal; }
        :where(#MainContent, body > footer) :where(a) { color: inherit; text-decoration: inherit; }
        :where(#MainContent, body > footer) :where(p, blockquote, dl, dd, figure, pre, hr) { margin: 0; }
      }
    </style>
    {%- if settings.predictive_search_enabled -%}
      <link rel="stylesheet" href="{{ 'component-predictive-search.css' | asset_url }}" media="print" onload="this.media='all'">
    {%- endif -%}

    {%- comment -%} Restyles Shopify's injected cookie banner. Must be rendered on every layout
       that can show it, since the platform adds it to every page. {%- endcomment -%}
    {% render 'cookie-banner' %}

    {%- comment -%} PhotoSwipe (MIT): fullscreen sample-scan viewer with pinch/wheel zoom.
       Already vendored in assets/ and used by the main theme; theme.liquid loads it globally,
       but this page uses its own layout, so it has to be pulled in here too. {%- endcomment -%}
    <link rel="stylesheet" href="{{ 'photoswipe.css' | asset_url }}">
    <script src="{{ 'photoswipe.umd.min.js' | asset_url }}" defer></script>
    <script src="{{ 'photoswipe-lightbox.umd.min.js' | asset_url }}" defer></script>

    {%- style -%}
      {%- comment -%} Load the SAME fonts as the main site so the header matches {%- endcomment -%}
      {{ settings.type_body_font | font_face: font_display: 'swap' }}
      {{ settings.type_header_font | font_face: font_display: 'swap' }}

      :root {
        color-scheme: dark;
        --ts-accent: #3b82f6;
        --font-body-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
        --font-body-weight: {{ settings.type_body_font.weight | default: 400 }};
        --font-heading-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
      }
      html { scroll-behavior: smooth; }
      body.tonescan-body {
        display: block;             /* not the theme's body grid (theme-root-styles) */
        margin: 0;
        background-color: #0a0a0b;
        color: #e5e5e5;
        font-family: var(--font-body-family);
        font-weight: var(--font-body-weight);
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      /* scroll-reveal (JS adds .reveal, then .in). If JS/IO absent, nothing hides. */
      .tonescan-landing .reveal {
        opacity: 0;
        transform: translateY(22px);
        transition: opacity .7s cubic-bezier(.2,.6,.2,1), transform .7s cubic-bezier(.2,.6,.2,1);
        will-change: opacity, transform;
      }
      .tonescan-landing .reveal.in { opacity: 1; transform: none; }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .tonescan-landing .reveal { opacity: 1 !important; transform: none !important; transition: none !important; }
      }
    {%- endstyle -%}
  </head>

  {%- comment -%} The toneLight page is light throughout: the body class switches the shared
     sections over (see "light page" in tonescan-styles). toneScan stays dark. {%- endcomment -%}
  <body class="tonescan-body{% if ts_page == 'tonelight' %} tonescan-body--light{% endif %}">
    <a class="tw:sr-only" href="#MainContent">Skip to content</a>

    {%- comment -%} No store notice (holiday-banner) on these pages: it is about shop orders, and the
       toneScan landing pages sell none. theme.liquid still renders it on every other page. {%- endcomment -%}

    {%- comment -%} The site header, the same section group and component as every other page
       (mobile drawer, highlighting, shrink on scroll). On these pages sections/header.liquid points
       its menu at the page's sections, leaves out the shop icons, and adds the page's call to
       action (snippets/ts-header-cta). {%- endcomment -%}
    {% sections 'header-group' %}

    <main id="MainContent">
      {%- comment -%} Page-wide CSS and JS for every toneScan template. Rendered here rather than from a
   section so that sections can be added, removed or reordered in the editor without taking the
   stylesheet with them. render isolates scope, hence the explicit ts_cdn pass. {%- endcomment -%}
{%- assign ts_cdn = 'https://cdn.shopify.com/s/files/1/0634/3199/9736/files' -%}
{% render 'tonescan-styles', ts_cdn: ts_cdn %}

{{ content_for_layout }}

{% render 'tonescan-scripts' %}
    </main>

    {%- comment -%} ===== minimal footer ===== {%- endcomment -%}
    <footer class="tw:border-t tw:border-white/10">
      <div class="tw:mx-auto tw:flex tw:w-full tw:max-w-[1400px] tw:flex-col tw:items-center tw:justify-between tw:gap-[16px] tw:px-[15px] tw:py-[32px] tw:md:flex-row tw:md:px-[50px]">
        <p class="tw:text-[13px] tw:text-neutral-500">© {{ 'now' | date: '%Y' }} Tone Photographic. All rights reserved.</p>
        <div class="tw:flex tw:items-center tw:gap-[24px]">
          {%- comment -%} No toneCarrier store to link to. The label said there was one and the
             href went to the shop home, which is a promise the site does not keep. {%- endcomment -%}
          <a href="/" class="tw:text-[13px] tw:text-neutral-500 tw:transition-colors tw:hover:text-white">Tone Photographic</a>
          <a href="/policies/privacy-policy" class="tw:text-[13px] tw:text-neutral-500 tw:transition-colors tw:hover:text-white">Privacy</a>
          <a href="/pages/contact" class="tw:text-[13px] tw:text-neutral-500 tw:transition-colors tw:hover:text-white">Support</a>
        </div>
      </div>
    </footer>

    {%- comment -%} Phones and tablets (below 990px, the header's mobile layout): the page's call to
       action lives in a bar fixed to the bottom of the screen instead of the header. It slides up
       once the hero has scrolled away and back down while the closing section is on screen (script
       below). .ts-dark keeps it dark on the light toneLight page. {%- endcomment -%}
    <div class="ts-cta-bar ts-dark">
      {%- render 'ts-header-cta', place: 'bar' -%}
    </div>

    {%- comment -%} Signup confirmed. Kit sends people who confirm their email to this page with
       ?email=confirmed; the script below opens this dialog then, and takes the parameter out of the
       address straight away, so a refresh does not show it again. Copy in Theme settings >
       toneLight Kickstarter. {%- endcomment -%}
    <dialog class="ts-confirm ts-dark" aria-labelledby="ts-confirm-title" aria-describedby="ts-confirm-text">
      <div class="ts-confirm__card">
        <span class="ts-confirm__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <h2 class="ts-confirm__title" id="ts-confirm-title">{{ settings.tonelight_confirm_title | default: "You're on the list" }}</h2>
        <p class="ts-confirm__text" id="ts-confirm-text">{{ settings.tonelight_confirm_text | default: "Thanks for confirming your email. We'll let you know as soon as toneScan launches on Kickstarter." }}</p>
        <form method="dialog"><button class="ts-cta ts-cta--ks ts-confirm__btn" autofocus>{{ settings.tonelight_confirm_button | default: 'Got it' }}</button></form>
      </div>
    </dialog>
    <script>
      (function () {
        var params = new URLSearchParams(window.location.search);
        if (params.get('email') !== 'confirmed') return;
        var dlg = document.querySelector('.ts-confirm');
        if (!dlg || typeof dlg.showModal !== 'function') return;
        // Take the parameter out of the address straight away, so a refresh, a shared link or a
        // bookmark does not show the dialog again.
        params.delete('email');
        var q = params.toString();
        history.replaceState(history.state, '', window.location.pathname + (q ? '?' + q : '') + window.location.hash);
        // a click on the backdrop (outside the card) closes it too
        dlg.addEventListener('click', function (e) { if (e.target === dlg) dlg.close(); });
        dlg.showModal();
      })();
    </script>

    <script>
      /* The repeated call to action (header on wide screens, bottom bar below 990px) stays out of
         sight while any of the hero, which has its own, is still in view below the header:
         body.ts-hero-cta-on. The bottom bar also steps aside while the closing section (#join, with
         its own form) is on screen: body.ts-bar-on is set only when neither is in view. Hidden
         things keep their space in the header, so the menu never shifts. */
      (function () {
        var hero = document.querySelector('.ts-hero-split');
        var join = document.getElementById('join');
        var heroOn = null, barOn = null;
        function check() {
          var bar = document.querySelector('.section-header');
          var barBottom = bar ? bar.getBoundingClientRect().bottom : 0;
          var nextHero = !!hero && hero.getBoundingClientRect().bottom > barBottom;
          var j = join ? join.getBoundingClientRect() : null;
          var joinInView = !!(j && j.top < window.innerHeight && j.bottom > barBottom);
          var nextBar = !nextHero && !joinInView;
          if (nextHero !== heroOn) { heroOn = nextHero; document.body.classList.toggle('ts-hero-cta-on', nextHero); }
          if (nextBar !== barOn) { barOn = nextBar; document.body.classList.toggle('ts-bar-on', nextBar); }
        }
        window.addEventListener('scroll', check, { passive: true });
        window.addEventListener('resize', check, { passive: true });
        check();
      })();
    </script>

    {%- comment -%} ===== scroll animations: reveal-on-scroll + subtle parallax ===== {%- endcomment -%}
    <script>
      (function () {
        if (!('IntersectionObserver' in window)) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        // The page is split across several sections, each with its own .tonescan-landing
        // wrapper, so this has to sweep all of them: a single root only ever saw the hero.
        if (!document.querySelector('.tonescan-landing')) return;

        // Elements to reveal: headings, grid items (cards/steps), testimonials, faq rows.
        // .ts-conv__item is excluded: every film frame is a <figure>, so the reveal was holding
        // each one 22px low until it intersected, which read as frames sliding up into the strip.
        // .tl-rev__tile likewise: the review wall's tiles drift through a clipped window, so revealing
        // each one as it crosses in reads as flicker, and copies rebuilt on resize were never revealed.
        // [data-reveal] opts anything else in, e.g. the reviews section's star row above its heading.
        var targets = document.querySelectorAll('.tonescan-landing :is(h1, h2, [data-reveal], [class*="grid"] > *, figure:not(.ts-conv__item):not(.tl-rev__tile), details)');
        targets.forEach(function (el) { el.classList.add('reveal'); });

        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (!e.isIntersecting) return;
            var el = e.target;
            var delay = 0;
            var parent = el.parentElement;
            if (parent && /grid/.test(parent.className)) {
              var idx = Array.prototype.indexOf.call(parent.children, el);
              // Cap high enough to cover the 9-card bento. At 5 the last row shared one
              // delay and the whole row landed at once.
              delay = Math.min(idx, 9) * 55;
            }
            el.style.transitionDelay = delay + 'ms';
            el.classList.add('in');
            io.unobserve(el);
          });
        }, { rootMargin: '0px 0px -10% 0px', threshold: 0.12 });

        targets.forEach(function (el) { io.observe(el); });
        // (Hero scroll effects live in the section's own script.)
      })();
    </script>
    {%- render 'theme-js-globals' -%}
    {%- if settings.predictive_search_enabled -%}
      <script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
  </body>
</html>
