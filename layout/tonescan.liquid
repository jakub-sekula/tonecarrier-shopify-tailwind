<!doctype html>
<html class="js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#0a0a0b">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- unless settings.type_body_font.system? and settings.type_header_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- comment -%} Inter as a variable font across 400-800. Loading the 800 weight ALONE was a
       mistake: it is the only Inter face the browser then has, so every element asking for Inter
       at any weight got rendered at 800, which thickened the section headings. The range covers
       body copy, semibold headings and the extrabold film-strip edge printing from one file.
    {%- endcomment -%}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400..800&display=swap">
    {%- endunless -%}

    {%- comment -%}
      Social preview (Open Graph / Twitter) for the toneScan Studio landing pages. Explicit here because
      Dawn's meta-tags snippet emits no og:image for pages without a featured image. Admin SEO
      fields (page title / meta description / a page featured image) override the defaults below.
    {%- endcomment -%}
    {%- liquid
      assign ts_title = page_title | default: shop.name
      assign ts_desc = page_description | default: 'Standalone software for serious film scanning. Seamless RGB, a physically accurate colour engine, and real speed. Now in open beta for macOS and Windows.'
      # og:image precedence: page metafield custom.social_image → page featured image → default screenshot.
      # Works whether the metafield is a File(image) reference or a plain URL string.
      assign ts_image = 'https://cdn.shopify.com/s/files/1/0634/3199/9736/files/develop.png?v=1784862011'
      assign ts_mf = page.metafields.custom.social_image
      if ts_mf.value != blank
        assign ts_mf_url = ts_mf.value | image_url: width: 1200
        if ts_mf_url != blank
          assign ts_image = ts_mf_url | prepend: 'https:'
        else
          assign ts_image = ts_mf.value
        endif
      elsif page_image
        assign ts_image = page_image | image_url: width: 1200 | prepend: 'https:'
      endif
    -%}

    <title>{{ ts_title }}{% unless ts_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>
    <meta name="description" content="{{ ts_desc | escape }}">

    <meta property="og:site_name" content="{{ shop.name }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ canonical_url | default: request.origin }}">
    <meta property="og:title" content="{{ ts_title | escape }}">
    <meta property="og:description" content="{{ ts_desc | escape }}">
    <meta property="og:image" content="{{ ts_image }}">
    <meta property="og:image:secure_url" content="{{ ts_image }}">
    <meta property="og:image:alt" content="toneScan Studio film scanning software">
    {%- if settings.social_twitter_link != blank -%}
      <meta name="twitter:site" content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}">
    {%- endif -%}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ ts_title | escape }}">
    <meta name="twitter:description" content="{{ ts_desc | escape }}">
    <meta name="twitter:image" content="{{ ts_image }}">

    {{ content_for_header }}

    {{ 'app.css' | asset_url | stylesheet_tag }}

    {%- comment -%} PhotoSwipe (MIT): fullscreen sample-scan viewer with pinch/wheel zoom.
       Already vendored in assets/ and used by the main theme; theme.liquid loads it globally,
       but this page uses its own layout, so it has to be pulled in here too. {%- endcomment -%}
    <link rel="stylesheet" href="{{ 'photoswipe.css' | asset_url }}">
    <script src="{{ 'photoswipe.umd.min.js' | asset_url }}" defer></script>
    <script src="{{ 'photoswipe-lightbox.umd.min.js' | asset_url }}" defer></script>

    {%- style -%}
      {%- comment -%} Load the SAME fonts as the main site so the header matches {%- endcomment -%}
      {{ settings.type_body_font | font_face: font_display: 'swap' }}
      {{ settings.type_header_font | font_face: font_display: 'swap' }}

      :root {
        color-scheme: dark;
        --ts-accent: #3b82f6;
        --font-body-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
        --font-body-weight: {{ settings.type_body_font.weight | default: 400 }};
        --font-heading-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
      }
      html { scroll-behavior: smooth; }
      body.tonescan-body {
        margin: 0;
        background-color: #0a0a0b;
        color: #e5e5e5;
        font-family: var(--font-body-family);
        font-weight: var(--font-body-weight);
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      /* scroll-reveal (JS adds .reveal, then .in). If JS/IO absent, nothing hides. */
      .tonescan-landing .reveal {
        opacity: 0;
        transform: translateY(22px);
        transition: opacity .7s cubic-bezier(.2,.6,.2,1), transform .7s cubic-bezier(.2,.6,.2,1);
        will-change: opacity, transform;
      }
      .tonescan-landing .reveal.in { opacity: 1; transform: none; }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .tonescan-landing .reveal { opacity: 1 !important; transform: none !important; transition: none !important; }
      }
    {%- endstyle -%}
  </head>

  <body class="tonescan-body">
    <a class="tw:sr-only" href="#MainContent">Skip to content</a>

    {%- comment -%} ===== minimal sticky header (matches main-site width + fonts) ===== {%- endcomment -%}
    <header class="tw:sticky tw:top-0 tw:z-50 tw:border-b tw:border-white/10 tw:bg-[#0a0a0b]/80 tw:backdrop-blur-[12px]">
      <div class="tw:mx-auto tw:flex tw:w-full tw:max-w-[1400px] tw:items-center tw:justify-between tw:px-[15px] tw:py-[10px] tw:md:px-[50px]">
        <a href="/" class="tw:flex tw:items-center focus-inset" aria-label="{{ shop.name }}">
          {%- if settings.logo != blank -%}
            {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio -%}
            {{
              settings.logo
              | image_url: width: 600
              | image_tag:
                class: 'tw:block tw:h-auto',
                width: settings.logo_width,
                height: logo_height,
                widths: '110, 165, 220',
                alt: shop.name,
                loading: 'eager'
            }}
          {%- else -%}
            <span class="tw:text-[17px] tw:font-semibold tw:text-white">{{ shop.name }}</span>
          {%- endif -%}
        </a>

        {%- comment -%} nav links point to sections that don't exist in the minimal (tonescan-lite) variant, so hide them there {%- endcomment -%}
        {%- unless template.suffix == 'tonescan-lite' -%}
        <nav class="tw:hidden tw:items-center tw:gap-[28px] tw:md:flex">
          <a href="#features" class="tw:text-[14px] tw:text-neutral-400 tw:transition-colors tw:hover:text-white">Features</a>
          <a href="#how-it-works" class="tw:text-[14px] tw:text-neutral-400 tw:transition-colors tw:hover:text-white">How it works</a>
          <a href="#pricing" class="tw:text-[14px] tw:text-neutral-400 tw:transition-colors tw:hover:text-white">Pricing</a>
          <a href="#faq" class="tw:text-[14px] tw:text-neutral-400 tw:transition-colors tw:hover:text-white">FAQ</a>
        </nav>
        {%- endunless -%}

        <a href="#signup" class="tw:inline-flex tw:items-center tw:justify-center tw:rounded-[2px] tw:bg-[var(--ts-accent)] tw:px-[16px] tw:py-[9px] tw:text-[14px] tw:font-semibold tw:text-white tw:transition-transform tw:hover:-translate-y-[1px]">
          Become a tester
        </a>
      </div>
    </header>

    <main id="MainContent">
      {{ content_for_layout }}
    </main>

    {%- comment -%} ===== minimal footer ===== {%- endcomment -%}
    <footer class="tw:border-t tw:border-white/10">
      <div class="tw:mx-auto tw:flex tw:w-full tw:max-w-[1400px] tw:flex-col tw:items-center tw:justify-between tw:gap-[16px] tw:px-[15px] tw:py-[32px] tw:md:flex-row tw:md:px-[50px]">
        <p class="tw:text-[13px] tw:text-neutral-500">© {{ 'now' | date: '%Y' }} Tone Photographic. All rights reserved.</p>
        <div class="tw:flex tw:items-center tw:gap-[24px]">
          <a href="/" class="tw:text-[13px] tw:text-neutral-500 tw:transition-colors tw:hover:text-white">toneCarrier store</a>
          <a href="/policies/privacy-policy" class="tw:text-[13px] tw:text-neutral-500 tw:transition-colors tw:hover:text-white">Privacy</a>
          <a href="/pages/contact" class="tw:text-[13px] tw:text-neutral-500 tw:transition-colors tw:hover:text-white">Support</a>
        </div>
      </div>
    </footer>

    {%- comment -%} ===== scroll animations: reveal-on-scroll + subtle parallax ===== {%- endcomment -%}
    <script>
      (function () {
        if (!('IntersectionObserver' in window)) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var root = document.querySelector('.tonescan-landing');
        if (!root) return;

        // Elements to reveal: headings, grid items (cards/steps), testimonials, faq rows.
        // .ts-conv__item is excluded: every film frame is a <figure>, so the reveal was holding
        // each one 22px low until it intersected, which read as frames sliding up into the strip.
        var targets = root.querySelectorAll('h1, h2, [class*="grid"] > *, figure:not(.ts-conv__item), details');
        targets.forEach(function (el) { el.classList.add('reveal'); });

        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (!e.isIntersecting) return;
            var el = e.target;
            var delay = 0;
            var parent = el.parentElement;
            if (parent && /grid/.test(parent.className)) {
              var idx = Array.prototype.indexOf.call(parent.children, el);
              // Cap high enough to cover the 9-card bento. At 5 the last row shared one
              // delay and the whole row landed at once.
              delay = Math.min(idx, 9) * 55;
            }
            el.style.transitionDelay = delay + 'ms';
            el.classList.add('in');
            io.unobserve(el);
          });
        }, { rootMargin: '0px 0px -10% 0px', threshold: 0.12 });

        targets.forEach(function (el) { io.observe(el); });
        // (Hero scroll effects live in the section's own script.)
      })();
    </script>
  </body>
</html>
