<!doctype html>
<html class='js' lang='{{ request.locale.iso_code }}'>
  <head>
    <meta charset='utf-8'>
    <meta http-equiv='X-UA-Compatible' content='IE=edge'>
    <meta name='viewport' content='width=device-width,initial-scale=1'>
    <meta name='theme-color' content=''>
    <link rel='canonical' href='{{ canonical_url }}'>

    <!-- Reddit Pixel -->
    <script>
    !function(w,d){if(!w.rdt){var p=w.rdt=function(){p.sendEvent?p.sendEvent.apply(p,arguments):p.callQueue.push(arguments)};p.callQueue=[];var t=d.createElement("script");t.src="https://www.redditstatic.com/ads/pixel.js",t.async=!0;var s=d.getElementsByTagName("script")[0];s.parentNode.insertBefore(t,s)}}(window,document);rdt('init','a2_f17ro57sg5u5');rdt('track', 'PageVisit');
    </script>
    <!-- DO NOT MODIFY UNLESS TO REPLACE A USER IDENTIFIER -->
    <!-- End Reddit Pixel -->

    {% if template == 'page.tonelight-ks-promo' %}
      <meta name="robots" content="noindex,nofollow">
    {% endif %}
  

    {%- if settings.favicon != blank -%}
      <link
        rel='icon'
        type='image/png'
        href='{{ settings.favicon | image_url: width: 32, height: 32 }}'>
    {%- endif -%}

    {%- unless settings.type_header_font.system? and settings.type_body_font.system? -%}
      <link
        rel='preconnect'
        href='https://fonts.shopifycdn.com'
        crossorigin>
    {%- endunless -%}

    <title>
      {{ page_title }}
      {%- if current_tags %}
        &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %}
        &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %}
        &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name='description' content='{{ page_description | escape }}'>
    {% endif %}

    {% render 'meta-tags' %}

    <script src='{{ 'constants.js' | asset_url }}' defer='defer'></script>
    <script src='{{ 'pubsub.js' | asset_url }}' defer='defer'></script>
    <script src='{{ 'global.js' | asset_url }}' defer='defer'></script>
    {%- if settings.animations_reveal_on_scroll -%}
      <script src='{{ 'animations.js' | asset_url }}' defer='defer'></script>
    {%- endif -%}

    {{ content_for_header }}

    {% style %}
      {%- render 'theme-root-styles' -%}
    {% endstyle %}

    {{ 'app.css' | asset_url | stylesheet_tag }}
    {{ 'base.css' | asset_url | stylesheet_tag }}

    {%- comment -%} Restyles Shopify's injected cookie banner. Must be rendered on every layout
       that can show it, since the platform adds it to every page. {%- endcomment -%}
    {% render 'cookie-banner' %}

    {%- unless settings.type_body_font.system? -%}
      {% comment %}theme-check-disable AssetPreload{% endcomment %}
      <link
        rel='preload'
        as='font'
        href='{{ settings.type_body_font | font_url }}'
        type='font/woff2'
        crossorigin>
      {% comment %}theme-check-enable AssetPreload{% endcomment %}
    {%- endunless -%}
    {%- unless settings.type_header_font.system? -%}
      {% comment %}theme-check-disable AssetPreload{% endcomment %}
      <link
        rel='preload'
        as='font'
        href='{{ settings.type_header_font | font_url }}'
        type='font/woff2'
        crossorigin>
      {% comment %}theme-check-enable AssetPreload{% endcomment %}
    {%- endunless -%}

    {%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
      {{ 'component-localization-form.css' | asset_url | stylesheet_tag: preload: true }}
      <script src='{{ 'localization-form.js' | asset_url }}' defer='defer'></script>
    {%- endif -%}

    {%- if settings.predictive_search_enabled -%}
      <link
        rel='stylesheet'
        href='{{ 'component-predictive-search.css' | asset_url }}'
        media='print'
        onload="this.media='all'">
    {%- endif -%}

    <script>
      if (Shopify.designMode) {
        document.documentElement.classList.add('shopify-design-mode');
      }
    </script>
  </head>

  <body class='gradient{% if settings.animations_hover_elements != 'none' %} animate--hover-{{ settings.animations_hover_elements }}{% endif %}'>
    <a class='skip-to-content-link button visually-hidden' href='#MainContent'>
      {{ 'accessibility.skip_to_text' | t }}
    </a>

    {%- comment -%} Store notice at the very top of every page, above the header group. Rendered as a
       static section so it is editable in the theme editor; the toneScan layout renders the same
       named section, so one config covers the whole site. {%- endcomment -%}
    {% section 'holiday-banner' %}

    {% unless template == 'page.tonelight-ks-promo' %}
      {%- if settings.cart_type == 'drawer' -%}
        {%- render 'cart-drawer' -%}
      {%- endif -%}

        {% sections 'header-group' %}
      {% else %}
        {% sections 'tc-tl-ks-header-group' %}
    {% endunless %}

    <main
      id='MainContent'
      class='content-for-layout focus-none'
      role='main'
      tabindex='-1'>
      {{ content_for_layout }}
    </main>

    {% unless template == 'page.tonelight-ks-promos' %}
      {% sections 'footer-group' %}
    {%endunless%}

    <ul hidden>
      <li id='a11y-refresh-page-message'>{{ 'accessibility.refresh_page' | t }}</li>
      <li id='a11y-new-window-message'>{{ 'accessibility.link_messages.new_window' | t }}</li>
    </ul>

    {%- render 'theme-js-globals' -%}


    {% comment %} <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-element-bundle.min.js"></script> {% endcomment %}



    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM"
      crossorigin="anonymous"></script>


    {%- if settings.predictive_search_enabled -%}
      <script src='{{ 'predictive-search.js' | asset_url }}' defer='defer'></script>
    {%- endif -%}

    <script src='https://unpkg.com/lucide@latest' defer></script>
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        lucide.createIcons();
      });
    </script>

{% comment %} <script src="{{ "tc-click-to-zoom.js" | asset_url }}" defer="defer"></script> {% endcomment %}

{% comment %} Photoswipe components {% endcomment %}
<script src="{{"photoswipe.umd.min.js" |  asset_url}}"></script>
<script src="{{"photoswipe-lightbox.umd.min.js" |  asset_url}}"></script>
<link rel="stylesheet" href="{{"photoswipe.css" |  asset_url}}">

    <link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
/>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer="defer"></script>


<script>
  document.addEventListener('DOMContentLoaded', () => {
  const formContainer = document.querySelector('.newsletter-form-container');

  const observer = new MutationObserver((mutationsList, observer) => {
    const form = document.querySelector('form-embed');
  
    if (form) {
      observer.disconnect();
      const shadow = form.shadowRoot;

      // Create a <style> element to inject styles
      const style = document.createElement('style');
      style.textContent = `
* {
  font-family: unset !important;
}

h2 {
  font-family: "Inter Tight", sans-serif !important;
  font-size: 3rem !important;
  font-weight: 400 !important;
}

p {
  font-size: 1.6rem !important;
    font-weight: 100 !important;
    letter-spacing: 0.01em !important;
    line-height: 1.5em !important;
}

section {
  margin: 0 !important;
  margin-bottom: 2rem !important;
  display: flex !important;
  flex-direction: column !important;
  gap: 1rem !important;
  justify-content: center !important;
  align-items: center !important;
  text-align: center !important;
}

section[class*="_formContainer"] {
max-width: unset!important}

div[class*="_formDisclaimer"] * {
  font-size: 1rem !important;
  font-weight: 300 !important;
  opacity: 0.6 !important;
  text-align: center!important;
}
input,
button,
textarea {
  border-radius: 0 !important;
  border: none !important;
  font-size: 1.5rem!important;
  letter-spacing: 0.1em!important
}

@media (min-width: 768px) {
  * {
    text-align: left !important;
  }
  section {
    justify-content: start !important;
    align-items: start !important;
  }

  p {
  font-size: 1.6rem!important
}
  }
}
`;

      // Append the style element to the shadow root
      shadow.appendChild(style);

      formContainer.classList.add('loaded');
    }
  });

  observer.observe(document.body, { childList: true, subtree: true });
});
  </script>


  </body>
</html>